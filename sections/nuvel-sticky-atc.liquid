{%- comment -%}
  Barra de compra fija para móvil (plantilla de producto).
  No duplica la lógica de Rise: el botón delega en el formulario nativo
  (requestSubmit), por lo que variante, cantidad, estados de carga y
  apertura del drawer los gestiona product-form.js de Rise.
{%- endcomment -%}

{%- if section.settings.enabled and product != blank -%}
  {%- style -%}
    .nuvel-sticky-atc {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 90;
      display: none;
      align-items: center;
      gap: 1.2rem;
      padding: 1rem 1.6rem 1.2rem;
      border-top: 0.1rem solid rgba(var(--color-foreground), 0.15);
      box-shadow: 0 -0.4rem 1.2rem rgba(var(--color-shadow), 0.12);
    }

    .nuvel-sticky-atc.is-visible {
      display: flex;
    }

    .nuvel-sticky-atc__content {
      display: flex;
      align-items: center;
      gap: 1rem;
      width: 100%;
    }

    .nuvel-sticky-atc__title {
      margin: 0;
      font-size: 1.3rem;
      line-height: 1.2;
      overflow: hidden;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      flex: 1;
      min-width: 0;
    }

    .nuvel-sticky-atc__price {
      font-size: 1.4rem;
      font-weight: 600;
      color: rgb(var(--color-foreground));
      white-space: nowrap;
      flex-shrink: 0;
    }

    .nuvel-sticky-atc__button {
      margin-left: auto;
      flex-shrink: 0;
      min-height: 4.4rem;
      min-width: 160px;
    }

    @media screen and (max-width: 749px) {
      body:has(.nuvel-sticky-atc) {
        padding-bottom: 8.4rem;
      }
    }

    @media screen and (min-width: 750px) {
      .nuvel-sticky-atc {
        display: none !important;
      }
    }
  {%- endstyle -%}

  <div
    class="nuvel-sticky-atc color-{{ section.settings.color_scheme }} gradient"
    data-nuvel-sticky-atc
  >
    <div class="nuvel-sticky-atc__content">
      <p class="nuvel-sticky-atc__title">{{ product.title | escape }}</p>
      <span class="nuvel-sticky-atc__price" aria-live="polite">{{ product.selected_or_first_available_variant.price | money }}</span>
      <button
        type="button"
        class="button button--primary nuvel-sticky-atc__button"
        data-nuvel-sticky-submit
      >
        <span class="nuvel-sticky-atc__button-text">{{ section.settings.button_label }}</span>
        {% render 'loading-spinner' %}
      </button>
    </div>
  </div>

  <script>
    (function () {
      'use strict';

      var bar = document.querySelector('[data-nuvel-sticky-atc]');
      var form = document.querySelector('form[data-type="add-to-cart-form"]');
      if (!bar || !form || bar.dataset.init) return;
      bar.dataset.init = '1';

      var submitButton = bar.querySelector('[data-nuvel-sticky-submit]');
      var buttonText = bar.querySelector('.nuvel-sticky-atc__button-text');
      var priceEl = bar.querySelector('.nuvel-sticky-atc__price');
      var spinner = bar.querySelector('.loading-spinner');

      if (!submitButton || !form) return;

      var mainButton = form.querySelector('[type="submit"][name="add"]') || form.querySelector('[type="submit"]');
      var observer = null;
      var isSubmitting = false;

      // Sincronizar precio cuando cambia la variante
      var priceObserver = new MutationObserver(function () {
        var variantPrice = form.querySelector('[name="id"]');
        if (variantPrice && variantPrice.value) {
          // El precio se actualiza vía product-form.js, leer del data attribute
          var pdp = document.querySelector('.nuvel-pdp');
          if (pdp && pdp.dataset.basePrice) {
            var priceCents = parseInt(pdp.dataset.basePrice, 10);
            if (priceEl) {
              priceEl.textContent = new Intl.NumberFormat('es-ES', {
                style: 'currency',
                currency: 'EUR',
                minimumFractionDigits: 2
              }).format(priceCents / 100);
            }
          }
        }
      });

      // Observar cambios en el formulario
      priceObserver.observe(form, { attributes: true, subtree: true, attributeFilter: ['value'] });

      // Observer para visibilidad (scroll)
      if ('IntersectionObserver' in window) {
        observer = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              bar.classList.toggle('is-visible', !entry.isIntersecting);
            });
          },
          { threshold: 0 }
        );
        observer.observe(mainButton);
      } else {
        bar.classList.add('is-visible');
      }

      // Sincronizar estado disabled con botón principal
      function syncDisabledState() {
        if (mainButton && submitButton) {
          var isDisabled = mainButton.disabled || mainButton.hasAttribute('aria-disabled');
          submitButton.disabled = isDisabled || isSubmitting;
          submitButton.setAttribute('aria-disabled', isDisabled || isSubmitting);
        }
      }

      // Observar cambios en el botón principal
      var mainButtonObserver = new MutationObserver(syncDisabledState);
      if (mainButton) {
        mainButtonObserver.observe(mainButton, { attributes: true, attributeFilter: ['disabled', 'aria-disabled'] });
      }

      function setSubmitting(state) {
        isSubmitting = state;
        submitButton.disabled = state || (mainButton && mainButton.disabled);
        if (spinner) {
          spinner.hidden = !state;
        }
        if (buttonText) {
          buttonText.textContent = state ? '{{ 'products.product.adding' | t | escape }}' : '{{ section.settings.button_label | escape }}';
        }
        syncDisabledState();
      }

      function onClick() {
        if (submitButton.disabled || isSubmitting) {
          if (mainButton && mainButton.disabled) {
            mainButton.scrollIntoView({ block: 'center', behavior: 'smooth' });
          }
          return;
        }

        setSubmitting(true);

        if (typeof form.requestSubmit === 'function') {
          form.requestSubmit();
        } else {
          mainButton.click();
        }

        // Reset submitting state after a delay (form submission will navigate or drawer will open)
        setTimeout(function () {
          setSubmitting(false);
        }, 3000);
      }

      submitButton.addEventListener('click', onClick);

      // Escuchar envío del formulario para resetear estado
      form.addEventListener('submit', function () {
        setSubmitting(true);
      });

      // Escuchar evento de carrito abierto (Rise)
      document.addEventListener('cart:open', function () {
        setSubmitting(false);
      });

      function onSectionUnload(event) {
        if (event.target && event.target.contains(bar)) {
          if (observer) observer.disconnect();
          if (priceObserver) priceObserver.disconnect();
          if (mainButtonObserver) mainButtonObserver.disconnect();
          submitButton.removeEventListener('click', onClick);
          document.removeEventListener('shopify:section:unload', onSectionUnload);
        }
      }
      document.addEventListener('shopify:section:unload', onSectionUnload);

      // Sync inicial
      syncDisabledState();
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Compra fija móvil (Nuvel)",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Barra fija inferior en móvil con acceso directo a la compra. El botón usa el formulario nativo del producto (sin duplicar el carrito). Sincroniza precio, estado disabled y loading con el botón principal."
    },
    {
      "type": "checkbox",
      "id": "enabled",
      "default": true,
      "label": "Mostrar la barra de compra fija"
    },
    {
      "type": "text",
      "id": "button_label",
      "default": "Comprar ahora",
      "label": "Texto del botón"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Compra fija móvil (Nuvel)"
    }
  ]
}
{% endschema %}