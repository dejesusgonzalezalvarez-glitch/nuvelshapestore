
<main>
  <section class="hero">
    <img src="{{ 'hero-principal.jpg' | asset_url }}" srcset="{{ 'med-hero-principal.jpg' | asset_url }} 800w, {{ 'lg-hero-principal.jpg' | asset_url }} 1100w, {{ 'hero-principal.jpg' | asset_url }} 1600w" sizes="100vw" alt="{{ 'home.hero.image_alt' | t }}" fetchpriority="high">
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <span class="eyebrow" style="color:#D9CFC2;">{{ 'home.hero.eyebrow' | t }}</span>
      <h1>{{ 'home.hero.title' | t }}</h1>
      <p>{{ 'home.hero.subtitle' | t }}</p>
      <div><a href="/pages/producto" class="btn btn-light">{{ 'home.hero.cta' | t }}</a></div>
    </div>
  </section>

  <section class="pad center">
    <span class="eyebrow">{{ 'home.real_life.eyebrow' | t }}</span>
    <h2 style="font-size:34px; margin-top:10px;">{{ 'home.real_life.title' | t }}</h2>
    <p style="max-width:480px; margin:14px auto 0; color:var(--text-soft); font-size:15px; line-height:1.6;">{{ 'home.real_life.subtitle' | t }}</p>
    <div class="compare-row">
      <div class="compare-card" style="width:420px; height:480px; background:#fff;">
        <img src="{{ 'producto-frente.jpg' | asset_url }}" srcset="{{ 'med-producto-frente.jpg' | asset_url }} 800w, {{ 'lg-producto-frente.jpg' | asset_url }} 1100w" sizes="(max-width: 900px) 92vw, 520px" alt="{{ 'tile.faja.image_alt' | t }}" style="width:100%; height:100%; object-fit:contain;" loading="lazy" decoding="async">
        <span class="compare-tag" style="color:var(--bg); background:rgba(26,20,15,.55);">{{ 'home.real_life.tag_product' | t }}</span>
      </div>
      <div class="compare-card" style="width:480px; height:520px; margin-left:-8px;">
        <img src="{{ 'avatar-vestida.jpg' | asset_url }}" srcset="{{ 'med-avatar-vestida.jpg' | asset_url }} 800w, {{ 'lg-avatar-vestida.jpg' | asset_url }} 1000w" sizes="(max-width: 900px) 92vw, 520px" alt="{{ 'home.real_life.worn_image_alt' | t }}" style="width:100%; height:100%; object-fit:cover;" loading="lazy" decoding="async">
        <span class="compare-tag" style="color:#2A2019; background:rgba(245,241,236,.85);">{{ 'home.real_life.tag_worn' | t }}</span>
      </div>
    </div>
  </section>

  <section class="pad bg-alt">
    <div class="feature-row">
      <div class="feature-img feature-img--contain">
        <img src="{{ 'med-producto-espalda.jpg' | asset_url }}" srcset="{{ 'mini-producto-espalda.jpg' | asset_url }} 400w, {{ 'med-producto-espalda.jpg' | asset_url }} 800w, {{ 'lg-producto-espalda.jpg' | asset_url }} 1100w" sizes="(max-width: 600px) 46vw, (max-width: 900px) 30vw, 22vw" alt="{{ 'tile.faja.title' | t }}" loading="lazy"><span class="badge">{{ 'general.badge_bestseller' | t }}</span>
      </div>
      <div class="feature-info">
        <span class="eyebrow">{{ 'home.anchor.eyebrow' | t }}</span>
        <h2 style="font-size:32px; margin-top:10px; margin-bottom:0;">{{ 'tile.faja.title' | t }} · Nuvel</h2>
        <div class="rating-row" style="margin:10px 0 0;"><div class="stars-wrap" style="width:82px;"><div class="stars-bg" style="gap:3px;"><svg width="14" height="14" viewBox="0 0 24 24" fill="#E4DACB"><path d="M12 2l3 7h7l-5.5 4.2L18.5 21 12 16.8 5.5 21l2-7.8L2 9h7z"/></svg><svg width="14" height="14" viewBox="0 0 24 24" fill="#E4DACB"><path d="M12 2l3 7h7l-5.5 4.2L18.5 21 12 16.8 5.5 21l2-7.8L2 9h7z"/></svg><svg width="14" height="14" viewBox="0 0 24 24" fill="#E4DACB"><path d="M12 2l3 7h7l-5.5 4.2L18.5 21 12 16.8 5.5 21l2-7.8L2 9h7z"/></svg><svg width="14" height="14" viewBox="0 0 24 24" fill="#E4DACB"><path d="M12 2l3 7h7l-5.5 4.2L18.5 21 12 16.8 5.5 21l2-7.8L2 9h7z"/></svg><svg width="14" height="14" viewBox="0 0 24 24" fill="#E4DACB"><path d="M12 2l3 7h7l-5.5 4.2L18.5 21 12 16.8 5.5 21l2-7.8L2 9h7z"/></svg></div><div class="stars-fg" style="width:78.7px; gap:3px;"><svg width="14" height="14" viewBox="0 0 24 24" fill="#FFD700"><path d="M12 2l3 7h7l-5.5 4.2L18.5 21 12 16.8 5.5 21l2-7.8L2 9h7z"/></svg><svg width="14" height="14" viewBox="0 0 24 24" fill="#FFD700"><path d="M12 2l3 7h7l-5.5 4.2L18.5 21 12 16.8 5.5 21l2-7.8L2 9h7z"/></svg><svg width="14" height="14" viewBox="0 0 24 24" fill="#FFD700"><path d="M12 2l3 7h7l-5.5 4.2L18.5 21 12 16.8 5.5 21l2-7.8L2 9h7z"/></svg><svg width="14" height="14" viewBox="0 0 24 24" fill="#FFD700"><path d="M12 2l3 7h7l-5.5 4.2L18.5 21 12 16.8 5.5 21l2-7.8L2 9h7z"/></svg><svg width="14" height="14" viewBox="0 0 24 24" fill="#FFD700"><path d="M12 2l3 7h7l-5.5 4.2L18.5 21 12 16.8 5.5 21l2-7.8L2 9h7z"/></svg></div></div><span class="rating-value">4.8</span><span>123 {{ 'general.reviews' | t }}</span></div>
        <div class="price-row">
          <span class="price-now">39,90&nbsp;€</span>
          <span class="price-was">54,90&nbsp;€</span>
        </div>
        <ul class="bullets">
          <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>{{ 'home.anchor.bullet_1' | t }}</li>
          <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>{{ 'home.anchor.bullet_2' | t }}</li>
          <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>{{ 'home.anchor.bullet_3' | t }}</li>
          <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>{{ 'home.anchor.bullet_4' | t }}</li>
        </ul>
        <div class="qty-offer">
          <div class="qty-opt"><div class="qty-label">{{ 'qty.one_unit' | t }}</div><div class="qty-price">39,90&nbsp;€</div></div>
          <div class="qty-opt selected"><span class="qty-save">{{ 'qty.save_rotate' | t }}</span><div class="qty-label">{{ 'qty.two_units' | t }}</div><div class="qty-price">79,80&nbsp;€</div></div>
          <div class="qty-opt qty-opt--pack"><span class="qty-save">{{ 'qty.save_most_requested' | t }}</span><div class="qty-label">{{ 'home.anchor.pack_label' | t }}</div><div class="qty-price">64,80&nbsp;€</div></div>
        </div>
        <a href="/pages/producto" class="btn btn-dark" style="width:100%;">{{ 'general.buy_now' | t }}</a>
      </div>
    </div>
  </section>

  <section class="pad">
    <h2 class="center" style="font-size:34px;">{{ 'home.why.title' | t }}</h2>
    <div class="grid-4">
      <div class="card">
        <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M6 3v4a6 6 0 0012 0V3"/><path d="M9 3h6"/><path d="M6 21V11"/><path d="M18 21V11"/></svg>
        <h4>{{ 'home.why.card_1_title' | t }}</h4>
        <p>{{ 'home.why.card_1_text' | t }}</p>
      </div>
      <div class="card">
        <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M20.8 8.6a5.5 5.5 0 00-9.3-4A5.5 5.5 0 002.2 8.6c0 5 9.3 11.4 9.3 11.4s9.3-6.4 9.3-11.4z"/></svg>
        <h4>{{ 'home.why.card_2_title' | t }}</h4>
        <p>{{ 'home.why.card_2_text' | t }}</p>
      </div>
      <div class="card">
        <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M3 12a9 9 0 109-9"/><path d="M3 4v6h6"/></svg>
        <h4>{{ 'home.why.card_3_title' | t }}</h4>
        <p>{{ 'home.why.card_3_text' | t }}</p>
      </div>
      <div class="card">
        <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M4 21V3M4 3h10l6 6v12H4"/><path d="M8 8h6M8 12h8M8 16h5"/></svg>
        <h4>{{ 'home.why.card_4_title' | t }}</h4>
        <p>{{ 'home.why.card_4_text' | t }}</p>
      </div>
    </div>
  </section>

  <section class="pad bg-alt">
    <h2 class="center" style="font-size:34px; margin-bottom:14px;">{{ 'home.testimonials.title' | t }}</h2>
    <p class="center" style="max-width:540px; margin:0 auto 48px; color:var(--text-soft); font-size:15px; line-height:1.6;">{{ 'home.testimonials.text_1' | t }}</p>
    <p class="center" style="max-width:540px; margin:0 auto; color:var(--text-soft); font-size:15px; line-height:1.6;">{{ 'home.testimonials.text_2' | t }}</p>
  </section>

  <section class="pad">
    <h2 class="center" style="font-size:30px; margin-bottom:12px;">{{ 'home.trust.title' | t }}</h2>
    <div class="trust-row">
      <div class="trust-item"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="1" y="7" width="14" height="10" rx="1"/><path d="M15 10h4l3 3v4h-7z"/></svg><h4>{{ 'home.trust.item_1_title' | t }}</h4><p>{{ 'home.trust.item_1_text' | t }}</p></div>
      <div class="trust-item"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M3 12a9 9 0 109-9"/><path d="M3 4v6h6"/></svg><h4>{{ 'home.trust.item_2_title' | t }}</h4><p>{{ 'home.trust.item_2_text' | t }}</p></div>
      <div class="trust-item"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6z"/></svg><h4>{{ 'home.trust.item_3_title' | t }}</h4><p>{{ 'home.trust.item_3_text' | t }}</p></div>
    </div>
  </section>
</main>
{% schema %}
{"name": "Portada"}
{% endschema %}
