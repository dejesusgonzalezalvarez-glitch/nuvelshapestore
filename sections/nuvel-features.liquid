{%- comment -%}
  Tecnología de la tela (Nuvel): 4 imágenes técnicas bajo la galería.
  Imágenes: tecnica-1-disenada-para-adaptarse.png, tecnica-2-silueta-uniforme.png,
  tecnica-3-comodidad-ritmo.png y producto-detalle.jpg (guía de tallas).
  Si una imagen no existe, la caja conserva su fondo neutro y solo se oculta
  la ́ımagen (nunca se ve una imagen rota).
{%- endcomment -%}

{%- liquid
  assign show_section = false
  assign features_handle = product.handle
  if features_handle == blank
    assign features_handle = all_products['faja-moldeadora-invisible-nuvel'].handle
  endif
  if features_handle == 'faja-moldeadora-invisible-nuvel'
    assign show_section = true
  endif
-%}

{%- if show_section -%}
  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }

    .nuvel-features__header {
      margin: 0 0 1.6rem;
    }

    .nuvel-features__title {
      margin: 0;
      font-size: 1.8rem;
      font-weight: 600;
    }

    .nuvel-features__intro {
      margin: 0.4rem 0 0;
      font-size: 1.4rem;
      line-height: 1.5;
    }

    .nuvel-features__grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    @media screen and (max-width: 359px) {
      .nuvel-features__grid {
        grid-template-columns: 1fr;
      }
    }

    .nuvel-features__item {
      margin: 0;
    }

    .nuvel-features__media {
      display: block;
      width: 100%;
      aspect-ratio: 4 / 3;
      border-radius: var(--media-radius, 2px);
      background-color: #f4f4f4;
      overflow: hidden;
    }

    .nuvel-features__img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .nuvel-features__caption {
      display: block;
      margin: 0.8rem 0 0;
      font-size: 1.3rem;
      line-height: 1.5;
    }

    .nuvel-features__name {
      display: block;
      font-weight: 600;
    }
  {%- endstyle -%}

  <div class="color-{{ section.settings.color_scheme }} gradient">
    <div class="section-{{ section.id }}-padding page-width">
      <div class="nuvel-features__header">
        <h2 class="nuvel-features__title">{{ 'nuvel.tecnica.titulo' | t }}</h2>
        <p class="nuvel-features__intro">{{ 'nuvel.tecnica.intro' | t }}</p>
      </div>

      <div class="nuvel-features__grid">
        <figure class="nuvel-features__item">
          <div class="nuvel-features__media">
            <img
              class="nuvel-features__img"
              src="{{ 'tecnica-1-disenada-para-adaptarse.jpg' | asset_url }}"
              width="1200"
              height="900"
              alt="{{ 'nuvel.tecnica.bloque1.alt' | t }}"
              loading="lazy"
              decoding="async"
              onerror="this.style.display='none'"
            >
          </div>
          <figcaption class="nuvel-features__caption">
            <span class="nuvel-features__name">{{ 'nuvel.tecnica.bloque1.titulo' | t }}</span>
            {{ 'nuvel.tecnica.bloque1.texto' | t }}
          </figcaption>
        </figure>
        <figure class="nuvel-features__item">
          <div class="nuvel-features__media">
            <img
              class="nuvel-features__img"
              src="{{ 'tecnica-2-silueta-uniforme.jpg' | asset_url }}"
              width="1200"
              height="900"
              alt="{{ 'nuvel.tecnica.bloque2.alt' | t }}"
              loading="lazy"
              decoding="async"
              onerror="this.style.display='none'"
            >
          </div>
          <figcaption class="nuvel-features__caption">
            <span class="nuvel-features__name">{{ 'nuvel.tecnica.bloque2.titulo' | t }}</span>
            {{ 'nuvel.tecnica.bloque2.texto' | t }}
          </figcaption>
        </figure>
        <figure class="nuvel-features__item">
          <div class="nuvel-features__media">
            <img
              class="nuvel-features__img"
              src="{{ 'tecnica-3-comodidad-ritmo.jpg' | asset_url }}"
              width="1200"
              height="900"
              alt="{{ 'nuvel.tecnica.bloque3.alt' | t }}"
              loading="lazy"
              decoding="async"
              onerror="this.style.display='none'"
            >
          </div>
          <figcaption class="nuvel-features__caption">
            <span class="nuvel-features__name">{{ 'nuvel.tecnica.bloque3.titulo' | t }}</span>
            {{ 'nuvel.tecnica.bloque3.texto' | t }}
          </figcaption>
        </figure>
        <figure class="nuvel-features__item">
          <div class="nuvel-features__media">
            <img
              class="nuvel-features__img"
              src="{{ 'lg-producto-detalle.jpg' | asset_url }}"
              width="1200"
              height="900"
              alt="{{ 'nuvel.tecnica.bloque4.alt' | t }}"
              loading="lazy"
              decoding="async"
              onerror="this.style.display='none'"
            >
          </div>
          <figcaption class="nuvel-features__caption">
            <span class="nuvel-features__name">{{ 'nuvel.tecnica.bloque4.titulo' | t }}</span>
            {{ 'nuvel.tecnica.bloque4.texto' | t }}
          </figcaption>
        </figure>
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Tecnología de la tela",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Tecnología de la tela"
    }
  ]
}
{% endschema %}
