{
  "sections": {
    "hero": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<style>\n  .nuvel-hero { position: relative; height: min(640px, 88vh); overflow: hidden; background: rgb(var(--color-background)); }\n  .nuvel-hero__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: right center; }\n  .nuvel-hero__overlay { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(var(--color-foreground),.35) 0%, rgba(var(--color-foreground),.15) 35%, rgba(var(--color-foreground),0) 60%); }\n  .nuvel-hero__content { position: relative; max-width: 1280px; margin: 0 auto; height: 100%; display: flex; flex-direction: column; justify-content: center; align-items: flex-start; gap: 20px; padding: 0 64px; }\n  .nuvel-hero__eyebrow { font-size: 11px; font-weight: 500; letter-spacing: .16em; text-transform: uppercase; color: rgb(var(--color-foreground)); }\n  .nuvel-hero__title { margin: 0; color: rgb(var(--color-foreground)); font-size: clamp(2rem, 5vw, 3.1rem); line-height: 1.15; max-width: 640px; font-family: var(--font-heading-family); font-weight: 600; }\n  .nuvel-hero__subtitle { margin: 0; color: rgb(var(--color-foreground)); font-weight: 400; font-size: clamp(1rem, 4vw, 17px); line-height: 1.55; max-width: 440px; }\n  .nuvel-hero__cta { display: inline-flex; align-items: center; background: rgb(var(--color-foreground)); color: rgb(var(--color-background)); padding: 15px 32px; font-size: 15px; font-weight: 500; border-radius: 2px; text-decoration: none; transition: transform .18s ease, box-shadow .18s ease; border: 1px solid rgb(var(--color-foreground)); }\n  .nuvel-hero__cta:hover { transform: translateY(-2px); box-shadow: 0 10px 22px -12px rgba(0,0,0,.5); }\n  @media (max-width: 768px) { .nuvel-hero { height: min(70vh, 82vh); } .nuvel-hero__img { object-position: 80% center; } .nuvel-hero__overlay { background: linear-gradient(180deg, rgba(var(--color-foreground),0) 0%, rgba(var(--color-foreground),.65) 100%); } .nuvel-hero__content { padding: 0 20px; justify-content: flex-end; } .nuvel-hero__eyebrow { font-size: 10px; } .nuvel-hero__title { font-size: clamp(1.4rem, 6vw, 2rem); max-width: 90vw; } .nuvel-hero__subtitle { font-size: clamp(13px, 4vw, 16px); max-width: 90vw; } .nuvel-hero__cta { font-size: 14px; padding: 13px 24px; } }\n</style>\n<div class=\"nuvel-hero\">\n  <img class=\"nuvel-hero__img\" src=\"{{ 'hero-principal.jpg' | asset_url }}\" srcset=\"{{ 'med-hero-principal.jpg' | asset_url }} 800w, {{ 'lg-hero-principal.jpg' | asset_url }} 1100w, {{ 'hero-principal.jpg' | asset_url }} 1600w\" sizes=\"100vw\" alt=\"{{ 'nuvel.hero.image_alt' | t }}\" loading=\"eager\" decoding=\"async\" fetchpriority=\"high\">\n  <div class=\"nuvel-hero__overlay\"></div>\n  <div class=\"nuvel-hero__content\">\n    <span class=\"nuvel-hero__eyebrow\">{{ 'nuvel.hero.eyebrow' | t }}</span>\n    <h1 class=\"nuvel-hero__title\">{{ 'nuvel.hero.title_line1' | t }}<br>{{ 'nuvel.hero.title_line2' | t }}</h1>\n    <p class=\"nuvel-hero__subtitle\">{{ 'nuvel.hero.subtitle' | t }}</p>\n    <a class=\"nuvel-hero__cta\" href=\"/products/faja-moldeadora-invisible-nuvel\">{{ 'nuvel.hero.cta' | t }}</a>\n  </div>\n</div>",
        "color_scheme": "scheme-3",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "vida-real": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<style>\n  .nuvel-compare { text-align: center; }\n  .nuvel-compare__eyebrow { font-size: 11px; font-weight: 500; letter-spacing: .16em; text-transform: uppercase; color: rgba(var(--color-foreground), 0.6); }\n  .nuvel-compare__title { margin: 10px 0 0; font-size: 34px; line-height: 1.2; font-family: var(--font-heading-family); font-weight: 600; color: rgb(var(--color-foreground)); }\n  .nuvel-compare__sub { max-width: 480px; margin: 14px auto 0; color: rgba(var(--color-foreground), 0.7); font-size: 15px; line-height: 1.6; }\n  .nuvel-compare__row { display: flex; justify-content: center; align-items: flex-end; max-width: 960px; margin: 48px auto 0; gap: 16px; }\n  .nuvel-compare__card { position: relative; overflow: hidden; border-radius: 2px; box-shadow: 0 18px 40px -18px rgba(var(--color-shadow), 0.22); }\n  .nuvel-compare__card img { display: block; width: 100%; height: 100%; object-fit: cover; }\n  .nuvel-compare__card--product { width: 420px; height: 480px; background: rgb(var(--color-background)); z-index: 1; }\n  .nuvel-compare__card--product img { object-fit: contain; padding: 24px; }\n  .nuvel-compare__card--worn { width: 480px; height: 520px; }\n  .nuvel-compare__tag { position: absolute; top: 16px; left: 16px; font-size: 11px; letter-spacing: .1em; text-transform: uppercase; padding: 6px 12px; border-radius: 20px; }\n  .nuvel-compare__tag--product { color: rgb(var(--color-background)); background: rgba(var(--color-foreground), 0.55); }\n  .nuvel-compare__tag--worn { color: rgb(var(--color-foreground)); background: rgba(var(--color-background), 0.85); }\n  @media (max-width: 900px) {\n    .nuvel-compare__row { flex-direction: column; align-items: center; gap: 18px; margin-top: 32px; }\n    .nuvel-compare__card--product, .nuvel-compare__card--worn { width: 92vw; max-width: 520px; height: auto; aspect-ratio: 4/5; }\n  }\n</style>\n<div class=\"nuvel-compare\">\n  <span class=\"nuvel-compare__eyebrow\">{{ 'nuvel.compare.eyebrow' | t }}</span>\n  <h2 class=\"nuvel-compare__title\">{{ 'nuvel.compare.title' | t }}</h2>\n  <p class=\"nuvel-compare__sub\">{{ 'nuvel.compare.subtitle' | t }}</p>\n  <div class=\"nuvel-compare__row\">\n    <figure class=\"nuvel-compare__card nuvel-compare__card--product\">\n      <img src=\"{{ 'producto-frente.jpg' | asset_url }}\" srcset=\"{{ 'med-producto-frente.jpg' | asset_url }} 800w, {{ 'lg-producto-frente.jpg' | asset_url }} 1100w, {{ 'producto-frente.jpg' | asset_url }} 1400w\" sizes=\"(min-width: 900px) 420px, 92vw\" width=\"1400\" height=\"1600\" alt=\"{{ 'nuvel.compare.image_alt' | t }}\" loading=\"lazy\" decoding=\"async\">\n      <figcaption class=\"nuvel-compare__tag nuvel-compare__tag--product\">{{ 'nuvel.compare.tag_product' | t }}</figcaption>\n    </figure>\n    <figure class=\"nuvel-compare__card nuvel-compare__card--worn\">\n      <img src=\"{{ 'avatar-vestida.jpg' | asset_url }}\" srcset=\"{{ 'med-avatar-vestida.jpg' | asset_url }} 800w, {{ 'lg-avatar-vestida.jpg' | asset_url }} 1100w, {{ 'avatar-vestida.jpg' | asset_url }} 1600w\" sizes=\"(min-width: 900px) 480px, 92vw\" width=\"1600\" height=\"2000\" alt=\"{{ 'nuvel.compare.worn_image_alt' | t }}\" loading=\"lazy\" decoding=\"async\">\n      <figcaption class=\"nuvel-compare__tag nuvel-compare__tag--worn\">{{ 'nuvel.compare.tag_worn' | t }}</figcaption>\n    </figure>\n  </div>\n</div>",
        "color_scheme": "scheme-1",
        "padding_top": 64,
        "padding_bottom": 48
      }
    },
    "caracteristicas-home": {
      "type": "nuvel-features",
      "settings": {
        "color_scheme": "scheme-1",
        "padding_top": 36,
        "padding_bottom": 36
      }
    },
    "producto-ancla": {
      "type": "featured-product",
      "blocks": {
        "buybox": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'nuvel-buybox', product: section.settings.product, compact: true %}"
          }
        }
      },
      "block_order": [
        "buybox"
      ],
      "settings": {
        "product": "faja-moldeadora-invisible-nuvel",
        "color_scheme": "scheme-2",
        "secondary_background": false,
        "media_size": "medium",
        "constrain_to_viewport": "true",
        "media_fit": "contain",
        "media_position": "left",
        "image_zoom": "lightbox",
        "hide_variants": false,
        "enable_video_looping": false,
        "padding_top": 64,
        "padding_bottom": 64
      }
    },
    "catalogo": {
      "type": "nuvel-catalogo",
      "blocks": {
        "producto-1": {
          "type": "product",
