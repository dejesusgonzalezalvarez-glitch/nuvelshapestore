    "vida-real": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<style>\n  .nuvel-compare { text-align: center; }\n  .nuvel-compare__eyebrow { font-size: 11px; font-weight: 500; letter-spacing: .16em; text-transform: uppercase; color: #7a6c5a; }\n  .nuvel-compare__title { margin: 10px 0 0; font-size: 34px; line-height: 1.2; }\n  .nuvel-compare__sub { max-width: 480px; margin: 14px auto 0; color: #4a3f34; font-size: 15px; line-height: 1.6; }\n  .nuvel-compare__row { display: flex; justify-content: center; align-items: flex-end; max-width: 960px; margin: 48px auto 0; }\n  .nuvel-compare__card { position: relative; overflow: hidden; border-radius: 2px; box-shadow: 0 18px 40px -18px rgba(26,20,15,.22); }\n  .nuvel-compare__card img { display: block; width: 100%; height: 100%; object-fit: cover; }\n  .nuvel-compare__card--product { width: 420px; height: 480px; background: #FFFFFF; z-index: 1; }\n  .nuvel-compare__card--product img { object-fit: contain; padding: 24px; }\n  .nuvel-compare__card--worn { width: 480px; height: 520px; margin-left: -8px; }\n  .nuvel-compare__tag { position: absolute; top: 16px; left: 16px; font-size: 11px; letter-spacing: .1em; text-transform: uppercase; padding: 6px 12px; border-radius: 20px; }\n  .nuvel-compare__tag--product { color: #FFFFFF; background: rgba(26,20,15,.55); }\n  .nuvel-compare__tag--worn { color: #2A2019; background: rgba(245,241,236,.85); }\n  @media (max-width: 900px) {\n    .nuvel-compare__row { flex-direction: column; align-items: center; gap: 18px; margin-top: 32px; }\n    .nuvel-compare__card--product, .nuvel-compare__card--worn { width: 92vw; max-width: 520px; height: auto; aspect-ratio: 4/5; margin-left: 0; }\n  }\n</style>\n<div class=\"nuvel-compare\">\n  <span class=\"nuvel-compare__eyebrow\">{{ 'nuvel.compare.eyebrow' | t }}</span>\n  <h2 class=\"nuvel-compare__title\">{{ 'nuvel.compare.title' | t }}</h2>\n  <p class=\"nuvel-compare__sub\">{{ 'nuvel.compare.subtitle' | t }}</p>\n  <div class=\"nuvel-compare__row\">\n    <div class=\"nuvel-compare__card nuvel-compare__card--product\">\n      <img src=\"{{ 'producto-frente.jpg' | asset_url }}\" srcset=\"{{ 'med-producto-frente.jpg' | asset_url }} 800w, {{ 'lg-producto-frente.jpg' | asset_url }} 1100w, {{ 'producto-frente.jpg' | asset_url }} 1400w\" sizes=\"(max-width: 900px) 92vw, 420px\" alt=\"{{ 'nuvel.compare.image_alt' | t }}\" loading=\"lazy\" decoding=\"async\">\n      <span class=\"nuvel-compare__tag nuvel-compare__tag--product\">{{ 'nuvel.compare.tag_product' | t }}</span>\n    </div>\n    <div class=\"nuvel-compare__card nuvel-compare__card--worn\">\n      <img src=\"{{ 'avatar-vestida.jpg' | asset_url }}\" srcset=\"{{ 'med-avatar-vestida.jpg' | asset_url }} 800w, {{ 'lg-avatar-vestida.jpg' | asset_url }} 1000w, {{ 'avatar-vestida.jpg' | asset_url }} 1400w\" sizes=\"(max-width: 900px) 92vw, 480px\" alt=\"{{ 'nuvel.compare.worn_image_alt' | t }}\" loading=\"lazy\" decoding=\"async\">\n      <span class=\"nuvel-compare__tag nuvel-compare__tag--worn\">{{ 'nuvel.compare.tag_worn' | t }}</span>\n    </div>\n  </div>\n</div>",
        "color_scheme": "scheme-1",
        "padding_top": 64,
        "padding_bottom": 48
      }
