        "custom_liquid": "<style>\n  .nuvel-cta { position: relative; min-height: 460px; display: flex; align-items: center; justify-content: center; overflow: hidden; background: #1A1A1A; }\n  .nuvel-cta__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 20%; }\n  .nuvel-cta__overlay { position: absolute; inset: 0; background: rgba(26,20,15,.5); }\n  .nuvel-cta__content { position: relative; text-align: center; padding: 64px 20px; max-width: 760px; }\n  .nuvel-cta__title { margin: 0; color: #FFFFFF; font-size: clamp(1.6rem, 4vw, 2.4rem); line-height: 1.2; }\n  .nuvel-cta__text { margin: 14px 0 28px; color: #F1E9DF; font-size: 16px; line-height: 1.6; }\n  .nuvel-cta__btn { display: inline-flex; align-items: center; background: #FFFFFF; color: #1A1A1A; padding: 15px 32px; font-size: 15px; font-weight: 500; border-radius: 2px; text-decoration: none; transition: transform .18s ease, box-shadow .18s ease; }\n  .nuvel-cta__btn:hover { transform: translateY(-2px); box-shadow: 0 10px 22px -12px rgba(0,0,0,.5); }\n  @media (max-width: 768px) { .nuvel-cta { min-height: 380px; } }\n</style>\n<div class=\"nuvel-cta\">\n  <img class=\"nuvel-cta__img\" src=\"{{ 'avatar-athleisure.jpg' | asset_url }}\" srcset=\"{{ 'med-avatar-athleisure.jpg' | asset_url }} 800w, {{ 'lg-avatar-athleisure.jpg' | asset_url }} 1100w, {{ 'avatar-athleisure.jpg' | asset_url }} 1600w\" sizes=\"100vw\" alt=\"{{ 'nuvel.cta.image_alt' | t }}\" loading=\"lazy\" decoding=\"async\">\n  <div class=\"nuvel-cta__overlay\"></div>\n  <div class=\"nuvel-cta__content\">\n    <h2 class=\"nuvel-cta__title\">{{ 'nuvel.cta.title' | t }}</h2>\n    <p class=\"nuvel-cta__text\">{{ 'nuvel.cta.text' | t }}</p>\n    <a class=\"nuvel-cta__btn\" href=\"{{ request.locale.root_url | remove_last: '/' }}/collections/all\">{{ 'nuvel.cta.button' | t }}</a>\n  </div>\n</div>",
