    },
    "testimonios": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "{% if section.settings.show_testimonials %}\n<div class=\"rich-text color-scheme-2 full-width page-width\" style=\"padding-top: 72px; padding-bottom: 72px;\">\n  <div class=\"rich-text__content\" style=\"text-align: center;\">\n    <h2 class=\"rich-text__heading h1\">Clientas reales, mensajes reales</h2>\n    <div class=\"rich-text__content rte\" style=\"text-align: center;\">\n      <p>Cada semana publicamos capturas de los WhatsApp de nuestras clientas: dudas de talla, qué talla pidieron y la foto de la prenda puesta. Sin poses, tal cual llegan.</p>\n      <p>Estamos pidiendo permiso a nuestras clientas para publicar aquí sus mensajes tal cual. En cuanto lo tengamos, los verás sin retocar.</p>\n    </div>\n  </div>\n</div>\n{% endif %}",
        "color_scheme": "scheme-2",
        "padding_top": 72,
        "padding_bottom": 72,
        "show_testimonials": false
      }
    },
    "confianza": {
      "type": "multicolumn",
      "blocks": {
        "column-0": {
          "type": "column",
          "settings": {
            "title": "Envío gratis",
            "text": "<p>Entrega en 7-15 días laborables, con seguimiento por email.</p>"
          }
        },
        "column-1": {
          "type": "column",
          "settings": {
            "title": "30 días de prueba",
            "text": "<p>Si no te convence, escríbenos en los primeros 30 días y lo devuelves sin complicaciones.</p>"
          }
        },
        "column-2": {
          "type": "column",
          "settings": {
            "title": "Pago 100% seguro",
            "text": "<p>Tus datos protegidos en cada compra.</p>"
          }
        }
      },
      "block_order": [
        "column-0",
        "column-1",
        "column-2"
      ],
      "settings": {
        "title": "Compra con tranquilidad",
        "heading_size": "h1",
        "button_label": "",
        "columns_desktop": 3,
        "column_alignment": "center",
        "background_style": "secondary",
        "color_scheme": "scheme-1",
        "columns_mobile": "1",
        "swipe_on_mobile": false,
        "padding_top": 64,
        "padding_bottom": 64
      }
    },
    "cta-final": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<style>\n  .nuvel-cta { position: relative; min-height: 460px; display: flex; align-items: center; justify-content: center; overflow: hidden; background: rgb(var(--color-background)); }\n  .nuvel-cta__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 20%; }\n  .nuvel-cta__overlay { position: absolute; inset: 0; background: rgba(var(--color-foreground), 0.5); }\n  .nuvel-cta__content { position: relative; text-align: center; padding: 64px 20px; max-width: 760px; }\n  .nuvel-cta__title { margin: 0; color: rgb(var(--color-foreground)); font-size: clamp(1.6rem, 4vw, 2.4rem); line-height: 1.2; font-family: var(--font-heading-family); font-weight: 600; }\n  .nuvel-cta__text { margin: 14px 0 28px; color: rgba(var(--color-foreground), 0.85); font-size: 16px; line-height: 1.6; }\n  .nuvel-cta__btn { display: inline-flex; align-items: center; background: rgb(var(--color-foreground)); color: rgb(var(--color-background)); padding: 15px 32px; font-size: 15px; font-weight: 500; border-radius: 2px; text-decoration: none; transition: transform .18s ease, box-shadow .18s ease; border: 1px solid rgb(var(--color-foreground)); }\n  .nuvel-cta__btn:hover { transform: translateY(-2px); box-shadow: 0 10px 22px -12px rgba(0,0,0,.5); }\n  @media (max-width: 768px) { .nuvel-cta { min-height: 380px; } }\n</style>\n<div class=\"nuvel-cta\">\n  <img class=\"nuvel-cta__img\" src=\"{{ 'avatar-athleisure.jpg' | asset_url }}\" srcset=\"{{ 'med-avatar-athleisure.jpg' | asset_url }} 800w, {{ 'lg-avatar-athleisure.jpg' | asset_url }} 1100w, {{ 'avatar-athleisure.jpg' | asset_url }} 1600w\" sizes=\"100vw\" alt=\"{{ 'nuvel.cta.image_alt' | t }}\" loading=\"lazy\" decoding=\"async\">\n  <div class=\"nuvel-cta__overlay\"></div>\n  <div class=\"nuvel-cta__content\">\n    <h2 class=\"nuvel-cta__title\">{{ 'nuvel.cta.title' | t }}</h2>\n    <p class=\"nuvel-cta__text\">{{ 'nuvel.cta.text' | t }}</p>\n    <a class=\"nuvel-cta__btn\" href=\"/collections/all\">{{ 'nuvel.cta.button' | t }}</a>\n  </div>\n</div>",
        "color_scheme": "scheme-3",
        "padding_top": 0,
        "padding_bottom": 0
      }
    }
  },
  "order": [
    "hero",
    "vida-real",
    "producto-ancla",
    "caracteristicas-home",
    "catalogo",
    "por-que",
    "testimonios",
    "confianza",
    "cta-final"
  ]
}