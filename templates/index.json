    "hero": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<style>\n  .nuvel-hero { position: relative; height: min(640px, 88vh); overflow: hidden; background: #1A1A1A; }\n  .nuvel-hero__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 15%; }\n  .nuvel-hero__overlay { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(26,20,15,.62) 0%, rgba(26,20,15,.22) 48%, rgba(26,20,15,0) 68%); }\n  .nuvel-hero__content { position: relative; max-width: 1280px; margin: 0 auto; height: 100%; display: flex; flex-direction: column; justify-content: center; align-items: flex-start; gap: 20px; padding: 0 64px; }\n  .nuvel-hero__eyebrow { font-size: 11px; font-weight: 500; letter-spacing: .16em; text-transform: uppercase; color: #D9CFC2; }\n  .nuvel-hero__title { margin: 0; color: #FFFFFF; font-size: clamp(2rem, 5vw, 3.1rem); line-height: 1.15; max-width: 640px; }\n  .nuvel-hero__subtitle { margin: 0; color: #F1E9DF; font-size: 17px; line-height: 1.55; max-width: 440px; }\n  .nuvel-hero__cta { display: inline-flex; align-items: center; background: #FFFFFF; color: #1A1A1A; padding: 15px 32px; font-size: 15px; font-weight: 500; border-radius: 2px; text-decoration: none; transition: transform .18s ease, box-shadow .18s ease; }\n  .nuvel-hero__cta:hover { transform: translateY(-2px); box-shadow: 0 10px 22px -12px rgba(26,20,15,.5); }\n  @media (max-width: 768px) { .nuvel-hero { height: min(560px, 82vh); } .nuvel-hero__content { padding: 0 20px; } .nuvel-hero__subtitle { font-size: 15.5px; } }\n</style>\n<div class=\"nuvel-hero\">\n  <img class=\"nuvel-hero__img\" src=\"{{ 'hero-principal.jpg' | asset_url }}\" srcset=\"{{ 'med-hero-principal.jpg' | asset_url }} 800w, {{ 'lg-hero-principal.jpg' | asset_url }} 1100w, {{ 'hero-principal.jpg' | asset_url }} 1600w\" sizes=\"100vw\" alt=\"{{ 'nuvel.hero.image_alt' | t }}\" fetchpriority=\"high\">\n  <div class=\"nuvel-hero__overlay\"></div>\n  <div class=\"nuvel-hero__content\">\n    <span class=\"nuvel-hero__eyebrow\">{{ 'nuvel.hero.eyebrow' | t }}</span>\n    <h1 class=\"nuvel-hero__title\">{{ 'nuvel.hero.title_line1' | t }}<br>{{ 'nuvel.hero.title_line2' | t }}</h1>\n    <p class=\"nuvel-hero__subtitle\">{{ 'nuvel.hero.subtitle' | t }}</p>\n    <a class=\"nuvel-hero__cta\" href=\"{{ request.locale.root_url | remove_last: '/' }}/products/faja-moldeadora-invisible-nuvel\">{{ 'nuvel.hero.cta' | t }}</a>\n  </div>\n</div>",
        "color_scheme": "scheme-1",
