          }
        },
        "producto-3": {
          "type": "product",
          "settings": {
            "product": "faja-moldeadora-invisible-nuvel"
          }
        }
      },
      "block_order": [
        "producto-1",
        "producto-2",
        "producto-3"
      ],
      "settings": {
        "heading": "Nuestro catálogo",
        "heading_size": "h1",
        "show_view_all": true,
        "view_all_style": "solid",
        "color_scheme": "scheme-1",
        "padding_top": 64,
