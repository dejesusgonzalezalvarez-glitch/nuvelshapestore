        "column-2",
        "column-3"
      ],
      "settings": {
        "title": "Por qué Nuvel",
        "heading_size": "h1",
        "button_label": "",
        "columns_desktop": 4,
        "column_alignment": "center",
        "background_style": "secondary",
        "color_scheme": "scheme-1",
        "columns_mobile": "2",
        "swipe_on_mobile": false,
        "padding_top": 64,
        "padding_bottom": 64
