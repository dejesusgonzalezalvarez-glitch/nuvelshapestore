    "por-que": {
      "type": "multicolumn",
      "blocks": {
        "column-0": {
          "type": "column",
          "settings": {
            "title": "Sin costuras, invisible",
            "text": "<p>Diseñada para no marcarse bajo la ropa.</p>"
