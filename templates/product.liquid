{%- comment -%}
  Los 4 productos "buque insignia" tienen su propia pagina hecha a mano
  (mas fotos, mas copy, FAQ propio) en /pages/<nombre>, asi que su URL de
  producto real solo redirige hacia alla. Cualquier OTRO producto (los que
  se vayan agregando despues) se muestra aqui mismo, con una pagina generica
  armada automaticamente a partir de sus datos reales de Shopify.
{%- endcomment -%}
{%- assign fichas_a_mano = "faja-moldeadora-invisible-nuvel,retro-shapewear-top-with-zipper,womens-shapewear-dress-jumpsuit,seamless-shapewear-panties" | split: "," -%}
{%- if fichas_a_mano contains product.handle -%}
  {%- assign destino = "catalogo" -%}
  {%- case product.handle -%}
    {%- when "faja-moldeadora-invisible-nuvel" -%}
      {%- assign destino = "producto" -%}
    {%- when "retro-shapewear-top-with-zipper" -%}
      {%- assign destino = "corse" -%}
    {%- when "womens-shapewear-dress-jumpsuit" -%}
      {%- assign destino = "vestido" -%}
    {%- when "seamless-shapewear-panties" -%}
      {%- assign destino = "short" -%}
  {%- endcase -%}
  <meta http-equiv="refresh" content="0; url=/pages/{{ destino }}">
  <script>window.location.replace("/pages/{{ destino }}");</script>
  <main class="wrap" style="padding:80px 0; text-align:center;">
    <p>Redirigiendo… <a href="/pages/{{ destino }}">Haz clic aquí si no avanza automáticamente</a>.</p>
  </main>
{%- else -%}
  {%- render 'pag-producto-generico' -%}
{%- endif -%}
