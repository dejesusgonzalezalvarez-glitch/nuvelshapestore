<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{%- comment -%}
  En una pagina de producto generico, page_title trae el titulo tal cual lo
  puso el proveedor (largo, cargado de palabras clave). Se recorta igual que
  en el resto de la pagina, para que la pestaña del navegador no desentone.
{%- endcomment -%}
{%- assign titulo_pestana = page_title -%}
{%- if template.name == 'product' -%}
  {%- capture titulo_pestana -%}{%- render 'titulo-limpio', product: product, palabras: 8 -%}{%- endcapture -%}
  {%- assign titulo_pestana = titulo_pestana | strip -%}
{%- endif -%}
<title>{% if template.name == 'index' %}{{ 'general.meta.title_home' | t }}{% else %}{{ titulo_pestana }} · Nuvel{% endif %}</title>
{% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
<meta name="theme-color" content="#1A1A1A">
<meta name="google-site-verification" content="kXgMIJ4KBeroAjBRLwbdak96GNKVTDOSPa7jUcVCl0Q" />
<link rel="icon" href="{{ 'favicon.ico' | asset_url }}" sizes="any">
<link rel="icon" type="image/png" href="{{ 'favicon.png' | asset_url }}">
<link rel="apple-touch-icon" href="{{ 'apple-touch-icon.png' | asset_url }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lora:wght@400;500;600;700&family=Poppins:wght@400;500;600&display=swap">
<link rel="stylesheet" href="{{ 'styles.css' | asset_url }}">
{{ content_for_header }}
<!-- Seguimiento bajo consentimiento (GDPR): GA4 y Meta Pixel solo se cargan
     si el visitante acepta el aviso de cookies. Si rechaza o no responde,
     no se carga ni se dispara nada. -->
<script>
  window.nuvelConsentKey = "nuvel_consent";
  window.nuvelConsentPendiente = false;
  window.nuvelCargarTracking = function () {
    if (window.nuvelTrackingCargado) return;
    window.nuvelTrackingCargado = true;
    var g = document.createElement("script");
    g.async = true;
    g.src = "https://www.googletagmanager.com/gtag/js?id=G-MZ84VDSPSE";
    document.head.appendChild(g);
    window.dataLayer = window.dataLayer || [];
    function gtag() { dataLayer.push(arguments); }
    window.gtag = window.gtag || gtag;
    gtag("js", new Date());
    gtag("config", "G-MZ84VDSPSE");
    var p = document.createElement("script");
    p.type = "text/javascript";
    p.text = "!function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');fbq('init','1403521171928958');fbq('track','PageView');";
    document.head.appendChild(p);
    {%- if template.name == 'product' -%}
    if (window.fbq) fbq("track", "ViewContent", {
      content_name: {{ product.title | json }},
      content_ids: [{{ product.selected_or_first_available_variant.id | json }}],
      content_type: "product",
      value: {{ product.price | divided_by: 100.0 | json }},
      currency: "EUR"
    });
    {%- endif -%}
  };
  (function () {
    var estado = null;
    try { estado = localStorage.getItem(window.nuvelConsentKey); } catch (e) {}
    if (estado === "accepted") {
      window.nuvelCargarTracking();
    } else if (estado !== "declined") {
      window.nuvelConsentPendiente = true;
    }
  })();
</script>
</head>
<body data-root="">
{% render 'global-header' %}
{{ content_for_layout }}
{% render 'global-footer' %}
<div class="welcome-overlay" id="welcome-overlay" role="dialog" aria-modal="true" aria-labelledby="welcome-title">
  <div class="welcome-box">
    <button type="button" class="cart-close welcome-close" id="welcome-close" aria-label="{{ 'general.close' | t }}">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M18 6L6 18M6 6l12 12"/></svg>
    </button>
    <p class="welcome-kicker">{{ 'welcome.kicker' | t }}</p>
    <h3 class="welcome-title" id="welcome-title">{{ 'welcome.title' | t }}</h3>
    <p class="welcome-text">{{ 'welcome.text_before' | t }}<strong>NUVEL10</strong>{{ 'welcome.text_after' | t }}</p>
    <button type="button" class="welcome-code" id="welcome-copy" data-copy-label="{{ 'welcome.copy' | t }}" data-copied-label="{{ 'welcome.copied' | t }}">NUVEL10 <span class="wc-copy">{{ 'welcome.copy' | t }}</span></button>
    <p class="welcome-hint">{{ 'welcome.hint' | t }}</p>
    <button type="button" class="btn btn-dark btn-block" id="welcome-cta">{{ 'welcome.cta' | t }}</button>
  </div>
</div>
<script>
  (function () {
    var KEY = "nuvel_welcome_visto";
    var visto = false;
    try { visto = localStorage.getItem(KEY); } catch (e) {}
    if (visto) return;
    var overlay = document.getElementById("welcome-overlay");
    if (!overlay) return;
    var cta = document.getElementById("welcome-cta");
    var btnCerrar = document.getElementById("welcome-close");
    function marcarVisto() {
      try { localStorage.setItem(KEY, "1"); } catch (e) {}
    }
    function abrir() {
      overlay.classList.add("open");
      document.documentElement.classList.add("no-scroll");
      if (cta) cta.focus();
    }
    function cerrar() {
      overlay.classList.remove("open");
      document.documentElement.classList.remove("no-scroll");
      marcarVisto();
    }
    if (btnCerrar) btnCerrar.addEventListener("click", cerrar);
    if (cta) cta.addEventListener("click", cerrar);
    overlay.addEventListener("click", function (e) { if (e.target === overlay) cerrar(); });
    document.addEventListener("keydown", function (e) { if (e.key === "Escape") cerrar(); });
    var copiar = document.getElementById("welcome-copy");
    if (copiar) {
      copiar.addEventListener("click", function () {
        var ta = document.createElement("textarea");
        ta.value = "NUVEL10";
        ta.setAttribute("readonly", "");
        ta.style.position = "fixed";
        ta.style.opacity = "0";
        document.body.appendChild(ta);
        ta.select();
        var ok = false;
        try { ok = document.execCommand("copy"); } catch (e) {}
        if (!ok) { try { navigator.clipboard.writeText("NUVEL10"); } catch (e) {} }
        document.body.removeChild(ta);
        var span = copiar.querySelector(".wc-copy");
        if (span) span.textContent = copiar.dataset.copiedLabel;
        copiar.classList.add("copied");
        setTimeout(function () {
          if (span) span.textContent = copiar.dataset.copyLabel;
          copiar.classList.remove("copied");
        }, 1800);
      });
    }
    setTimeout(abrir, 1400);
  })();
</script>
<div class="consent-banner" id="consent-banner" role="region" aria-label="{{ 'consent.title' | t }}">
  <div class="consent-inner">
    <p class="consent-text">{{ 'consent.text' | t }} <a href="/pages/privacidad">{{ 'consent.link' | t }}</a></p>
    <div class="consent-actions">
      <button type="button" class="btn btn-outline" id="consent-decline">{{ 'consent.decline' | t }}</button>
      <button type="button" class="btn btn-dark" id="consent-accept">{{ 'consent.accept' | t }}</button>
    </div>
  </div>
</div>
<script>
  (function () {
    var key = window.nuvelConsentKey || "nuvel_consent";
    var decidido = false;
    try { decidido = localStorage.getItem(key) === "accepted" || localStorage.getItem(key) === "declined"; } catch (e) {}
    if (decidido) return;
    var banner = document.getElementById("consent-banner");
    if (!banner) return;
    var btnAceptar = document.getElementById("consent-accept");
    var btnRechazar = document.getElementById("consent-decline");
    function elegir(valor) {
      try { localStorage.setItem(key, valor); } catch (e) {}
      banner.classList.remove("open");
      if (valor === "accepted" && window.nuvelCargarTracking) window.nuvelCargarTracking();
    }
    if (btnAceptar) btnAceptar.addEventListener("click", function () { elegir("accepted"); });
    if (btnRechazar) btnRechazar.addEventListener("click", function () { elegir("declined"); });
    setTimeout(function () { banner.classList.add("open"); }, 900);
  })();
</script>
</body>
</html>
