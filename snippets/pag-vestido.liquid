{%- assign p = all_products['womens-shapewear-dress-jumpsuit'] -%}
{%- assign socio = all_products['seamless-shapewear-panties'] -%}{%- capture socio_map -%}{%- for v in socio.variants -%}{%- if v.available -%}"{{ v.option2 }}":{{ v.id }},{%- endif -%}{%- endfor -%}{%- endcapture -%}
<script>
  window.__NUVEL_VARIANTES__ = {
    {%- for variant in p.variants -%}
    {%- assign color_base = variant.option1 | split: " / " | first -%}
    {%- assign talla = variant.option2 -%}
    {%- if talla == blank -%}
      {%- assign partes_titulo = variant.option1 | split: " / " -%}
      {%- assign talla = partes_titulo | last -%}
    {%- endif -%}
    {{ color_base | append: "_" | append: talla | json }}: {{ variant.id }}{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  };
</script>

<main class="wrap">
  <nav class="breadcrumb">
    <a href="/">{{ 'nav.home' | t }}</a> / <a href="/pages/catalogo">{{ 'nav.catalog' | t }}</a> / <span class="current">{{ 'tile.vestido.title' | t }}</span>
  </nav>

  <div class="pdp-row">
    <div class="gallery">
      <div class="thumbs">
        <div class="thumb active" data-thumb data-full="{{ 'lg-vestido-negro-frente.jpg' | asset_url }}"><img src="{{ 'mini-vestido-negro-frente.jpg' | asset_url }}" alt="{{ 'product_vestido.thumb_alt_1' | t }}" width="400" height="536" loading="lazy"></div>
        <div class="thumb" data-thumb data-full="{{ 'lg-vestido-negro-espalda.jpg' | asset_url }}"><img src="{{ 'mini-vestido-negro-espalda.jpg' | asset_url }}" alt="{{ 'product_vestido.thumb_alt_2' | t }}" width="400" height="536" loading="lazy"></div>
        <div class="thumb" data-thumb data-full="{{ 'lg-vestido-tallas.jpg' | asset_url }}"><img src="{{ 'mini-vestido-tallas.jpg' | asset_url }}" alt="{{ 'product_vestido.thumb_alt_3' | t }}" width="400" height="536" loading="lazy"></div>
        <div class="thumb" data-thumb data-full="{{ 'lg-vestido-ugc-negro.jpg' | asset_url }}"><img src="{{ 'mini-vestido-ugc-negro.jpg' | asset_url }}" alt="{{ 'product_vestido.thumb_alt_4' | t }}" width="400" height="536" loading="lazy"></div>
        <div class="thumb" data-thumb data-full="{{ 'lg-vestido-gris-frente.jpg' | asset_url }}"><img src="{{ 'mini-vestido-gris-frente.jpg' | asset_url }}" alt="{{ 'product_vestido.thumb_alt_5' | t }}" width="400" height="536" loading="lazy"></div>
        <div class="thumb" data-thumb data-full="{{ 'lg-vestido-gris-espalda.jpg' | asset_url }}"><img src="{{ 'mini-vestido-gris-espalda.jpg' | asset_url }}" alt="{{ 'product_vestido.thumb_alt_6' | t }}" width="400" height="536" loading="lazy"></div>
        <div class="thumb" data-thumb data-full="{{ 'lg-vestido-ugc-gris.jpg' | asset_url }}"><img src="{{ 'mini-vestido-ugc-gris.jpg' | asset_url }}" alt="{{ 'product_vestido.thumb_alt_7' | t }}" width="400" height="536" loading="lazy"></div>
      </div>
      <div class="main-shot"><img id="main-shot-img" src="{{ 'vestido-negro-frente.jpg' | asset_url }}" srcset="{{ 'med-vestido-negro-frente.jpg' | asset_url }} 800w, {{ 'lg-vestido-negro-frente.jpg' | asset_url }} 1100w" sizes="(max-width: 600px) 92vw, (max-width: 900px) 90vw, 640px" alt="{{ 'product_vestido.main_image_alt' | t }}" fetchpriority="high"><button type="button" class="gallery-arrow gallery-arrow-left" id="gallery-prev" aria-label="{{ 'gallery.prev' | t }}">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 6l-6 6 6 6"/></svg>
  </button>
  <button type="button" class="gallery-arrow gallery-arrow-right" id="gallery-next" aria-label="{{ 'gallery.next' | t }}">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg>
  </button>
  <button type="button" class="gallery-zoom-btn" id="gallery-zoom" aria-label="{{ 'gallery.zoom' | t }}">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M10.5 8v5M8 10.5h5"/><path d="M20 20l-4.8-4.8"/></svg>
  </button></div>
    </div>

    <div class="pdp-info">
      <h1>{{ 'tile.vestido.title' | t }} · Nuvel</h1>
      <p class="product-new-note"><span class="badge">{{ 'general.badge_new' | t }}</span></p>
      <div class="rating-row"><div class="stars-wrap" style="width:82px;"><div class="stars-bg" style="gap:3px;"><svg width="14" height="14" viewBox="0 0 24 24" fill="#E4DACB"><path d="M12 2l3 7h7l-5.5 4.2L18.5 21 12 16.8 5.5 21l2-7.8L2 9h7z"/></svg><svg width="14" height="14" viewBox="0 0 24 24" fill="#E4DACB"><path d="M12 2l3 7h7l-5.5 4.2L18.5 21 12 16.8 5.5 21l2-7.8L2 9h7z"/></svg><svg width="14" height="14" viewBox="0 0 24 24" fill="#E4DACB"><path d="M12 2l3 7h7l-5.5 4.2L18.5 21 12 16.8 5.5 21l2-7.8L2 9h7z"/></svg><svg width="14" height="14" viewBox="0 0 24 24" fill="#E4DACB"><path d="M12 2l3 7h7l-5.5 4.2L18.5 21 12 16.8 5.5 21l2-7.8L2 9h7z"/></svg><svg width="14" height="14" viewBox="0 0 24 24" fill="#E4DACB"><path d="M12 2l3 7h7l-5.5 4.2L18.5 21 12 16.8 5.5 21l2-7.8L2 9h7z"/></svg></div><div class="stars-fg" style="width:77.1px; gap:3px;"><svg width="14" height="14" viewBox="0 0 24 24" fill="#FFD700"><path d="M12 2l3 7h7l-5.5 4.2L18.5 21 12 16.8 5.5 21l2-7.8L2 9h7z"/></svg><svg width="14" height="14" viewBox="0 0 24 24" fill="#FFD700"><path d="M12 2l3 7h7l-5.5 4.2L18.5 21 12 16.8 5.5 21l2-7.8L2 9h7z"/></svg><svg width="14" height="14" viewBox="0 0 24 24" fill="#FFD700"><path d="M12 2l3 7h7l-5.5 4.2L18.5 21 12 16.8 5.5 21l2-7.8L2 9h7z"/></svg><svg width="14" height="14" viewBox="0 0 24 24" fill="#FFD700"><path d="M12 2l3 7h7l-5.5 4.2L18.5 21 12 16.8 5.5 21l2-7.8L2 9h7z"/></svg><svg width="14" height="14" viewBox="0 0 24 24" fill="#FFD700"><path d="M12 2l3 7h7l-5.5 4.2L18.5 21 12 16.8 5.5 21l2-7.8L2 9h7z"/></svg></div></div><span class="rating-value">4.7</span><span>28 {{ 'general.reviews' | t }}</span></div>
      <div class="price-row">
        <span class="price-now">{{ p.price | money }}</span>
        <span class="price-was">79,90&nbsp;€</span>
      </div>

      <div class="opt-group">
        <div class="opt-head"><label>{{ 'general.color_label' | t }}</label></div>
        <div class="opt-choices">
          <button class="opt-btn selected" data-color="negro" data-color-key="Black" data-color-shot="{{ 'vestido-negro-frente.jpg' | asset_url }}">{{ 'general.color_black' | t }}</button>
          <button class="opt-btn" data-color="gris" data-color-key="Grey" data-color-shot="{{ 'vestido-gris-frente.jpg' | asset_url }}">{{ 'general.color_grey' | t }}</button>
        </div>
      </div>

      <div class="opt-group">
        <div class="opt-head"><label>{{ 'general.size_label' | t }}</label><a href="#" data-ver-tallas>{{ 'general.size_guide' | t }}</a></div>
        <div class="opt-choices">
          {%- assign tallas_vistas = "|" -%}
          {%- for variant in p.variants -%}
            {%- assign vt = variant.title | split: " / " | last -%}
            {%- assign talla_clave = "|" | append: vt | append: "|" -%}
            {%- unless tallas_vistas contains talla_clave -%}
          <button type="button" class="opt-btn{% if vt == 'M' %} selected{% endif %}" data-size="{{ vt }}" data-variant-id="{{ variant.id }}">{{ vt }}</button>
              {%- assign tallas_vistas = tallas_vistas | append: vt | append: "|" -%}
            {%- endunless -%}
          {%- endfor -%}
        </div>
      </div>

      <div class="guia-tallas">
        <div class="guia-tallas__head"><span class="guia-tallas__title">{{ 'general.size_table_title' | t }}</span></div>
        <table class="guia-tallas__tabla">
          <thead><tr><th>{{ 'general.size_table_col_size' | t }}</th><th>{{ 'general.size_table_col_waist' | t }}</th><th>{{ 'general.size_table_col_hip' | t }}</th></tr></thead>
          <tbody>
            <tr><td>S</td><td>66&ndash;70</td><td>92&ndash;97</td></tr>
            <tr><td>M</td><td>70&ndash;76</td><td>97&ndash;104</td></tr>
            <tr><td>L</td><td>76&ndash;84</td><td>104&ndash;112</td></tr>
            <tr><td>XL</td><td>84&ndash;92</td><td>112&ndash;120</td></tr>
            <tr><td>2XL</td><td>92&ndash;100</td><td>120&ndash;128</td></tr>
            <tr><td>3XL</td><td>100&ndash;110</td><td>128&ndash;136</td></tr>
          </tbody>
        </table>
        <p class="guia-tallas__tip">{{ 'general.size_tip' | t }}</p>
      </div>

      <div class="qty-offer">
        <button class="qty-opt selected" data-qty-offer="1"><div class="qty-label">{{ 'qty.one_unit' | t }}</div><div class="qty-price">{{ p.price | money }}</div></button>
        <button class="qty-opt" data-qty-offer="2"><span class="qty-save">{{ 'qty.save_rotate' | t }}</span><div class="qty-label">{{ 'qty.two_units' | t }}</div><div class="qty-price">{{ p.price | times: 1.85 | round | money }}</div></button>
        <button class="qty-opt qty-opt--pack" data-pack-offer data-pack-name="Short Moldeador Sin Costuras" data-pack-partner="seamless-shapewear-panties" data-pack-partner-variants='{ {{ socio_map }} "_":0 }'><span class="qty-save">{{ 'qty.save_most_requested' | t }}</span><div class="qty-label">{{ 'product_vestido.pack_label' | t }}</div><div class="qty-price">84,80&nbsp;€</div></button>
      </div>

      {%- render 'payment-icons' -%}

      <button class="btn btn-dark btn-block" id="add-to-cart-btn">{{ 'general.buy_now' | t }}</button>

      <div class="trust-strip">
        <div class="trust-compact">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="1" y="7" width="14" height="10" rx="1"/><path d="M15 10h4l3 3v4h-7z"/></svg>
          <span>{{ 'trust.compact.shipping' | t }}</span>
        </div>
        <div class="trust-compact">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 12a9 9 0 109-9"/><path d="M3 4v6h6"/></svg>
          <span>{{ 'trust.compact.trial' | t }}</span>
        </div>
        <div class="trust-compact">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6z"/></svg>
          <span>{{ 'trust.compact.secure_payment' | t }}</span>
        </div>
      </div>

      <p class="pdp-desc">{{ 'product_vestido.description' | t }}</p>
      <ul class="bullets">
        <li><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>{{ 'product_vestido.bullet_1' | t }}</li>
        <li><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>{{ 'product_vestido.bullet_2' | t }}</li>
        <li><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>{{ 'product_vestido.bullet_3' | t }}</li>
        <li><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>{{ 'product_vestido.bullet_4' | t }}</li>
      </ul>
    </div>
  </div>

  <section class="pad bg-alt" style="margin-top:24px;">
    <div class="feature-row">
      <div class="feature-img" style="height:560px;">
        <img src="{{ 'vestido-ugc-negro-2.jpg' | asset_url }}" srcset="{{ 'med-vestido-ugc-negro-2.jpg' | asset_url }} 800w, {{ 'lg-vestido-ugc-negro-2.jpg' | asset_url }} 1100w" sizes="(max-width: 900px) 92vw, 520px" alt="{{ 'product_vestido.feature_1_image_alt' | t }}" loading="lazy" decoding="async">
      </div>
      <div class="feature-info">
        <span class="eyebrow">{{ 'product_vestido.feature_1_eyebrow' | t }}</span>
        <h2 style="font-size:30px; margin-top:10px;">{{ 'product_vestido.feature_1_title' | t }}</h2>
        <p style="font-size:15.5px; line-height:1.7; color:var(--text);">{{ 'product_vestido.feature_1_text' | t }}</p>
      </div>
    </div>
  </section>

  <section class="pad">
    <div class="feature-row feature-row--reverse">
      <div class="feature-img" style="height:520px;">
        <img src="{{ 'vestido-ugc-gris-2.jpg' | asset_url }}" srcset="{{ 'med-vestido-ugc-gris-2.jpg' | asset_url }} 800w, {{ 'lg-vestido-ugc-gris-2.jpg' | asset_url }} 1100w" sizes="(max-width: 900px) 92vw, 520px" alt="{{ 'product_vestido.feature_2_image_alt' | t }}" loading="lazy" decoding="async">
      </div>
      <div class="feature-info">
        <span class="eyebrow">{{ 'product_vestido.feature_2_eyebrow' | t }}</span>
        <h2 style="font-size:30px; margin-top:10px;">{{ 'product_vestido.feature_2_title' | t }}</h2>
        <p style="font-size:15.5px; line-height:1.7; color:var(--text);">{{ 'product_vestido.feature_2_text' | t }}</p>
      </div>
    </div>
  </section>

  <section style="padding-bottom:64px;">
    <h2 style="font-size:24px; margin-bottom:20px;">{{ 'general.product_details_title' | t }}</h2>
    <div class="product-details-copy">
      <p class="pd-headline">{{ 'product_vestido.headline' | t }}</p>
      <p>{{ 'product_vestido.details_text' | t }}</p>
    </div>
  </section>

  <section class="pad" style="padding-left:0; padding-right:0;">
    <h3 style="font-size:26px; margin-bottom:24px;">{{ 'general.video_soon_title' | t }}</h3>
    <div class="video-box">
      <img src="{{ 'vestido-ugc-negro.jpg' | asset_url }}" srcset="{{ 'med-vestido-ugc-negro.jpg' | asset_url }} 800w, {{ 'lg-vestido-ugc-negro.jpg' | asset_url }} 1100w" sizes="(max-width: 900px) 92vw, 1152px" alt="{{ 'product_vestido.video_image_alt' | t }}" loading="lazy" decoding="async">
      <div class="video-overlay">
        <div class="play-btn"><svg width="24" height="24" viewBox="0 0 24 24" fill="#1A1A1A"><path d="M8 5v14l11-7z"/></svg></div>
        <p style="font-size:14px; font-weight:500;">{{ 'general.video_placeholder_text' | t }}</p>
      </div>
    </div>
  </section>

  <section style="padding-bottom:96px;">
    <h2 style="font-size:26px; margin-bottom:6px;">{{ 'general.suggestions_title' | t }}</h2>
    <p style="font-size:14px; color:var(--text-mute); margin-bottom:0;">{{ 'general.suggestions_subtitle' | t }}</p>
    <div class="suggestions-grid"><a href="/pages/producto" class="product-tile">
      <div class="shot">
        <img src="{{ 'med-producto-frente.jpg' | asset_url }}" srcset="{{ 'mini-producto-frente.jpg' | asset_url }} 400w, {{ 'med-producto-frente.jpg' | asset_url }} 800w, {{ 'lg-producto-frente.jpg' | asset_url }} 1100w" sizes="(max-width: 600px) 46vw, (max-width: 900px) 30vw, 22vw" alt="{{ 'tile.faja.image_alt' | t }}" loading="lazy">
