{%- comment -%}
  Página de producto genérica: se usa para cualquier producto que NO sea uno
  de los 4 "buque insignia" con página propia (faja, corsé, short, vestido).
  Todo sale del producto real de Shopify — nada escrito a mano — así que un
  producto nuevo agregado en el panel aparece aquí solo, con su galería,
  tallas/colores reales y el botón de compra ya conectado al carrito.
{%- endcomment -%}
<script>
  window.__NUVEL_GENERICO__ = {
    opciones: {{ product.options | json }},
    variantes: {
      {%- for variant in product.variants -%}
      {{ variant.title | json }}: {{ variant.id }}{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    }
  };
</script>

{%- capture titulo_limpio -%}{%- render 'titulo-limpio', product: product, palabras: 9 -%}{%- endcapture -%}
{%- assign titulo_limpio = titulo_limpio | strip -%}

<main class="wrap">
  <nav class="breadcrumb">
    <a href="/">{{ 'nav.home' | t }}</a> / <a href="/pages/catalogo">{{ 'nav.catalog' | t }}</a> / <span class="current">{{ titulo_limpio }}</span>
  </nav>

  <div class="pdp-row">
    <div class="gallery-col">
    <div class="gallery">
      {%- if product.images.size > 1 -%}
      <div class="thumbs">
        {%- for image in product.images -%}
        <div class="thumb{% if forloop.first %} active{% endif %}" data-thumb data-full="{{ image | image_url: width: 1200 }}">
          <img src="{{ image | image_url: width: 400 }}" alt="{{ image.alt | default: product.title | escape }}" width="400" height="{{ 400 | divided_by: image.aspect_ratio | default: 400 }}" loading="lazy">
        </div>
        {%- endfor -%}
      </div>
      {%- endif -%}
      <div class="main-shot">
        <img id="main-shot-img" src="{{ product.featured_image | image_url: width: 1200 }}" sizes="(max-width: 600px) 92vw, (max-width: 900px) 90vw, 640px" alt="{{ product.featured_image.alt | default: product.title | escape }}" fetchpriority="high">
        <button type="button" class="gallery-arrow gallery-arrow-left" id="gallery-prev" aria-label="{{ 'gallery.prev' | t }}">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 6l-6 6 6 6"/></svg>
        </button>
        <button type="button" class="gallery-arrow gallery-arrow-right" id="gallery-next" aria-label="{{ 'gallery.next' | t }}">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg>
        </button>
        <button type="button" class="gallery-zoom-btn" id="gallery-zoom" aria-label="{{ 'gallery.zoom' | t }}">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M10.5 8v5M8 10.5h5"/><path d="M20 20l-4.8-4.8"/></svg>
        </button>
      </div>
    </div>

      {%- comment -%}
        Las descripciones que vienen del proveedor a veces traen corchetes
        sueltos de cuando las scrapean ("[Soft Comfort Bra is made of...").
        Se limpian esos caracteres antes de mostrarla. Va debajo de las
        fotos (no en la columna de compra) para que ese espacio no quede
        vacío cuando la columna de compra es más alta que la galería.
      {%- endcomment -%}
      <div class="pdp-desc">{{ product.description | replace: '[', '' | replace: ']', '' | replace: '"', '' }}</div>

      {%- comment -%}
        Imágenes técnicas del Sujetador Corrector de Postura: solo se
        muestran en esta ficha (comprobando el handle), igual que se hizo a
        mano en la página de la Faja.
      {%- endcomment -%}
      {%- if product.handle == 'sujetador-corrector-postura' -%}
      <div class="gallery-col-features">
        <img src="https://cdn.shopify.com/s/files/1/0814/1288/2673/files/postura-feature-sinaros.jpg?width=400" srcset="https://cdn.shopify.com/s/files/1/0814/1288/2673/files/postura-feature-sinaros.jpg?width=200 200w, https://cdn.shopify.com/s/files/1/0814/1288/2673/files/postura-feature-sinaros.jpg?width=400 400w" sizes="200px" alt="{{ 'product_postura.feature_sinaros_alt' | t }}" loading="lazy">
        <img src="https://cdn.shopify.com/s/files/1/0814/1288/2673/files/postura-feature-cierre.jpg?width=400" srcset="https://cdn.shopify.com/s/files/1/0814/1288/2673/files/postura-feature-cierre.jpg?width=200 200w, https://cdn.shopify.com/s/files/1/0814/1288/2673/files/postura-feature-cierre.jpg?width=400 400w" sizes="200px" alt="{{ 'product_postura.feature_cierre_alt' | t }}" loading="lazy">
        <img src="https://cdn.shopify.com/s/files/1/0814/1288/2673/files/postura-feature-tirantes.jpg?width=400" srcset="https://cdn.shopify.com/s/files/1/0814/1288/2673/files/postura-feature-tirantes.jpg?width=200 200w, https://cdn.shopify.com/s/files/1/0814/1288/2673/files/postura-feature-tirantes.jpg?width=400 400w" sizes="200px" alt="{{ 'product_postura.feature_tirantes_alt' | t }}" loading="lazy">
      </div>
      {%- endif -%}

      {%- comment -%}
        Preguntas frecuentes genéricas (válidas para cualquier prenda de la
        tienda): además de ser útiles, rellenan con contenido real el hueco
        que queda en PC cuando la columna de compra (opciones + bundle +
        precio) es más alta que la galería + descripción de esta columna.
      {%- endcomment -%}
      <section class="gallery-col-faq">
        <h2 style="font-size:20px; margin:32px 0 16px;">{{ 'general.generic_faq_title' | t }}</h2>
        <div class="faq-list">
          <div class="accordion-item" id="gen-faq-1">
            <button type="button" aria-expanded="false" aria-controls="gen-faq-1-a">
              <span class="q">{{ 'general.generic_faq_1_q' | t }}</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
            </button>
            <div class="a" id="gen-faq-1-a">{{ 'general.generic_faq_1_a' | t }}</div>
          </div>
          <div class="accordion-item" id="gen-faq-2">
            <button type="button" aria-expanded="false" aria-controls="gen-faq-2-a">
              <span class="q">{{ 'general.generic_faq_2_q' | t }}</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
            </button>
            <div class="a" id="gen-faq-2-a">{{ 'general.generic_faq_2_a' | t }}</div>
          </div>
          <div class="accordion-item" id="gen-faq-3">
            <button type="button" aria-expanded="false" aria-controls="gen-faq-3-a">
              <span class="q">{{ 'general.generic_faq_3_q' | t }}</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
            </button>
            <div class="a" id="gen-faq-3-a">{{ 'general.generic_faq_3_a' | t }}</div>
          </div>
          <div class="accordion-item" id="gen-faq-4">
            <button type="button" aria-expanded="false" aria-controls="gen-faq-4-a">
              <span class="q">{{ 'general.generic_faq_4_q' | t }}</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
            </button>
            <div class="a" id="gen-faq-4-a">{{ 'general.generic_faq_4_a' | t }}</div>
          </div>
        </div>
      </section>
    </div>

    <div class="pdp-info">
      <h1>{{ titulo_limpio }} · Nuvel</h1>
      {%- render 'rating-stars', product: product -%}
      <div class="price-row">
        <span class="price-now">{{ product.price | money }}</span>
        {%- if product.compare_at_price > product.price -%}
        <span class="price-was">{{ product.compare_at_price | money }}</span>
        {%- endif -%}
      </div>

      {%- for option in product.options_with_values -%}
      {%- capture nombre_opcion_es -%}{%- render 'opcion-traducida', valor: option.name -%}{%- endcapture -%}
      {%- assign nombre_opcion_es = nombre_opcion_es | strip -%}
      {%- assign es_color = false -%}
      {%- if option.name contains 'olor' -%}{%- assign es_color = true -%}{%- endif -%}
      {%- comment -%}
        Si el Color mezcla valores "individuales" (empiezan con "1 ", sin
        "+") con "packs" (empiezan con "2 " o combinan dos colores con
        "+"), se separan en dos filas: individuales arriba, packs abajo —
        para productos con un solo tipo de valor (la mayoría del catálogo)
        esto no cambia nada, siguen en una sola fila.
      {%- endcomment -%}
      {%- assign _hay_individuales = false -%}
      {%- assign _hay_packs = false -%}
      {%- if es_color -%}
        {%- for value in option.values -%}
          {%- assign _v_inicio = value | truncate: 2, '' -%}
          {%- assign _tiene_mas = false -%}
          {%- if value contains '+' -%}{%- assign _tiene_mas = true -%}{%- endif -%}
          {%- assign _es_individual_check = false -%}
          {%- if _v_inicio == '1 ' -%}
            {%- unless _tiene_mas -%}{%- assign _es_individual_check = true -%}{%- endunless -%}
          {%- endif -%}
          {%- if _es_individual_check -%}
            {%- assign _hay_individuales = true -%}
          {%- else -%}
            {%- assign _hay_packs = true -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
      {%- assign _separar_filas = false -%}
      {%- if _hay_individuales and _hay_packs -%}{%- assign _separar_filas = true -%}{%- endif -%}
      <div class="opt-group">
        <div class="opt-head"><label>{{ nombre_opcion_es }}</label></div>
        <div class="opt-choices{% if es_color %} opt-choices--swatch{% endif %}">
          {%- for _fase in (1..2) -%}
          {%- for value in option.values -%}
          {%- assign _v_inicio = value | truncate: 2, '' -%}
          {%- assign _tiene_mas = false -%}
          {%- if value contains '+' -%}{%- assign _tiene_mas = true -%}{%- endif -%}
          {%- assign _es_individual = false -%}
          {%- if _v_inicio == '1 ' -%}
            {%- unless _tiene_mas -%}{%- assign _es_individual = true -%}{%- endunless -%}
          {%- endif -%}
          {%- assign _mostrar = true -%}
          {%- if _separar_filas -%}
            {%- if _fase == 1 and _es_individual == false -%}{%- assign _mostrar = false -%}{%- endif -%}
            {%- if _fase == 2 and _es_individual -%}{%- assign _mostrar = false -%}{%- endif -%}
          {%- elsif _fase == 2 -%}
            {%- assign _mostrar = false -%}
          {%- endif -%}
          {%- if _mostrar -%}
          {%- capture valor_opcion_es -%}{%- render 'opcion-traducida', valor: value -%}{%- endcapture -%}
          {%- assign valor_opcion_es = valor_opcion_es | strip -%}
          {%- if es_color -%}
            {%- assign _swatch_img = product.featured_image -%}
            {%- for v in product.variants -%}
              {%- if v.option1 == value or v.option2 == value or v.option3 == value -%}
                {%- if v.image -%}{%- assign _swatch_img = v.image -%}{%- endif -%}
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}
          <button type="button" class="opt-btn opt-btn--swatch{% if forloop.first and _fase == 1 %} selected{% endif %}" data-opt-index="{{ forloop.parentloop.parentloop.index0 }}" data-opt-value="{{ value | escape }}">
            <span class="swatch-thumb">{%- if _swatch_img -%}<img src="{{ _swatch_img | image_url: width: 100 }}" alt="{{ valor_opcion_es | escape }}" loading="lazy">{%- endif -%}</span>
            <span class="swatch-label">{{ valor_opcion_es }}</span>
          </button>
          {%- else -%}
          <button type="button" class="opt-btn{% if forloop.first %} selected{% endif %}" data-opt-index="{{ forloop.parentloop.parentloop.index0 }}" data-opt-value="{{ value | escape }}">{{ valor_opcion_es }}</button>
          {%- endif -%}
          {%- endif -%}
          {%- endfor -%}
          {%- if _separar_filas and _fase == 1 -%}<div class="opt-choices-break"></div>{%- endif -%}
          {%- endfor -%}
        </div>
      </div>
      {%- endfor -%}

      {%- comment -%} Estos productos se venden solos, sin combo bundle. {%- endcomment -%}
      {%- assign _sin_bundle = "smart-posture-corrector-for-kids-and-students" | split: "," -%}
      {%- capture _nicho_actual -%}{%- render 'producto-nicho', producto: product -%}{%- endcapture -%}
      {%- assign _nicho_actual = _nicho_actual | strip -%}
      {%- unless _sin_bundle contains product.handle -%}
      {%- if _nicho_actual != blank -%}
        {%- assign _socio_generico = nil -%}
        {%- for _cand in collections.all.products -%}
          {%- if _cand.id != product.id and _socio_generico == nil -%}
            {%- capture _nicho_cand -%}{%- render 'producto-nicho', producto: _cand -%}{%- endcapture -%}
            {%- assign _nicho_cand = _nicho_cand | strip -%}
            {%- if _nicho_cand == _nicho_actual -%}
              {%- assign _socio_generico = _cand -%}
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
        {%- if _socio_generico -%}
          {%- capture _titulo_socio -%}{%- render 'titulo-limpio', product: _socio_generico, palabras: 6 -%}{%- endcapture -%}
          {%- assign _titulo_socio = _titulo_socio | strip -%}
          {%- render 'bundle-combo', main: product, partner: _socio_generico, descuento: 15,
                     titulo: 'bundle.generic_title', frase: 'bundle.generic_reason',
                     nombre_main: titulo_limpio, nombre_partner: _titulo_socio -%}
        {%- endif -%}
      {%- endif -%}
      {%- endunless -%}

      <div class="qty-offer">
        <button type="button" class="qty-opt selected" data-generic-qty="1"><div class="qty-label">{{ 'qty.one_unit' | t }}</div><div class="qty-price">{{ product.price | money }}</div></button>
        <button type="button" class="qty-opt" data-generic-qty="2"><span class="qty-save">{{ 'qty.save_rotate' | t }}</span><div class="qty-label">{{ 'qty.two_units' | t }}</div><div class="qty-price">{{ product.price | times: 1.85 | round | money }}</div></button>
      </div>

      {%- render 'payment-icons' -%}

      <button type="button" class="btn btn-dark btn-block" id="generic-add-to-cart-btn">{{ 'general.buy_now' | t }}</button>

      <div class="trust-strip">
        <div class="trust-compact">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="1" y="7" width="14" height="10" rx="1"/><path d="M15 10h4l3 3v4h-7z"/></svg>
          <span>{{ 'trust.compact.shipping' | t }}</span>
        </div>
        <div class="trust-compact">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 12a9 9 0 109-9"/><path d="M3 4v6h6"/></svg>
          <span>{{ 'trust.compact.trial' | t }}</span>
        </div>
        <div class="trust-compact">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6z"/></svg>
          <span>{{ 'trust.compact.secure_payment' | t }}</span>
        </div>
      </div>
    </div>
  </div>

  <section style="padding-bottom:96px;">
    <h2 style="font-size:26px; margin-bottom:6px;">{{ 'general.suggestions_title' | t }}</h2>
    <p style="font-size:14px; color:var(--text-mute); margin-bottom:0;">{{ 'general.suggestions_subtitle' | t }}</p>
    <div class="suggestions-grid">
      {%- assign sugeridos = 0 -%}
      {%- for recomendado in collections.all.products -%}
        {%- if recomendado.id != product.id and sugeridos < 3 -%}
          {%- assign sugeridos = sugeridos | plus: 1 -%}
          {%- capture titulo_recomendado -%}{%- render 'titulo-limpio', product: recomendado, palabras: 6 -%}{%- endcapture -%}
          {%- assign titulo_recomendado = titulo_recomendado | strip -%}
          <a href="{{ recomendado.url }}" class="product-tile">
            <div class="shot">
              {%- if recomendado.featured_image -%}
              <img src="{{ recomendado.featured_image | image_url: width: 800 }}" sizes="(max-width: 600px) 46vw, (max-width: 900px) 30vw, 22vw" alt="{{ titulo_recomendado | escape }}" loading="lazy">
              {%- endif -%}
            </div>
            <div class="info">
              <h4>{{ titulo_recomendado }}</h4>
              {%- render 'rating-stars', product: recomendado, size: 'tile' -%}
              <div class="price-row" style="margin-top:6px;">
                <span style="font-weight:600;">{{ recomendado.price | money }}</span>
              </div>
            </div>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </section>
</main>
{%- render 'seo-product', product: product -%}

<script>
  (function () {
    var datos = window.__NUVEL_GENERICO__;
    if (!datos) return;
    var seleccion = {};
    var cantidad = 1;
    document.querySelectorAll(".opt-btn[data-opt-index].selected").forEach(function (b) {
      seleccion[b.dataset.optIndex] = b.dataset.optValue;
    });

    document.querySelectorAll("[data-generic-qty]").forEach(function (b) {
      b.addEventListener("click", function () {
        document.querySelectorAll("[data-generic-qty]").forEach(function (o) { o.classList.remove("selected"); });
        b.classList.add("selected");
        cantidad = Number(b.dataset.genericQty) || 1;
      });
    });

    function variantIdActual() {
      var partes = [];
      for (var i = 0; i < datos.opciones.length; i++) partes.push(seleccion[i] || "");
      return datos.variantes[partes.join(" / ")] || null;
    }

    document.querySelectorAll(".opt-btn[data-opt-index]").forEach(function (b) {
      b.addEventListener("click", function () {
        var idx = b.dataset.optIndex;
        document.querySelectorAll('.opt-btn[data-opt-index="' + idx + '"]').forEach(function (o) { o.classList.remove("selected"); });
        b.classList.add("selected");
        seleccion[idx] = b.dataset.optValue;
      });
    });

    var boton = document.getElementById("generic-add-to-cart-btn");
    if (boton) {
      boton.addEventListener("click", function () {
        var id = variantIdActual();
        if (!id) return;
        boton.disabled = true;
        fetch("/cart/add.js", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ items: [{ id: Number(id), quantity: cantidad }] }),
        })
          .then(function (r) { return r.ok ? r.json() : Promise.reject(r); })
          .then(function (added) {
            if (window.fbq) {
              var items = added.items || [added];
              var valor = items.reduce(function (s, i) { return s + (i.line_price || i.price || 0); }, 0) / 100;
              fbq('track', 'AddToCart', { value: valor.toFixed(2), currency: 'EUR', content_ids: items.map(function (i) { return i.variant_id || i.id; }), content_type: 'product' });
            }
            if (window.NuvelCart) {
              window.NuvelCart.renderCart().then(function () {
                boton.disabled = false;
                window.NuvelCart.openCart();
              });
            } else {
              boton.disabled = false;
              document.getElementById("cart-drawer")?.classList.add("open");
              document.getElementById("cart-overlay")?.classList.add("open");
            }
          })
          .catch(function () {
            boton.disabled = false;
            alert((window.__NUVEL_I18N__ && window.__NUVEL_I18N__.alertAddFailed) || "No se pudo añadir el producto al carrito. Intenta de nuevo.");
          });
      });
    }

    // Bundle "comprados juntos": el socio del bundle es dinamico aqui, asi que
    // se anade en su talla por defecto (la primera disponible); la clienta la
    // ajusta en el carrito. El descuento del conjunto lo aplica un descuento
    // automatico de Shopify, igual que en las paginas de los buque insignia.
    var i18n = window.__NUVEL_I18N__ || {};
    function fmtGen(n) {
      var loc = (i18n.lang || "es").indexOf("en") === 0 ? "en-US" : "es-ES";
      return "€" + n.toLocaleString(loc, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }
    document.querySelectorAll(".bundle-box").forEach(function (box) {
      var mainPrice = parseFloat(box.dataset.mainPrice || "0");
      var partnerPrice = parseFloat(box.dataset.partnerPrice || "0");
      var discount = parseFloat(box.dataset.discount || "0");
      var checkbox = box.querySelector("[data-bundle-toggle]");
      var wasEl = box.querySelector(".bundle-total-was");
      var nowEl = box.querySelector(".bundle-total-now");
      var saveEl = box.querySelector(".bundle-save");
      var idSocio = box.dataset.partnerVariantId ? Number(box.dataset.partnerVariantId) : null;

      function refreshBundle() {
        // El descuento real de Shopify ("15% en la 2da unidad") solo baja el
        // precio del articulo mas barato del carrito, no el total del combo.
        // Se calcula igual aqui para que el precio mostrado coincida exacto
        // con lo que se cobra al pagar (antes se mostraba total*(1-dto), que
        // no coincidia con el cobro real).
        var incluir = !checkbox || checkbox.checked;
        var total = incluir ? mainPrice + partnerPrice : mainPrice;
        var dto = incluir ? discount : 0;
        // Shopify trunca el centimo hacia abajo (34,90*15% => 523, no 524),
        // asi que aqui tambien se usa floor y no round para que coincida
        // exacto con el descuento real, sin diferencia de 1 centimo.
        var ahorro = incluir ? Math.floor(Math.min(mainPrice, partnerPrice) * (dto / 100) * 100) / 100 : 0;
        var ahora = Math.round((total - ahorro) * 100) / 100;
        if (wasEl) { wasEl.textContent = fmtGen(total); wasEl.style.display = ""; }
        if (nowEl) nowEl.textContent = fmtGen(ahora);
        if (saveEl) {
          saveEl.textContent = ahorro > 0 ? (i18n.bundleSave || "Ahorras") + " " + fmtGen(ahorro) : "";
          saveEl.style.display = ahorro > 0 ? "" : "none";
        }
      }
      if (checkbox) checkbox.addEventListener("change", refreshBundle);
      refreshBundle();

      box.querySelector(".bundle-add-btn").addEventListener("click", function (e) {
        var items = [];
        var idMain = variantIdActual();
        if (idMain) items.push({ id: Number(idMain), quantity: 1 });
        if ((!checkbox || checkbox.checked) && idSocio) items.push({ id: idSocio, quantity: 1 });
        if (!items.length) return;
        var boton = e.currentTarget;
        boton.disabled = true;
        fetch("/cart/add.js", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ items: items }),
        })
          .then(function (r) { return r.ok ? r.json() : Promise.reject(r); })
          .then(function (added) {
            if (window.fbq) {
              var addedItems = added.items || [added];
              var valor = addedItems.reduce(function (s, i) { return s + (i.line_price || i.price || 0); }, 0) / 100;
              fbq('track', 'AddToCart', { value: valor.toFixed(2), currency: 'EUR', content_ids: addedItems.map(function (i) { return i.variant_id || i.id; }), content_type: 'product' });
            }
            if (window.NuvelCart) {
              window.NuvelCart.renderCart().then(function () {
                boton.disabled = false;
                window.NuvelCart.openCart();
              });
            } else {
              boton.disabled = false;
              document.getElementById("cart-drawer")?.classList.add("open");
              document.getElementById("cart-overlay")?.classList.add("open");
            }
          })
          .catch(function () {
            boton.disabled = false;
            alert((i18n && i18n.alertAddPackFailed) || "No se pudo añadir el pack. Intenta de nuevo.");
          });
      });
    });
  })();
</script>
