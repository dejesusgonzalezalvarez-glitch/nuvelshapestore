{%- liquid
  assign compact = compact | default: false
  assign show_pack_prices = true
  if settings.show_pack_prices == false
    assign show_pack_prices = false
  endif

  assign size_order = 'S,M,L,XL,2XL,3XL' | split: ','

  assign current_variant = product.selected_or_first_available_variant

  assign faja_handle = 'faja-moldeadora-invisible-nuvel'
  assign body_handle = 'womens-shapewear-dress-jumpsuit'
  assign bragas_handle = 'seamless-shapewear-panties'

  assign faja_product = all_products[faja_handle]
  assign body_product = all_products[body_handle]
  assign bragas_product = all_products[bragas_handle]

  assign faja_variant = blank
  assign body_variant = blank
  assign bragas_variant = blank

  if faja_product != blank
    assign faja_variant = faja_product.variants | where: 'option1', current_variant.option1 | first
  endif
  if body_product != blank
    assign body_variant = body_product.variants | where: 'option1', current_variant.option1 | first
  endif
  if bragas_product != blank
    assign bragas_variant = bragas_product.variants | where: 'option1', current_variant.option1 | first
  endif

  assign base_price_cents = current_variant.price
  assign base_price = current_variant.price | money
  assign base_compare_at = current_variant.compare_at_price | money

  assign duo_price_cents = current_variant.price | times: 1.5
  assign duo_price = duo_price_cents | money
  assign duo_compare_at = current_variant.price | times: 2 | money

  assign kit_price = 6490 | money

  assign kit_compare_at = 0
  if faja_product != blank and body_product != blank and bragas_product != blank
    assign faja_first_price = faja_product.variants.first.price
    assign body_first_price = body_product.variants.first.price
    assign bragas_first_price = bragas_product.variants.first.price
    assign kit_compare_at = faja_first_price | plus: body_first_price | plus: bragas_first_price | money
  else
    assign kit_compare_at = 8480 | money
  endif

  assign faja_variant_id = faja_variant.id | default: current_variant.id
  assign body_variant_id = body_variant.id | default: 0
  assign bragas_variant_id = bragas_variant.id | default: 0
-%}

<div class="nuvel-buybox{% if compact %} nuvel-buybox--compact{% endif %}" data-nuvel-buybox data-section-id="{{ section.id | default: 'home' }}" data-base-price="{{ current_variant.price }}">
  <p class="nuvel-buybox__eyebrow">{{ 'nuvel.product_page.eyebrow' | t }}</p>

  <h1 class="nuvel-buybox__title">{{ product.title | escape }}</h1>

  <div id="nuvel-price-{{ section.id | default: 'home' }}" role="status" class="nuvel-buybox__price">
    {%- render 'price', product: product, use_variant: true, show_badges: true, price_class: 'price--large' -%}
  </div>

  <div class="nuvel-buybox__shipping-row" aria-hidden="false">
    <span class="nuvel-buybox__shipping-icon" aria-hidden="true">{% render 'icon', icon: 'truck', size: 18 %}</span>
    <div class="nuvel-buybox__shipping-text">
      <strong>{{ 'nuvel.product_page.shipping_row_title' | t }}</strong>
      <span>{{ 'nuvel.product_page.shipping_row_text' | t }}</span>
    </div>
  </div>

  <div class="nuvel-buybox__size-selector" data-size-selector>
    <label class="form__label" for="NuvelSizeSelector-{{ section.id | default: 'home' }}">{{ 'nuvel.product_page.size_selector_label' | t }}</label>
    <div class="nuvel-buybox__size-buttons" role="group" aria-labelledby="NuvelSizeSelector-{{ section.id | default: 'home' }}">
      {%- for size in size_order -%}
        {%- assign variant_for_size = product.variants | where: 'option1', size | first -%}
        {%- assign variant_available = false -%}
        {%- if variant_for_size != blank and variant_for_size.available -%}
          {%- assign variant_available = true -%}
        {%- endif -%}
        {%- assign is_selected = forloop.first -%}
        {%- if variant_for_size == blank -%}
          {%- continue -%}
        {%- endif -%}
        <button
          type="button"
          class="nuvel-buybox__size-button{% if is_selected %} is-selected{% endif %}{% unless variant_available %} is-sold-out{% endunless %}"
          data-size="{{ size }}"
          data-variant-id="{{ variant_for_size.id }}"
          {% unless variant_available %}disabled aria-disabled="true"{% endunless %}
          {% if is_selected %}aria-pressed="true"{% else %}aria-pressed="false"{% endif %}
        >
          <span class="nuvel-buybox__size-button-text">{{ size }}</span>
          {% unless variant_available %}
            <span class="nuvel-buybox__size-button-strike" aria-hidden="true"></span>
            <span class="visually-hidden">{{ 'products.product.sold_out' | t }}</span>
          {% endunless %}
        </button>
      {%- endfor -%}
    </div>
    <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" class="nuvel-buybox__variant-id">
  </div>

  <div class="nuvel-buybox__packs" data-packs>
    <h3 class="nuvel-buybox__packs-title">{% unless compact %}{{ 'nuvel.product_page.packs_title' | t }}{% endunless %}</h3>
    <div class="nuvel-buybox__packs-list" role="radiogroup" aria-label="{{ 'nuvel.product_page.packs_title' | t }}">

      <label class="nuvel-buybox__pack-card{% unless show_pack_prices %} nuvel-buybox__pack-card--no-prices{% endunless %}" data-pack="solo">
        <input type="radio" name="nuvel-pack" value="solo" class="nuvel-buybox__pack-radio" aria-label="{{ 'nuvel.product_page.pack_solo_title' | t }}">
        <span class="nuvel-buybox__pack-radio-visual" aria-hidden="true"></span>
        <div class="nuvel-buybox__pack-card-body">
          <div class="nuvel-buybox__pack-thumb">
            {%- if product.featured_media -%}
              {{ product.featured_media | image_tag: width: 64, height: 48, loading: 'lazy', alt: product.title | escape }}
            {%- else -%}
              <span class="visually-hidden">{{ 'nuvel.product_page.pack_solo_title' | t }}</span>
            {%- endif -%}
          </div>
          <div class="nuvel-buybox__pack-info">
            <h4 class="nuvel-buybox__pack-name">{{ 'nuvel.product_page.pack_solo_title' | t }}</h4>
            <p class="nuvel-buybox__pack-includes">{{ 'nuvel.product_page.pack_solo_subtitle' | t }}</p>
            {%- if show_pack_prices -%}
              <div class="nuvel-buybox__pack-prices">
                <span class="nuvel-buybox__pack-price">{{ base_price }}</span>
              </div>
            {%- endif -%}
          </div>
        </div>
      </label>

      <label class="nuvel-buybox__pack-card is-selected{% unless show_pack_prices %} nuvel-buybox__pack-card--no-prices{% endunless %}" data-pack="duo">
        <input type="radio" name="nuvel-pack" value="duo" class="nuvel-buybox__pack-radio" checked aria-label="{{ 'nuvel.product_page.pack_duo_title' | t }}">
        <span class="nuvel-buybox__pack-radio-visual" aria-hidden="true"></span>
        <div class="nuvel-buybox__pack-card-body">
          <div class="nuvel-buybox__pack-thumb">
            {%- if product.featured_media -%}
              {{ product.featured_media | image_tag: width: 64, height: 48, loading: 'lazy', alt: product.title | escape }}
            {%- else -%}
              <span class="visually-hidden">{{ 'nuvel.product_page.pack_duo_title' | t }}</span>
            {%- endif -%}
          </div>
          <div class="nuvel-buybox__pack-info">
            <div class="nuvel-buybox__pack-name-row">
              <h4 class="nuvel-buybox__pack-name">{{ 'nuvel.product_page.pack_duo_title' | t }}</h4>
              <span class="nuvel-buybox__pack-badge">{{ 'nuvel.product_page.pack_duo_badge' | t }}</span>
            </div>
            <p class="nuvel-buybox__pack-includes">{{ 'nuvel.product_page.pack_duo_subtitle' | t }}</p>
            {%- if show_pack_prices -%}
              <div class="nuvel-buybox__pack-prices">
                <span class="nuvel-buybox__pack-price">{{ duo_price }}</span>
                <span class="nuvel-buybox__pack-compare">{{ duo_compare_at }}</span>
              </div>
            {%- endif -%}
          </div>
        </div>
      </label>

      <label class="nuvel-buybox__pack-card{% unless show_pack_prices %} nuvel-buybox__pack-card--no-prices{% endunless %}" data-pack="kit">
        <input type="radio" name="nuvel-pack" value="kit" class="nuvel-buybox__pack-radio" aria-label="{{ 'nuvel.product_page.pack_kit_title' | t }}">
        <span class="nuvel-buybox__pack-radio-visual" aria-hidden="true"></span>
        <div class="nuvel-buybox__pack-card-body">
          <div class="nuvel-buybox__pack-thumb">
            {%- if body_product != blank and body_product.featured_media -%}
              {{ body_product.featured_media | image_tag: width: 64, height: 48, loading: 'lazy', alt: body_product.title | escape }}
            {%- else -%}
              <span class="visually-hidden">{{ 'nuvel.product_page.pack_kit_title' | t }}</span>
            {%- endif -%}
          </div>
          <div class="nuvel-buybox__pack-info">
            <h4 class="nuvel-buybox__pack-name">{{ 'nuvel.product_page.pack_kit_title' | t }}</h4>
            <p class="nuvel-buybox__pack-includes">{{ 'nuvel.product_page.pack_kit_subtitle' | t }}</p>
            {%- if show_pack_prices -%}
              <div class="nuvel-buybox__pack-prices">
                <span class="nuvel-buybox__pack-price">{{ kit_price }}</span>
                <span class="nuvel-buybox__pack-compare">{{ kit_compare_at }}</span>
              </div>
            {%- endif -%}
          </div>
        </div>
      </label>

    </div>

    <script type="application/json" data-nuvel-pack-data>
      {
        "solo": {
          "items": [{ "variant_id": {{ current_variant.id }}, "quantity": 1 }],
          "properties": { "_pack": "solo" }
        },
        "duo": {
          "items": [{ "variant_id": {{ current_variant.id }}, "quantity": 2 }],
          "properties": { "_pack": "duo" }
        },
        "kit": {
          "items": [
            { "variant_id": {{ current_variant.id }}, "quantity": 1 },
            { "variant_id": {{ body_variant_id }}, "quantity": 1 },
            { "variant_id": {{ bragas_variant_id }}, "quantity": 1 }
          ],
          "properties": { "_pack": "kit" }
        }
      }
    </script>
  </div>

  {%- assign form_id = 'nuvel-product-form-' | append: section.id | default: 'home' -%}
  {%- form 'product', product, id: form_id, class: 'nuvel-buybox__form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
    <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" class="product-variant-id">
    <input type="hidden" name="quantity" value="1" class="nuvel-buybox__quantity">

    <div class="product-form__error-message-wrapper" role="alert" hidden>
      <span class="svg-wrapper">{{ 'icon-error.svg' | inline_asset_content }}</span>
      <span class="product-form__error-message"></span>
    </div>

    <div class="nuvel-buybox__button-group">
      {%- assign show_dynamic_checkout = true -%}
      {%- if show_dynamic_checkout -%}
        <div class="nuvel-buybox__dynamic-checkout">
          {{ form | payment_button }}
        </div>
      {%- endif -%}

      <button
        type="submit"
        name="add"
        id="NuvelAddToCart-{{ section.id | default: 'home' }}"
        class="nuvel-buybox__add-to-cart button button--full-width"
        {% if product.selected_or_first_available_variant.available == false or product.selected_or_first_available_variant == null %}disabled{% endif %}
      >
        <span>{{ 'nuvel.product_page.add_to_cart_button' | t }} &middot; <span class="nuvel-buybox__add-to-cart-price">{{ base_price }}</span></span>
        {% render 'loading-spinner' %}
      </button>

      <button
        type="button"
        id="NuvelBuyNow-{{ section.id | default: 'home' }}"
        class="nuvel-buybox__buy-now button button--full-width button--outline"
        {% if product.selected_or_first_available_variant.available == false or product.selected_or_first_available_variant == null %}disabled{% endif %}
      >
        <span>{{ 'nuvel.product_page.buy_now_button' | t }}</span>
      </button>
    </div>

    {%- if product.selected_or_first_available_variant.inventory_management == 'shopify' and product.selected_or_first_available_variant.inventory_quantity > 0 -%}
      <p class="nuvel-buybox__inventory" aria-live="polite">
        <span class="svg-wrapper" style="color: rgb(62, 214, 96)">{{ 'icon-inventory-status.svg' | inline_asset_content }}</span>
        <span>{{ 'nuvel.product_page.in_stock' | t }}</span>
      </p>
    {%- endif -%}
  {%- endform -%}

  <div class="nuvel-buybox__benefits" role="list" aria-label="{{ 'nuvel.product_page.benefits_label' | default: 'Beneficios' }}">
    <div class="nuvel-buybox__benefit" role="listitem">
      <span class="nuvel-buybox__benefit-icon" aria-hidden="true">{% render 'icon', icon: 'eye', size: 20 %}</span>
      <span class="nuvel-buybox__benefit-text">{{ 'nuvel.product_page.benefit_1_text' | t }}</span>
    </div>
    <div class="nuvel-buybox__benefit-divider" aria-hidden="true"></div>
    <div class="nuvel-buybox__benefit" role="listitem">
      <span class="nuvel-buybox__benefit-icon" aria-hidden="true">{% render 'icon', icon: 'silhouette', size: 20 %}</span>
      <span class="nuvel-buybox__benefit-text">{{ 'nuvel.product_page.benefit_2_text' | t }}</span>
    </div>
    <div class="nuvel-buybox__benefit-divider" aria-hidden="true"></div>
    <div class="nuvel-buybox__benefit" role="listitem">
      <span class="nuvel-buybox__benefit-icon" aria-hidden="true">{% render 'icon', icon: 'shirt', size: 20 %}</span>
      <span class="nuvel-buybox__benefit-text">{{ 'nuvel.product_page.benefit_3_text' | t }}</span>
    </div>
  </div>

  {%- unless compact -%}
    <div class="nuvel-buybox__accordions">
      <div class="product__accordion accordion" data-accordion>
        <details id="NuvelDetails-sizes-{{ section.id | default: 'home' }}">
          <summary>
            <div class="summary__title">
              {% render 'icon-accordion', icon: 'ruler' %}
              <h2 class="h4 accordion__title">{{ 'nuvel.product_page.accordion_sizes_title' | t }}</h2>
            </div>
            {{ 'icon-caret.svg' | inline_asset_content }}
          </summary>
          <div class="accordion__content rte" id="NuvelProductAccordion-sizes-{{ section.id | default: 'home' }}">
            {{ 'nuvel.product_page.accordion_sizes_content' | t }}
          </div>
        </details>
      </div>

      <div class="product__accordion accordion" data-accordion>
        <details id="NuvelDetails-shipping-{{ section.id | default: 'home' }}">
          <summary>
            <div class="summary__title">
              {% render 'icon-accordion', icon: 'truck' %}
              <h2 class="h4 accordion__title">{{ 'nuvel.product_page.accordion_shipping_title' | t }}</h2>
            </div>
            {{ 'icon-caret.svg' | inline_asset_content }}
          </summary>
          <div class="accordion__content rte" id="NuvelProductAccordion-shipping-{{ section.id | default: 'home' }}">
            <p>{{ 'nuvel.product_page.accordion_shipping_content' | t }}</p>
          </div>
        </details>
      </div>

      <div class="product__accordion accordion" data-accordion>
        <details id="NuvelDetails-nuvel-{{ section.id | default: 'home' }}">
          <summary>
            <div class="summary__title">
              {% render 'icon-accordion', icon: 'shield' %}
              <h2 class="h4 accordion__title">{{ 'nuvel.product_page.accordion_nuvel_title' | t }}</h2>
            </div>
            {{ 'icon-caret.svg' | inline_asset_content }}
          </summary>
          <div class="accordion__content rte" id="NuvelProductAccordion-nuvel-{{ section.id | default: 'home' }}">
            <p>{{ 'nuvel.product_page.accordion_nuvel_content' | t }}</p>
          </div>
        </details>
      </div>
    </div>
  {%- else -%}
    <a href="{{ product.url }}" class="nuvel-buybox__view-details link animate-arrow">
      {{ 'products.product.view_full_details' | t }} {{- 'icon-arrow.svg' | inline_asset_content -}}
    </a>
  {%- endunless -%}
</div>