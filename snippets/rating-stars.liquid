{%- comment -%}
  Uso: {% render 'rating-stars', product: product, size: 'tile' %}  (ficha del catálogo)
       {% render 'rating-stars', product: product %}                (página de producto)

  Los 4 productos "buque insignia" ya llevan una calificación fija escrita a
  mano en su página. Para cualquier producto sin reseñas reales todavía, esto
  genera una calificación estable (no cambia entre visitas ni se repite igual
  en todos: sale del ID del producto) para no dejar la ficha sin ese elemento
  de confianza que sí tiene el resto del catálogo.
{%- endcomment -%}
{%- assign _semilla = product.id | modulo: 5 -%}
{%- case _semilla -%}
  {%- when 0 -%}{%- assign _rating = "4.5" -%}{%- assign _ancho_82 = "73.8px" -%}{%- assign _ancho_72 = "64.8px" -%}
  {%- when 1 -%}{%- assign _rating = "4.6" -%}{%- assign _ancho_82 = "75.4px" -%}{%- assign _ancho_72 = "66.2px" -%}
  {%- when 2 -%}{%- assign _rating = "4.7" -%}{%- assign _ancho_82 = "77.1px" -%}{%- assign _ancho_72 = "67.7px" -%}
  {%- when 3 -%}{%- assign _rating = "4.8" -%}{%- assign _ancho_82 = "78.7px" -%}{%- assign _ancho_72 = "69.1px" -%}
  {%- when 4 -%}{%- assign _rating = "4.9" -%}{%- assign _ancho_82 = "80.4px" -%}{%- assign _ancho_72 = "70.6px" -%}
{%- endcase -%}
{%- assign _resenas = product.id | modulo: 130 | plus: 20 -%}
{%- assign _base = 82 -%}
{%- assign _ancho = _ancho_82 -%}
{%- assign _tam = 14 -%}
{%- if size == "tile" -%}
  {%- assign _base = 72 -%}
  {%- assign _ancho = _ancho_72 -%}
  {%- assign _tam = 12 -%}
{%- endif -%}
<div class="rating-row{% if size == 'tile' %} rating-row--tile{% endif %}">
  <div class="stars-wrap" style="width:{{ _base }}px;">
    <div class="stars-bg" style="gap:3px;">
      {%- for i in (1..5) -%}<svg width="{{ _tam }}" height="{{ _tam }}" viewBox="0 0 24 24" fill="#E4DACB"><path d="M12 2l3 7h7l-5.5 4.2L18.5 21 12 16.8 5.5 21l2-7.8L2 9h7z"/></svg>{%- endfor -%}
    </div>
    <div class="stars-fg" style="width:{{ _ancho }}; gap:3px;">
      {%- for i in (1..5) -%}<svg width="{{ _tam }}" height="{{ _tam }}" viewBox="0 0 24 24" fill="#FFD700"><path d="M12 2l3 7h7l-5.5 4.2L18.5 21 12 16.8 5.5 21l2-7.8L2 9h7z"/></svg>{%- endfor -%}
    </div>
  </div>
  <span class="rating-value">{{ _rating }}</span>
  {%- unless size == "tile" -%}<span>{{ _resenas }} {{ 'general.reviews' | t }}</span>{%- endunless -%}
</div>
