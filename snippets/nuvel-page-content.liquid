{%- comment -%}
  Contenido de respaldo para páginas del admin con el cuerpo vacío.
  Se renderiza desde sections/main-page.liquid SOLO cuando page.content
  está vacío: si el propietario escribe contenido en el administrador,
  ese contenido tiene prioridad automática.
  Textos traducibles en locales bajo nuvel.pages.* (ES/EN + fallback).
{%- endcomment -%}

{%- style -%}
  .nuvel-page h2 {
    margin: 2.4em 0 0.6em;
  }

  .nuvel-page h2 + p,
  .nuvel-page h2 + ul {
    margin-top: 0;
  }

  .nuvel-page ul {
    padding-left: 1.2em;
  }

  .nuvel-page li {
    margin-bottom: 0.5em;
  }

  .nuvel-page__meta {
    font-size: 0.85em;
    color: rgba(var(--color-foreground), 0.6);
    margin: 0.4em 0 2.4em;
  }

  .nuvel-page__callout {
    margin: 0 0 2.4em;
    padding: 1.2em 1.4em;
    background: rgb(var(--color-background));
    border: 0.1rem solid rgba(var(--color-foreground), 0.12);
    border-radius: var(--media-radius, 2px);
  }

  .nuvel-page__callout p {
    margin: 0;
  }

  .nuvel-page__callout p + p {
    margin-top: 0.5em;
  }

  .nuvel-page details {
    border: 0.1rem solid rgba(var(--color-foreground), 0.12);
    border-radius: var(--media-radius, 2px);
    margin-bottom: 0.8rem;
    background: rgb(var(--color-background));
  }

  .nuvel-page summary {
    cursor: pointer;
    padding: 1rem 1.2rem;
    font-weight: 600;
    list-style: none;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .nuvel-page summary::-webkit-details-marker {
    display: none;
  }

  .nuvel-page summary::after {
    content: '+';
    font-size: 1.3em;
    font-weight: 400;
    line-height: 1;
    flex: 0 0 auto;
    color: rgba(var(--color-foreground), 0.55);
  }

  .nuvel-page details[open] summary::after {
    content: '\2212';
  }

  .nuvel-page details > div {
    padding: 0 1.2rem 1.2rem;
  }

  .nuvel-page details > div > p {
    margin: 0;
  }

  .nuvel-page blockquote {
    margin: 1.8em 0;
    padding: 0.2em 0 0.2em 1.2em;
    border-left: 0.2rem solid rgba(var(--color-foreground), 0.25);
    font-style: italic;
  }

  .nuvel-page__closing {
    text-align: center;
    margin: 2.8em 0 0.8em;
    font-size: 1.5em;
    line-height: 1.3;
  }

  .nuvel-page__closing-sub {
    text-align: center;
    font-size: 0.9em;
    color: rgba(var(--color-foreground), 0.7);
    margin: 0 0 1.6em;
  }

  .nuvel-page__closing-cta {
    display: inline-block;
    padding: 0.9em 2em;
    background: rgb(var(--color-foreground));
    color: rgb(var(--color-background));
    border-radius: var(--buttons-radius, 2px);
    text-decoration: none;
    font-weight: 500;
  }

  .nuvel-page__contact {
    margin-top: 2.4em;
    padding: 1em 1.4em;
    border: 0.1rem solid rgba(var(--color-foreground), 0.12);
    border-radius: var(--media-radius, 2px);
    background: rgb(var(--color-background));
  }

  .nuvel-page__more {
    margin-top: 2.4em;
  }
{%- endstyle -%}

