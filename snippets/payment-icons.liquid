<div class="payment-icons-block">
  <p class="payment-icons-block__label">Pago 100% seguro</p>
  <div class="payment-icons-block__row">
    {%- for type in shop.enabled_payment_types -%}
      {{ type | payment_type_svg_tag: class: 'payment-icons-block__icon' }}
    {%- endfor -%}

    {%- comment -%}
      Visa / Mastercard / Amex se procesan vía PayPal Checkout (pago con
      tarjeta sin cuenta PayPal), por eso no están en shop.enabled_payment_types
      pero sí son válidos para mostrar aquí.
    {%- endcomment -%}
    <svg class="payment-icons-block__icon" viewBox="0 0 38 24" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Visa">
      <rect width="38" height="24" rx="4" fill="#1A1F71"/>
      <text x="19" y="16.5" text-anchor="middle" font-family="Arial, Helvetica, sans-serif" font-size="10.5" font-style="italic" font-weight="700" fill="#FFFFFF">VISA</text>
    </svg>

    <svg class="payment-icons-block__icon" viewBox="0 0 38 24" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Mastercard">
      <rect width="38" height="24" rx="4" fill="#F7F7F7"/>
      <circle cx="16" cy="12" r="7" fill="#EB001B"/>
      <circle cx="22" cy="12" r="7" fill="#F79E1B" fill-opacity="0.9"/>
    </svg>

    <svg class="payment-icons-block__icon" viewBox="0 0 38 24" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="American Express">
      <rect width="38" height="24" rx="4" fill="#2E77BC"/>
      <text x="19" y="16" text-anchor="middle" font-family="Arial, Helvetica, sans-serif" font-size="8.5" font-weight="700" fill="#FFFFFF">AMEX</text>
    </svg>
  </div>
  <p class="payment-icons-block__note">Tarjetas procesadas de forma segura a través de PayPal</p>
</div>
