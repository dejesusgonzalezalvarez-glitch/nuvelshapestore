<footer class="site-footer">
  <div class="footer-top">
    <div class="footer-brand">
      <div class="logo">NUVEL</div>
      <p>{{ 'footer.brand_tagline' | t }}</p>
      <p class="footer-guarantee">{{ 'footer.guarantee' | t }}</p>
    </div>
    <div class="footer-cols">
      <div class="footer-col">
        <span class="footer-col-title">{{ 'footer.col_policies' | t }}</span>
        <a href="/pages/envios">{{ 'footer.col_shipping' | t }}</a>
        <a href="/pages/devoluciones">{{ 'footer.col_returns' | t }}</a>
        <a href="/pages/privacidad">{{ 'footer.col_privacy' | t }}</a>
        <a href="/pages/terminos">{{ 'footer.col_terms' | t }}</a>
      </div>
      <div class="footer-col">
        <span class="footer-col-title">{{ 'footer.col_follow_us' | t }}</span>
        <a href="https://www.instagram.com/nuvelshape/" target="_blank" rel="noreferrer">Instagram</a>
      </div>
      <div class="footer-col" style="width:240px;">
        <span class="footer-col-title">{{ 'footer.col_contact' | t }}</span>
        <a href="mailto:hola@nuvelshape.store">hola@nuvelshape.store</a>
      </div>

    </div>
  </div>
  <div class="footer-wordmark" aria-hidden="true">NUVEL</div>
  <div class="footer-bottom">{{ 'footer.copyright' | t }}</div>
</footer>
<div class="cart-overlay" id="cart-overlay"></div>
<aside class="cart-drawer" id="cart-drawer">
  <div class="cart-head">
    <h3>{{ 'cart.heading' | t }}</h3>
    <button class="cart-close" id="cart-close" aria-label="{{ 'cart.close' | t }}">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M18 6L6 18M6 6l12 12"/></svg>
    </button>
  </div>
  <div class="cart-items" id="cart-items"></div>
  <div class="cart-foot" id="cart-foot" style="display:none;">
    <div class="cart-subtotal"><span>{{ 'cart.subtotal' | t }}</span><span id="cart-subtotal-value">0,00 €</span></div>
    <button class="btn btn-dark btn-block" id="checkout-btn">{{ 'cart.checkout' | t }}</button>
  </div>
</aside>
<div class="search-overlay" id="search-overlay">
  <div class="search-box">
    <form id="search-form">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
      <input type="text" id="search-input" placeholder="{{ 'search.placeholder' | t }}" autocomplete="off">
      <button type="button" class="icon-btn" id="search-close" aria-label="{{ 'search.close' | t }}">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M18 6L6 18M6 6l12 12"/></svg>
      </button>
    </form>
    <div id="search-results" class="search-results"></div>
  </div>
</div>
<div class="cart-overlay" id="account-overlay"></div>
<aside class="cart-drawer" id="account-drawer">
  <div class="cart-head">
    <h3>{{ 'account.heading' | t }}</h3>
    <button class="cart-close" id="account-close" aria-label="{{ 'general.close' | t }}">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M18 6L6 18M6 6l12 12"/></svg>
    </button>
  </div>
  <div style="padding:28px; display:flex; flex-direction:column; gap:16px;">
    <p style="font-size:14px; line-height:1.6; color:var(--text-soft);">{{ 'account.no_accounts_yet' | t }}</p>
    <p style="font-size:14px; line-height:1.6; color:var(--text-soft);">{{ 'account.help' | t }}</p>
    <a href="mailto:hola@nuvelshape.store" class="btn btn-outline" style="width:100%;">{{ 'account.write_to_us' | t }}</a>
    <a href="/pages/preguntas-frecuentes" class="btn btn-light" style="width:100%;">{{ 'account.view_faq' | t }}</a>
  </div>
</aside>
<div class="modal-overlay" id="zoom-overlay"></div>
<div class="zoom-box" id="zoom-box" role="dialog" aria-modal="true" aria-label="{{ 'zoom.label' | t }}">
  <button class="cart-close zoom-close" id="zoom-close" aria-label="{{ 'general.close' | t }}">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M18 6L6 18M6 6l12 12"/></svg>
  </button>
  <button type="button" class="gallery-arrow gallery-arrow-left" id="zoom-prev" aria-label="{{ 'gallery.prev' | t }}">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 6l-6 6 6 6"/></svg>
  </button>
  <img id="zoom-img" src="" alt="">
  <button type="button" class="gallery-arrow gallery-arrow-right" id="zoom-next" aria-label="{{ 'gallery.next' | t }}">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg>
  </button>
</div>
<script>
  // Textos que usa assets/cart.js (carrito, buscador, alertas). Viven aqui,
  // traducidos por Shopify segun el idioma del visitante, porque un asset .js
  // no puede pasar por el filtro "t" de Liquid.
  window.__NUVEL_I18N__ = {
    lang: {{ request.locale.iso_code | json }},
    cartEmpty: {{ 'cart_js.empty' | t | json }},
    decrease: {{ 'cart_js.decrease' | t | json }},
    increase: {{ 'cart_js.increase' | t | json }},
    remove: {{ 'cart_js.remove' | t | json }},
    packPrefix: {{ 'cart_js.pack_prefix' | t | json }},
    giftLabel: {{ 'cart_js.gift_label' | t | json }},
    giftRemove: {{ 'cart_js.gift_remove' | t | json }},
    sizeLabel: {{ 'general.size_label' | t | json }},
    alertPackNotReady: {{ 'cart_js.alert_pack_not_ready' | t | json }},
    alertAddFailed: {{ 'cart_js.alert_add_failed' | t | json }},
    alertAddPackFailed: {{ 'cart_js.alert_add_pack_failed' | t | json }},
    bundleSave: {{ 'bundle.save' | t | json }},
    searchEmptyBefore: {{ 'search_js.empty_before' | t | json }},
    searchEmptyAfter: {{ 'search_js.empty_after' | t | json }},
    searchLinkProduct: {{ 'search_js.link_view_product' | t | json }},
    searchLinkFaq: {{ 'search_js.link_check_faq' | t | json }},
    searchIndex: [
      { title: {{ 'search_index.producto.title' | t | json }}, url: "/pages/producto", keywords: {{ 'search_index.producto.keywords' | t | json }} },
      { title: {{ 'search_index.catalogo.title' | t | json }}, url: "/pages/catalogo", keywords: {{ 'search_index.catalogo.keywords' | t | json }} },
      { title: {{ 'search_index.sobre_nosotros.title' | t | json }}, url: "/pages/sobre-nosotros", keywords: {{ 'search_index.sobre_nosotros.keywords' | t | json }} },
      { title: {{ 'search_index.faq.title' | t | json }}, url: "/pages/preguntas-frecuentes", keywords: {{ 'search_index.faq.keywords' | t | json }} },
      { title: {{ 'search_index.size_guide.title' | t | json }}, url: "/pages/preguntas-frecuentes#talla", keywords: {{ 'search_index.size_guide.keywords' | t | json }} },
      { title: {{ 'search_index.envios.title' | t | json }}, url: "/pages/envios", keywords: {{ 'search_index.envios.keywords' | t | json }} },
      { title: {{ 'search_index.devoluciones.title' | t | json }}, url: "/pages/devoluciones", keywords: {{ 'search_index.devoluciones.keywords' | t | json }} },
      { title: {{ 'search_index.privacidad.title' | t | json }}, url: "/pages/privacidad", keywords: {{ 'search_index.privacidad.keywords' | t | json }} },
      { title: {{ 'search_index.terminos.title' | t | json }}, url: "/pages/terminos", keywords: {{ 'search_index.terminos.keywords' | t | json }} }
    ]
  };
</script>
<script>
  // El carrito lee los data-producto-* del <body>. En las paginas que se
  // inyectan por JavaScript esos datos llegan despues, asi que ahi el arranque
  // lo dispara la plantilla; en el resto arranca solo. Nunca dos veces.
  window.__nuvelArrancarCarrito = function () {
    if (window.__nuvelCarritoCargado) return;
    window.__nuvelCarritoCargado = true;
    var s = document.createElement("script");
    s.src = "{{ 'cart.js' | asset_url }}";
    document.body.appendChild(s);
  };
  if (!window.__NUVEL_ESPERA_CONTENIDO__) window.__nuvelArrancarCarrito();
</script>
