<div class="legal-hero">
  <p class="eyebrow" style="color:var(--accent);">{{ 'about.hero_eyebrow' | t }}</p>
  <h1>{{ 'about.hero_title' | t }}</h1>
</div>
<div class="legal-body">
  <div style="height:1px; background:var(--accent); opacity:.3; margin-bottom:60px;"></div>
  <p style="font-size:15px; line-height:1.9; color:#4a4039; margin-bottom:32px;">{{ 'about.p1' | t }}</p>
  <p style="font-size:15px; line-height:1.9; color:#4a4039; margin-bottom:32px;">{{ 'about.p2' | t }}</p>
  <blockquote class="legal-quote">{{ 'about.quote' | t }}</blockquote>
  <p style="font-size:15px; line-height:1.9; color:#4a4039; margin-bottom:32px;">{{ 'about.p3' | t }}</p>
  <p style="font-size:15px; line-height:1.9; color:#4a4039; margin-bottom:32px;">{{ 'about.p4' | t }}</p>
  <div style="height:1px; background:var(--accent); opacity:.3; margin:60px 0;"></div>
  <div class="center">
    <p style="font-family:'Lora',serif; font-size:clamp(1.2rem,2.5vw,1.6rem); margin-bottom:12px;">{{ 'about.closing_line' | t }}</p>
    <p style="font-size:14px; color:var(--text-mute); margin-bottom:28px;">{{ 'footer.guarantee' | t }}</p>
    <a href="/pages/producto" class="btn btn-dark">{{ 'about.closing_cta' | t }}</a>
  </div>
</div>
