      </div>
      <div class="main-shot"><img id="main-shot-img" src="{{ 'corse-negro-frente.jpg' | asset_url }}" srcset="{{ 'med-corse-negro-frente.jpg' | asset_url }} 800w, {{ 'lg-corse-negro-frente.jpg' | asset_url }} 1100w" sizes="(max-width: 600px) 92vw, (max-width: 900px) 90vw, 640px" alt="Corsé Moldeador de Cintura Nuvel, entrenador de cintura con varillas" fetchpriority="high"><button type="button" class="gallery-arrow gallery-arrow-left" id="gallery-prev" aria-label="Foto anterior">
