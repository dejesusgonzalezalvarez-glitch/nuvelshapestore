{%- assign p = all_products['retro-shapewear-top-with-zipper'] -%}
{%- assign socio = all_products['faja-moldeadora-invisible-nuvel'] -%}{%- capture socio_map -%}{%- for v in socio.variants -%}{%- if v.available -%}"{{ v.option2 }}":{{ v.id }},{%- endif -%}{%- endfor -%}{%- endcapture -%}
<script>
  window.__NUVEL_VARIANTES__ = {
    {%- for variant in p.variants -%}
    {{ variant.option1 | append: "_" | append: variant.option2 | json }}: {{ variant.id }}{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  };
</script>

