        <div class="thumb" data-thumb data-full="{{ 'lg-corse-negro-modelo-espalda.jpg' | asset_url }}"><img src="{{ 'mini-corse-negro-modelo-espalda.jpg' | asset_url }}" alt="El corsé Nuvel negro puesto, vista por detrás" width="400" height="533" loading="lazy"></div>
        <div class="thumb" data-thumb data-full="{{ 'lg-corse-beige-frente.jpg' | asset_url }}"><img src="{{ 'mini-corse-beige-frente.jpg' | asset_url }}" alt="El corsé Nuvel beige puesto, vista de frente" width="400" height="600" loading="lazy"></div>
        <div class="thumb" data-thumb data-full="{{ 'lg-corse-beige-espalda.jpg' | asset_url }}"><img src="{{ 'mini-corse-beige-espalda.jpg' | asset_url }}" alt="El corsé Nuvel beige puesto, vista por detrás" width="400" height="600" loading="lazy"></div>
