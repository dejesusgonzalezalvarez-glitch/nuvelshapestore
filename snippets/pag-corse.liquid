        <div class="thumb" data-thumb data-full="{{ 'lg-corse-negro-espalda.jpg' | asset_url }}"><img src="{{ 'mini-corse-negro-espalda.jpg' | asset_url }}" alt="Corsé Moldeador Nuvel en negro, vista por detrás" width="400" height="439" loading="lazy"></div>
