{%- doc -%}
  Renders a product variant picker as buttons, swatches, or dropdowns.

  @param {product} product - The product whose options and selected variant are rendered.
  @param {block} block - The variant-picker block and its picker settings.
  @param {string} product_form_id - The ID of the product form associated with the picker inputs.
  @param {object} [section] - The current product section context, supplied implicitly when rendered from that section and used to namespace picker controls.

  @example
  {% render 'product-variant-picker', product: product, block: block, product_form_id: product_form_id %}
{%- enddoc -%}
{%- unless product.has_only_default_variant -%}
  <variant-selects
    id="variant-selects-{{ section.id }}"
    data-section="{{ section.id }}"
    data-product-handle="{{ product.handle }}"
    data-product-title="{{ product.title | escape }}"
    data-product-id="{{ product.id }}"
    data-currency-code="{{ cart.currency.iso_code }}"
    data-selected-price-amount="{{ product.selected_or_first_available_variant.price | default: 0 | money_amount | escape }}"
    {{ block.shopify_attributes }}
  >
    {%- assign any_hidden_option = false -%}
    {%- for option in product.options_with_values -%}
      {%- liquid
        assign swatch_count = option.values | map: 'swatch' | compact | size
        assign picker_type = block.settings.picker_type

        if swatch_count > 0 and block.settings.swatch_shape != 'none'
          if block.settings.picker_type == 'dropdown'
            assign picker_type = 'swatch_dropdown'
          else
            assign picker_type = 'swatch'
          endif
        endif

        comment
          Oculta opciones sin elección real: un solo valor, o varios valores
          que son lo mismo con sufijo de una letra ("Black A" / "Black").
          El campo se mantiene en el formulario (oculto) para que la
          selección de variantes siga resolviendo combinaciones; el JS
          sincroniza su valor con la opción visible.
        endcomment
        assign hide_option = false
        if option.values.size == 1
          assign hide_option = true
        else
          assign normalized_values = ''
          for option_value in option.values
            assign value_parts = option_value | split: ' '
            assign normalized_value = option_value
            if value_parts.size > 1
              assign last_part = value_parts | last
              assign last_part_up = last_part | upcase
              assign last_part_down = last_part | downcase
              if last_part.size == 1 and last_part_up != last_part_down
                assign normalized_value = ''
                assign part_index = 0
                for value_part in value_parts
                  assign part_index = part_index | plus: 1
                  if part_index < value_parts.size
                    if normalized_value == blank
                      assign normalized_value = value_part
                    else
                      assign normalized_value = normalized_value | append: ' ' | append: value_part
                    endif
                  endif
                endfor
              endif
            endif
            if normalized_values == blank
              assign normalized_values = normalized_value
            else
              assign normalized_values = normalized_values | append: '~' | append: normalized_value
            endif
          endfor
          assign normalized_list = normalized_values | split: '~' | uniq
          if normalized_list.size == 1
            assign hide_option = true
          endif
        endif
        if hide_option
          assign any_hidden_option = true
        endif
      -%}
      {%- if picker_type == 'swatch' -%}
        <fieldset
          class="js product-form__input product-form__input--swatch{% if hide_option %} product-form__input--hidden{% endif %}"
          {% if hide_option %}data-nuvel-hidden-option{% endif %}
        >
          <legend class="form__label">
            {{ option.name }}:
            <span data-selected-value>
              {{- option.selected_value -}}
            </span>
          </legend>
          {% render 'product-variant-options',
            option: option,
            block: block,
            picker_type: picker_type
          %}
        </fieldset>
      {%- elsif picker_type == 'button' -%}
        <fieldset
          class="js product-form__input product-form__input--pill{% if hide_option %} product-form__input--hidden{% endif %}"
          {% if hide_option %}data-nuvel-hidden-option{% endif %}
        >
          <legend class="form__label">{{ option.name }}</legend>
          {% render 'product-variant-options',
            option: option,
            block: block,
            picker_type: picker_type
          %}
        </fieldset>
      {%- else -%}
        <div
          class="product-form__input product-form__input--dropdown{% if hide_option %} product-form__input--hidden{% endif %}"
          {% if hide_option %}data-nuvel-hidden-option{% endif %}
        >
          <label class="form__label" for="Option-{{ section.id }}-{{ forloop.index0 }}">
            {{ option.name }}
          </label>
          <div class="select">
            {%- if picker_type == 'swatch_dropdown' -%}
              <span
                data-selected-value
                class="dropdown-swatch"
              >
                {% render 'swatch', swatch: option.selected_value.swatch, shape: block.settings.swatch_shape %}
              </span>
            {%- endif -%}
            <select
              id="Option-{{ section.id }}-{{ forloop.index0 }}"
              class="select__select"
              name="options[{{ option.name | escape }}]"
              form="{{ product_form_id }}"
            >
              {% render 'product-variant-options',
                option: option,
                block: block,
                picker_type: picker_type
              %}
            </select>
            <span class="svg-wrapper">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}

    {%- if any_hidden_option -%}
      <script type="application/json" data-product-variants>
        {{ product.variants | json }}
      </script>
    {%- endif -%}

    <script type="application/json" data-selected-variant>
      {{ product.selected_or_first_available_variant | json }}
    </script>
  </variant-selects>
{%- endunless -%}
