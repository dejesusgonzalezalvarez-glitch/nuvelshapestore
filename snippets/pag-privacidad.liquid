<div class="legal-hero">
  <p class="eyebrow" style="color:var(--accent);">{{ 'privacy.hero_eyebrow' | t }}</p>
  <h1>{{ 'privacy.hero_title' | t }}</h1>
</div>
<div class="legal-body">
  <div class="legal-section">
    <h2>{{ 'privacy.controller.title' | t }}</h2>
    <p>{{ 'privacy.controller.text' | t }}</p>
    <ul>
      <li><strong>{{ 'privacy.controller.owner_label' | t }}</strong> Jesús González Álvarez</li>
      <li><strong>{{ 'privacy.controller.address_label' | t }}</strong> Los Leones 3050, Lara, Venezuela</li>
      <li><strong>{{ 'privacy.controller.contact_label' | t }}</strong> hola@nuvelshape.store</li>
      <li><strong>{{ 'privacy.controller.platform_label' | t }}</strong> {{ 'privacy.controller.platform_text' | t }}</li>
    </ul>
