<div class="site-header-sticky">
<div class="top-banner">{{ 'banner.free_shipping' | t }}</div>
<header class="site-header">
  <div class="header-bar">
    <div class="mobile-only" style="align-items:center;">
      <button class="icon-btn" id="menu-toggle" aria-label="{{ 'nav.open_menu' | t }}" aria-expanded="false" aria-controls="mobile-menu">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
    </div>
    <a href="/" class="logo mobile-only">NUVEL</a>
    <div class="nav-group desktop-only">
      <button class="icon-btn" data-search-open aria-label="{{ 'nav.search' | t }}">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
      </button>
      <a href="/" class="nav-link">{{ 'nav.home' | t }}</a>
      <a href="/pages/producto" class="nav-link">{{ 'nav.featured_product' | t }}</a>
    </div>
    <a href="/" class="logo desktop-only">NUVEL</a>
    <div class="nav-group right desktop-only">
      <a href="/pages/catalogo" class="nav-link">{{ 'nav.catalog' | t }}</a>
      <a href="/pages/sobre-nosotros" class="nav-link">{{ 'nav.about' | t }}</a>
      <a href="/pages/preguntas-frecuentes" class="nav-link">{{ 'nav.faq' | t }}</a>
      <button class="icon-btn" data-account-open aria-label="{{ 'nav.account' | t }}">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-7 8-7s8 3 8 7"/></svg>
      </button>
      <button class="icon-btn" data-cart-open aria-label="{{ 'nav.open_cart' | t }}">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6 8h12l-1 12H7L6 8z"/><path d="M9 8V6a3 3 0 016 0v2"/></svg>
        <span class="cart-count-badge" data-cart-count style="display:none;">0</span>
      </button>
    </div>
    <div class="header-icons mobile-only">
      <button class="icon-btn" data-search-open aria-label="{{ 'nav.search' | t }}">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
      </button>
      <button class="icon-btn" data-account-open aria-label="{{ 'nav.account' | t }}">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-7 8-7s8 3 8 7"/></svg>
      </button>
      <button class="icon-btn" data-cart-open aria-label="{{ 'nav.open_cart' | t }}">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6 8h12l-1 12H7L6 8z"/><path d="M9 8V6a3 3 0 016 0v2"/></svg>
        <span class="cart-count-badge" data-cart-count style="display:none;">0</span>
      </button>
    </div>
  </div>
  <div class="mobile-menu" id="mobile-menu">
    <a href="/">{{ 'nav.home' | t }}</a>
    <a href="/pages/producto">{{ 'nav.featured_product' | t }}</a>
    <a href="/pages/catalogo">{{ 'nav.catalog' | t }}</a>
    <a href="/pages/sobre-nosotros">{{ 'nav.about' | t }}</a>
    <a href="/pages/preguntas-frecuentes">{{ 'nav.faq' | t }}</a>
  </div>
</header>
</div>
