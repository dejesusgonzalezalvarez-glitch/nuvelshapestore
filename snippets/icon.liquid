{%- doc -%}
  Renders an SVG icon from the theme's icon assets safely.

  @param {string} icon - The icon name. Underscores are converted to hyphens to form the asset name; `none` or unknown icons render nothing.
  @param {number|string} size - Optional CSS size for the icon (default 20).

  @example
  {% render 'icon', icon: 'truck', size: 18 %}
{%- enddoc -%}
{%- assign icon_name = icon | default: '' | replace: '_', '-' | downcase -%}
{%- assign size_val = size | default: 20 -%}

{%- assign available_icons = '3d-model,account,apple,arrow,banana,bottle,box,caret,carrot,cart,cart-empty,chat-bubble,check-mark,checkmark,clipboard,close,close-small,copy,dairy,dairy-free,disclosure-info,discount,dryer,error,eye,facebook,filter,fire,gluten-free,hamburger,heart,info,instagram,inventory-status,iron,leaf,leather,lightning-bolt,lipstick,lock,map-pin,minus,nut-free,padlock,pants,pause,paw-print,pepper,perfume,pinterest,plane,plant,play,plus,price-tag,question-mark,recycle,remove,reset,return,ruler,search,serving-dish,share,shirt,shoe,shopify,silhouette,snapchat,snowflake,star,stopwatch,success,tick,tiktok,truck,tumblr,twitter,unavailable,vimeo,warning,washing,youtube,zoom | split: ',' -%}

{%- if icon_name != blank and icon_name != 'none' and available_icons contains icon_name -%}
  {%- assign file = 'icon-' | append: icon_name | append: '.svg' -%}
  <span class="nuvel-icon nuvel-icon--{{ icon_name }}" style="width: {{ size_val }}px; height: {{ size_val }}px; display: inline-block; vertical-align: middle;">
    {{ file | inline_asset_content }}
  </span>
{%- endif -%}