{%- liquid
  assign pack_duo = all_products['pack-duo-fajas-nuvel']
  assign pack_completo = all_products['pack-completo-nuvel']

  assign pack_duo_visible = false
  assign pack_completo_visible = false
  if pack_duo != blank and pack_duo.published
    assign pack_duo_visible = true
  endif
  if pack_completo != blank and pack_completo.published
    assign pack_completo_visible = true
  endif

  assign any_pack_visible = pack_duo_visible or pack_completo_visible
-%}

{%- if any_pack_visible -%}
  {%- style -%}
    .nuvel-packs {
      margin-top: 1.25rem;
      border: 1px solid rgba(var(--color-foreground), 0.15);
      border-radius: var(--media-radius, 2px);
      background: var(--color-background);
      overflow: hidden;
    }
    .nuvel-packs__header {
      padding: 1rem 1rem 0.5rem;
      border-bottom: 1px solid rgba(var(--color-foreground), 0.1);
    }
    .nuvel-packs__title {
      margin: 0 0 0.25rem;
      font-size: 1.1rem;
      font-weight: 600;
      color: rgb(26, 26, 26);
    }
    .nuvel-packs__list {
      display: flex;
      flex-direction: column;
      gap: 0;
      padding: 0.5rem 1rem 1rem;
    }
    .nuvel-packs__card {
      display: flex;
      flex-direction: column;
      border-bottom: 1px solid rgba(var(--color-foreground), 0.08);
      padding: 0.75rem 1rem;
      text-decoration: none;
      color: inherit;
      transition: background 0.15s ease;
    }
    .nuvel-packs__card:last-child {
      border-bottom: none;
    }
    .nuvel-packs__card:hover {
      background: rgba(var(--color-foreground), 0.03);
    }
    .nuvel-packs__card-body {
      display: flex;
      gap: 0.75rem;
      align-items: flex-start;
    }
    .nuvel-packs__thumb {
      width: 64px;
      height: 64px;
      flex-shrink: 0;
      border-radius: var(--media-radius, 2px);
      overflow: hidden;
      background: rgba(var(--color-foreground), 0.06);
    }
    .nuvel-packs__thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    .nuvel-packs__info {
      flex: 1;
      min-width: 0;
    }
    .nuvel-packs__name {
      margin: 0 0 0.2rem;
      font-size: 0.95rem;
      font-weight: 600;
      color: rgb(26, 26, 26);
    }
    .nuvel-packs__includes {
      margin: 0 0 0.5rem;
      font-size: 0.8rem;
      line-height: 1.4;
      color: rgba(var(--color-foreground), 0.65);
    }
    .nuvel-packs__prices {
      display: flex;
      align-items: baseline;
      gap: 0.5rem;
      margin-bottom: 0.6rem;
    }
    .nuvel-packs__price {
      font-size: 1.15rem;
      font-weight: 700;
      color: rgb(26, 26, 26);
    }
    .nuvel-packs__compare {
      font-size: 0.85rem;
      text-decoration: line-through;
      color: rgba(var(--color-foreground), 0.5);
    }
    .nuvel-packs__savings {
      font-size: 0.85rem;
      font-weight: 600;
      color: rgb(138, 111, 74);
    }
    .nuvel-packs__btn {
      display: block;
      width: 100%;
      padding: 0.6rem 0.9rem;
      border: 1px solid rgb(26, 26, 26);
      border-radius: var(--media-radius, 2px);
      background: rgb(26, 26, 26);
      color: #fff;
      font-size: 0.85rem;
      font-weight: 600;
      text-align: center;
      text-decoration: none;
      margin-top: auto;
      transition: opacity 0.15s ease;
    }
    .nuvel-packs__btn:hover {
      opacity: 0.85;
    }
    @media screen and (min-width: 750px) {
      .nuvel-packs__thumb {
        width: 80px;
        height: 80px;
      }
    }
  {%- endstyle -%}

  <div class="nuvel-packs" data-nuvel-packs>
    <div class="nuvel-packs__header">
      <h3 class="nuvel-packs__title">{{ 'nuvel.packs.title' | t }}</h3>
    </div>
    <div class="nuvel-packs__list" data-nuvel-packs-list>
      {%- if pack_duo_visible -%}
          {%- liquid
            assign p = pack_duo
            assign img = p.featured_media | default: null
            assign img_url = blank
            if img != blank
              assign img_url = img.preview_image.src | image_url: width: 240
            endif
            {%- if p.compare_at_price != blank -%}
              {%- assign ahorro = p.compare_at_price | minus: p.price -%}
            {%- endif -%}
          -%}
        <a href="{{ p.url }}" class="nuvel-packs__card" aria-label="{{ 'nuvel.packs.ver_pack' | t: pack: p.title | escape }}">
          <div class="nuvel-packs__card-body">
            <div class="nuvel-packs__thumb">
              {%- if img_url -%}
                <img src="{{ img_url }}" alt="{{ p.title | escape }}" loading="lazy" width="240" height="240">
              {%- else -%}
                <span class="visually-hidden">{{ p.title | escape }}</span>
              {%- endif -%}
            </div>
            <div class="nuvel-packs__info">
              <h4 class="nuvel-packs__name">{{ p.title | escape }}</h4>
              <p class="nuvel-packs__includes">{{ 'nuvel.packs.duo_incluye' | t }}</p>
              <div class="nuvel-packs__prices">
                <span class="nuvel-packs__price">{{ p.price | money }}</span>
                {%- if p.compare_at_price > p.price -%}
                  <span class="nuvel-packs__compare">{{ p.compare_at_price | money }}</span>
                  <span class="nuvel-packs__savings">{{ 'nuvel.packs.ahorras' | t: amount: ahorro | money }}</span>
                {%- endif -%}
              </div>
            </div>
          </div>
          <span class="nuvel-packs__btn">{{ 'nuvel.packs.ver_pack' | t }}</span>
        </a>
      {%- endif -%}

      {%- if pack_completo_visible -%}
        {%- liquid
          assign p = pack_completo
          assign img = p.featured_media | default: null
          assign img_url = blank
          if img != blank
            assign img_url = img.preview_image.src | image_url: width: 240
          endif
          {%- if p.compare_at_price != blank -%}
            {%- assign ahorro = p.compare_at_price | minus: p.price -%}
          {%- endif -%}
        -%}
        <a href="{{ p.url }}" class="nuvel-packs__card" aria-label="{{ 'nuvel.packs.ver_pack' | t: pack: p.title | escape }}">
          <div class="nuvel-packs__card-body">
            <div class="nuvel-packs__thumb">
              {%- if img_url -%}
                <img src="{{ img_url }}" alt="{{ p.title | escape }}" loading="lazy" width="240" height="240">
              {%- else -%}
                <span class="visually-hidden">{{ p.title | escape }}</span>
              {%- endif -%}
            </div>
            <div class="nuvel-packs__info">
              <h4 class="nuvel-packs__name">{{ p.title | escape }}</h4>
              <p class="nuvel-packs__includes">{{ 'nuvel.packs.completo_incluye' | t }}</p>
              <div class="nuvel-packs__prices">
                <span class="nuvel-packs__price">{{ p.price | money }}</span>
                {%- if p.compare_at_price > p.price -%}
                  <span class="nuvel-packs__compare">{{ p.compare_at_price | money }}</span>
                  <span class="nuvel-packs__savings">{{ 'nuvel.packs.ahorras' | t: amount: ahorro | money }}</span>
                {%- endif -%}
              </div>
            </div>
          </div>
          <span class="nuvel-packs__btn">{{ 'nuvel.packs.ver_pack' | t }}</span>
        </a>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Packs Nuvel",
  "tag": "section",
  "class": "spaced-section",
  "settings": [],
  "presets": [
    {
      "name": "Packs Nuvel"
    }
  ]
}
{% endschema %}
