{%- liquid
  assign show_pack_prices = true
  if block.settings.show_pack_prices == false
    assign show_pack_prices = false
  endif

  assign faja_handle = 'faja-moldeadora-invisible-nuvel'
  assign body_handle = 'womens-shapewear-dress-jumpsuit'
  assign bragas_handle = 'seamless-shapewear-panties'

  assign faja_product = all_products[faja_handle]
  assign body_product = all_products[body_handle]
  assign bragas_product = all_products[bragas_handle]

  assign current_variant = product.selected_or_first_available_variant
  assign base_price_cents = current_variant.price
  assign base_price = current_variant.price | money
  assign base_compare_at = current_variant.compare_at_price | money

  assign faja_variant = blank
  assign body_variant = blank
  assign bragas_variant = blank

  if faja_product != blank
    assign faja_variant = faja_product.variants | where: 'option1', current_variant.option1 | first
  endif
  if body_product != blank
    assign body_variant = body_product.variants | where: 'option1', current_variant.option1 | first
  endif
  if bragas_product != blank
    assign bragas_variant = bragas_product.variants | where: 'option1', current_variant.option1 | first
  endif

  assign duo_price_cents = current_variant.price | times: 1.5
  assign duo_price = duo_price_cents | money
  assign duo_compare_at = current_variant.price | times: 2 | money

  assign kit_price = 6490 | money

  assign kit_compare_at = 0
  if faja_product != blank and body_product != blank and bragas_product != blank
    assign faja_first_price = faja_product.variants.first.price
    assign body_first_price = body_product.variants.first.price
    assign bragas_first_price = bragas_product.variants.first.price
    assign kit_compare_at = faja_first_price | plus: body_first_price | plus: bragas_first_price | money
  else
    assign kit_compare_at = 8480 | money
  endif

  assign faja_variant_id = faja_variant.id | default: current_variant.id
  assign body_variant_id = body_variant.id | default: 0
  assign bragas_variant_id = bragas_variant.id | default: 0
-%}

<div class="nuvel-packs" data-nuvel-packs data-section-id="{{ section_id }}" data-base-price="{{ current_variant.price }}">
  <h3 class="nuvel-packs__title">{{ 'nuvel.product_page.packs_title' | t }}</h3>
  <div class="nuvel-packs__list" role="radiogroup" aria-label="{{ 'nuvel.product_page.packs_title' | t }}">

    {%- comment -%}Pack 1: Solo una faja{%- endcomment -%}
    <label class="nuvel-packs__card{% unless show_pack_prices %} nuvel-packs__card--no-prices{% endunless %}" data-pack="solo">
      <input
        type="radio"
        name="nuvel-pack"
        value="solo"
        class="nuvel-packs__radio"
        aria-label="{{ 'nuvel.product_page.pack_solo_title' | t }}"
      >
      <span class="nuvel-packs__radio-visual" aria-hidden="true"></span>
      <div class="nuvel-packs__card-body">
        <div class="nuvel-packs__thumb">
          {%- if product.featured_media -%}
            {{ product.featured_media | image_tag: width: 64, height: 48, loading: 'lazy', alt: product.title | escape }}
          {%- else -%}
            <span class="visually-hidden">{{ 'nuvel.product_page.pack_solo_title' | t }}</span>
          {%- endif -%}
        </div>
        <div class="nuvel-packs__info">
          <h4 class="nuvel-packs__name">{{ 'nuvel.product_page.pack_solo_title' | t }}</h4>
          <p class="nuvel-packs__includes">{{ 'nuvel.product_page.pack_solo_subtitle' | t }}</p>
          {%- if show_pack_prices -%}
            <div class="nuvel-packs__prices">
              <span class="nuvel-packs__price">{{ base_price }}</span>
            </div>
          {%- endif -%}
        </div>
      </div>
    </label>

    {%- comment -%}Pack 2: 2ª unidad al 50% (default selected){%- endcomment -%}
    <label class="nuvel-packs__card is-selected{% unless show_pack_prices %} nuvel-packs__card--no-prices{% endunless %}" data-pack="duo">
      <input
        type="radio"
        name="nuvel-pack"
        value="duo"
        class="nuvel-packs__radio"
        checked
        aria-label="{{ 'nuvel.product_page.pack_duo_title' | t }}"
      >
      <span class="nuvel-packs__radio-visual" aria-hidden="true"></span>
      <div class="nuvel-packs__card-body">
        <div class="nuvel-packs__thumb">
          {%- if product.featured_media -%}
            {{ product.featured_media | image_tag: width: 64, height: 48, loading: 'lazy', alt: product.title | escape }}
          {%- else -%}
            <span class="visually-hidden">{{ 'nuvel.product_page.pack_duo_title' | t }}</span>
          {%- endif -%}
        </div>
        <div class="nuvel-packs__info">
          <div class="nuvel-packs__name-row">
            <h4 class="nuvel-packs__name">{{ 'nuvel.product_page.pack_duo_title' | t }}</h4>
            <span class="nuvel-packs__badge">{{ 'nuvel.product_page.pack_duo_badge' | t }}</span>
          </div>
          <p class="nuvel-packs__includes">{{ 'nuvel.product_page.pack_duo_subtitle' | t }}</p>
          {%- if show_pack_prices -%}
            <div class="nuvel-packs__prices">
              <span class="nuvel-packs__price">{{ duo_price }}</span>
              <span class="nuvel-packs__compare">{{ duo_compare_at }}</span>
            </div>
          {%- endif -%}
        </div>
      </div>
    </label>

    {%- comment -%}Pack 3: Kit del Vestido Perfecto{%- endcomment -%}
    <label class="nuvel-packs__card{% unless show_pack_prices %} nuvel-packs__card--no-prices{% endunless %}" data-pack="kit">
      <input
        type="radio"
        name="nuvel-pack"
        value="kit"
        class="nuvel-packs__radio"
        aria-label="{{ 'nuvel.product_page.pack_kit_title' | t }}"
      >
      <span class="nuvel-packs__radio-visual" aria-hidden="true"></span>
      <div class="nuvel-packs__card-body">
        <div class="nuvel-packs__thumb">
          {%- if body_product != blank and body_product.featured_media -%}
            {{ body_product.featured_media | image_tag: width: 64, height: 48, loading: 'lazy', alt: body_product.title | escape }}
          {%- else -%}
            <span class="visually-hidden">{{ 'nuvel.product_page.pack_kit_title' | t }}</span>
          {%- endif -%}
        </div>
        <div class="nuvel-packs__info">
          <h4 class="nuvel-packs__name">{{ 'nuvel.product_page.pack_kit_title' | t }}</h4>
          <p class="nuvel-packs__includes">{{ 'nuvel.product_page.pack_kit_subtitle' | t }}</p>
          {%- if show_pack_prices -%}
            <div class="nuvel-packs__prices">
              <span class="nuvel-packs__price">{{ kit_price }}</span>
              <span class="nuvel-packs__compare">{{ kit_compare_at }}</span>
            </div>
          {%- endif -%}
        </div>
      </div>
    </label>

  </div>

  <script type="application/json" data-nuvel-pack-data>
    {
      "solo": {
        "items": [{ "variant_id": {{ current_variant.id }}, "quantity": 1 }],
        "properties": { "_pack": "solo" }
      },
      "duo": {
        "items": [{ "variant_id": {{ current_variant.id }}, "quantity": 2 }],
        "properties": { "_pack": "duo" }
      },
      "kit": {
        "items": [
          { "variant_id": {{ current_variant.id }}, "quantity": 1 },
          { "variant_id": {{ body_variant_id }}, "quantity": 1 },
          { "variant_id": {{ bragas_variant_id }}, "quantity": 1 }
        ],
        "properties": { "_pack": "kit" }
      }
    }
  </script>
</div>