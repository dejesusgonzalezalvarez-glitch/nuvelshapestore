{%- comment -%}
  Galería propia de Nuvel: imágenes de marca del tema (assets) en lugar de
  la multimedia del producto del admin (imágenes del proveedor).
  Cada producto Nuvel tiene su propio set de imágenes, replicando el orden
  de la página original: main-product/featured-product pasan `product` y
  solo renderizan este snippet cuando el handle está mapeado.
  Alt texts por producto en locales (nuvel.gallery.*).

  ESTRUCTURA DE ESTE SNIPPET:
  Carrusel con imagen principal (4/5, cover, center top), miniaturas
  cuadradas de 72px con scroll horizontal, flechas y swipe. La sección
  "Cómo funciona" vive en sections/nuvel-features.liquid y se coloca
  justo debajo de esta galería.
  Robustez: onerror en todas las <img> que oculta el texto alt y deja un
  placeholder gris (.nuvel-img-broken).
{%- endcomment -%}

{%- liquid
  case product.handle
    when 'faja-moldeadora-invisible-nuvel'
      assign gallery_handles = 'avatar-vestida,detalle-tela,producto-frente,producto-espalda,producto-detalle,avatar-athleisure' | split: ','
      assign alt_prefix = 'nuvel.gallery.alt_'
      assign main_handle = 'avatar-vestida'
      assign main_alt_key = 'nuvel.gallery.main_alt'
    when 'retro-shapewear-top-with-zipper'
      assign gallery_handles = 'corse-negro-frente,corse-negro-espalda,corse-tallas,corse-negro-modelo,corse-negro-modelo-espalda,corse-beige-frente,corse-beige-espalda,corse-rosa-modelo,corse-rosa-modelo-espalda' | split: ','
      assign alt_prefix = 'nuvel.gallery.corse_alt_'
      assign main_handle = 'corse-negro-frente'
      assign main_alt_key = 'nuvel.gallery.corse_main_alt'
    when 'womens-shapewear-dress-jumpsuit'
      assign gallery_handles = 'vestido-negro-frente,vestido-negro-espalda,vestido-tallas,vestido-ugc-negro,vestido-gris-frente,vestido-gris-espalda,vestido-ugc-gris' | split: ','
      assign alt_prefix = 'nuvel.gallery.vestido_alt_'
      assign main_handle = 'vestido-negro-frente'
      assign main_alt_key = 'nuvel.gallery.vestido_main_alt'
    when 'seamless-shapewear-panties'
      assign gallery_handles = 'short-negro-frente,short-negro-espalda,short-tallas,short-ugc-negro,short-beige-frente,short-beige-espalda,short-ugc-beige' | split: ','
      assign alt_prefix = 'nuvel.gallery.short_alt_'
      assign main_handle = 'short-negro-frente'
      assign main_alt_key = 'nuvel.gallery.short_main_alt'
  endcase
-%}

{%- if gallery_handles != blank -%}
  {%- style -%}
    .nuvel-media {
      display: block;
    }

    /* ---------- BLOQUE 1 · CARRUSEL ---------- */
    .nuvel-gallery__main {
      position: relative;
      margin: 0;
    }

    .nuvel-gallery__main img {
      display: block;
      width: 100%;
      height: auto;
      aspect-ratio: 4 / 5;
      object-fit: cover;
      object-position: center top;
      border-radius: var(--media-radius, 2px);
      background-color: #f4f4f4;
    }

    .nuvel-gallery__arrow {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      display: flex;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
      padding: 0;
      border: 0;
      border-radius: 50%;
      background-color: rgba(255, 255, 255, 0.9);
      color: #000000;
      cursor: pointer;
      z-index: 2;
    }

    .nuvel-gallery__arrow--prev {
      left: 8px;
    }

    .nuvel-gallery__arrow--next {
      right: 8px;
    }

    .nuvel-gallery__arrow svg {
      display: block;
      width: 14px;
      height: 14px;
    }

    .nuvel-gallery__arrow:hover {
      background-color: #ffffff;
    }

    .nuvel-gallery__arrow:focus-visible {
      outline: 0.2rem solid #000000;
      outline-offset: 0.2rem;
    }

    @media screen and (min-width: 750px) {
      .nuvel-gallery__arrow {
        width: 44px;
        height: 44px;
      }
    }

    .nuvel-gallery__thumbs {
      display: flex;
      justify-content: flex-start;
      gap: 8px;
      margin-top: 0.8rem;
      padding-bottom: 0.4rem;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
    }

    .nuvel-gallery__thumb {
      flex: 0 0 auto;
      width: 72px;
      padding: 0;
      border: 2px solid transparent;
      border-radius: var(--media-radius, 2px);
      background: none;
      cursor: pointer;
      overflow: hidden;
      scroll-snap-align: start;
      opacity: 0.7;
      transition: opacity 0.2s ease-in-out;
    }

    .nuvel-gallery__thumb.is-active {
      border-color: #000000;
      opacity: 1;
    }

    .nuvel-gallery__thumb img {
      display: block;
      width: 100%;
      aspect-ratio: 1 / 1;
      object-fit: cover;
      object-position: center;
      background-color: #f4f4f4;
    }

    .nuvel-gallery__thumb:focus-visible {
      outline: 0.2rem solid #000000;
      outline-offset: 0.2rem;
    }

    /* ---------- PLACEHOLDER PARA IMÁGENES ROTAS ---------- */
    /* Nunca se ve el texto alt: caja gris del mismo tamaño. */
    .nuvel-media img.nuvel-img-broken {
      font-size: 0;
      color: transparent;
      background-color: #f4f4f4;
    }
  {%- endstyle -%}

  <div class="nuvel-media" data-nuvel-gallery-{{ section.id }}>
    <div class="nuvel-gallery">
      <figure class="nuvel-gallery__main" data-nuvel-gallery-swipe>
        <img
          data-nuvel-gallery-main
          src="{{ main_handle | append: '.jpg' | asset_url }}"
          srcset="{{ 'med-' | append: main_handle | append: '.jpg' | asset_url }} 800w, {{ 'lg-' | append: main_handle | append: '.jpg' | asset_url }} 1100w"
          sizes="(min-width: 990px) 550px, (min-width: 750px) 420px, 100vw"
          width="1100"
          height="1467"
          alt="{{ main_alt_key | t }}"
          loading="eager"
          fetchpriority="high"
          onerror="this.classList.add('nuvel-img-broken')"
        >
        <button
          type="button"
          class="nuvel-gallery__arrow nuvel-gallery__arrow--prev"
          data-nuvel-gallery-arrow
          data-nuvel-gallery-direction="-1"
          aria-label="{{ 'general.slider.previous_slide' | t }}"
        >
          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
            <path d="M13 4 7 10l6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </button>
        <button
          type="button"
          class="nuvel-gallery__arrow nuvel-gallery__arrow--next"
          data-nuvel-gallery-arrow
          data-nuvel-gallery-direction="1"
          aria-label="{{ 'general.slider.next_slide' | t }}"
        >
          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
            <path d="M7 4l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </button>
      </figure>

      <div class="nuvel-gallery__thumbs">
        {%- for handle in gallery_handles -%}
          {%- capture alt_key %}{{ alt_prefix }}{{ forloop.index }}{% endcapture -%}
          {%- capture mini_src %}mini-{{ handle }}.jpg{% endcapture -%}
          {%- capture med_src %}med-{{ handle }}.jpg{% endcapture -%}
          {%- capture full_src %}lg-{{ handle }}.jpg{% endcapture -%}
          <button
            type="button"
            class="nuvel-gallery__thumb{% if forloop.first %} is-active{% endif %}"
            data-nuvel-gallery-thumb
            data-src="{{ full_src | asset_url }}"
            data-srcset="{{ med_src | asset_url }} 800w, {{ full_src | asset_url }} 1100w"
            aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
            aria-label="{{ alt_key | t }}"
          >
            <img
              src="{{ mini_src | asset_url }}"
              width="400"
              height="400"
              alt="{{ alt_key | t }}"
              loading="lazy"
              decoding="async"
              onerror="this.closest('[data-nuvel-gallery-thumb]').style.display='none'"
            >
          </button>
        {%- endfor -%}
      </div>
    </div>

  </div>

  <script>
    (function () {
      'use strict';
      var root = document.querySelector('[data-nuvel-gallery-{{ section.id }}]');
      if (!root || root.dataset.init) return;
      root.dataset.init = '1';

      /* ---------- BLOQUE 1 · Carrusel ---------- */
      var main = root.querySelector('[data-nuvel-gallery-main]');
      var thumbs = root.querySelectorAll('[data-nuvel-gallery-thumb]');
      var swipeArea = root.querySelector('[data-nuvel-gallery-swipe]');

      if (main && thumbs.length) {
        var current = 0;
        for (var i = 0; i < thumbs.length; i++) {
          if (thumbs[i].style.display !== 'none') {
            current = i;
            break;
          }
        }

        function show(index) {
          var thumb = thumbs[index];
          if (!thumb || thumb.style.display === 'none') return;
          current = index;
          main.classList.remove('nuvel-img-broken');
          if (main.src !== thumb.dataset.src) {
            main.src = thumb.dataset.src;
            if (thumb.dataset.srcset) {
              main.srcset = thumb.dataset.srcset;
            } else {
              main.removeAttribute('srcset');
            }
          }
          var thumbImg = thumb.querySelector('img');
          if (thumbImg) main.alt = thumbImg.alt;
          for (var i = 0; i < thumbs.length; i++) {
            thumbs[i].classList.toggle('is-active', i === index);
            thumbs[i].setAttribute('aria-current', i === index ? 'true' : 'false');
          }
          thumb.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'nearest' });
        }

        function step(delta) {
          var next = current;
          var dir = delta > 0 ? 1 : -1;
          for (var n = 0; n < thumbs.length; n++) {
            next = (next + dir + thumbs.length) % thumbs.length;
            if (thumbs[next].style.display !== 'none') {
              show(next);
              return;
            }
          }
        }

        root.addEventListener('click', function (event) {
          var thumb = event.target.closest('[data-nuvel-gallery-thumb]');
          if (thumb) {
            show(Array.prototype.indexOf.call(thumbs, thumb));
            return;
          }
          var arrow = event.target.closest('[data-nuvel-gallery-arrow]');
          if (arrow) {
            var delta = parseInt(arrow.getAttribute('data-nuvel-gallery-direction'), 10) || 1;
            step(delta);
          }
        });

        /* Swipe en móvil: solo si el gesto es claramente horizontal. */
        if (swipeArea) {
          var touchX = null;
          var touchY = null;
          swipeArea.addEventListener(
            'touchstart',
            function (event) {
              if (event.touches.length !== 1) {
                touchX = null;
                return;
              }
              touchX = event.touches[0].clientX;
              touchY = event.touches[0].clientY;
            },
            { passive: true }
          );
          swipeArea.addEventListener(
            'touchend',
            function (event) {
              if (touchX === null) return;
              var deltaX = touchX - event.changedTouches[0].clientX;
              var deltaY = touchY - event.changedTouches[0].clientY;
              touchX = null;
              touchY = null;
              if (Math.abs(deltaX) > 40 && Math.abs(deltaX) > Math.abs(deltaY)) {
                step(deltaX > 0 ? 1 : -1);
              }
            },
            { passive: true }
          );
        }
      }

    })();
  </script>
{%- endif -%}
