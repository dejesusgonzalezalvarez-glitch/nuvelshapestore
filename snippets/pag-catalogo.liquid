    <a class="product-tile" href="/pages/vestido" data-price="59.90" data-cats="sin-costuras sets" data-talla="S M L XL 2XL 3XL" data-color="negro gris" data-zona="cuerpo" data-compresion="media">
      <div class="shot">
        <img src="{{ 'med-vestido-negro-frente.jpg' | asset_url }}" srcset="{{ 'mini-vestido-negro-frente.jpg' | asset_url }} 400w, {{ 'med-vestido-negro-frente.jpg' | asset_url }} 800w, {{ 'lg-vestido-negro-frente.jpg' | asset_url }} 1100w" sizes="(max-width: 600px) 46vw, (max-width: 900px) 30vw, 22vw" alt="{{ 'tile.vestido.image_alt' | t }}" loading="lazy">
