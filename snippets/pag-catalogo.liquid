
<main class="wrap">
  <div class="breadcrumb">{{ 'nav.home' | t }} / <span class="current">{{ 'catalog.crumb_current' | t }}</span></div>
  <h1 style="font-size:38px; margin-top:14px;">{{ 'catalog.title' | t }}</h1>
  <p style="max-width:640px; color:var(--text-soft); font-size:15px; line-height:1.7; margin-top:12px;">{{ 'catalog.intro' | t }}</p>

  <div class="cat-categories">
    <button type="button" class="cat-circle" data-cat="cintura-alta"><div class="circle"></div><span>{{ 'catalog.category_high_waist' | t }}</span></button>
    <button type="button" class="cat-circle" data-cat="posparto"><div class="circle" style="background:linear-gradient(135deg,#D9BEA6,#C9A87C);"></div><span>{{ 'catalog.category_postpartum' | t }}</span></button>
    <button type="button" class="cat-circle" data-cat="sin-costuras"><div class="circle"></div><span>{{ 'catalog.category_seamless' | t }}</span></button>
    <button type="button" class="cat-circle" data-cat="sets"><div class="circle" style="background:linear-gradient(135deg,#D9BEA6,#C9A87C);"></div><span>{{ 'catalog.category_full_body' | t }}</span></button>
    <button type="button" class="cat-circle" data-cat="postura"><div class="circle"></div><span>{{ 'catalog.category_posture' | t }}</span></button>
  </div>

  <div class="filter-row">
    <div style="display:flex; gap:12px; flex-wrap:wrap; position:relative;">
      <div class="filter-chip-wrap">
        <button type="button" class="chip" data-filter-toggle="talla">{{ 'catalog.filter_size' | t }}</button>
        <div class="filter-dropdown" data-filter-panel="talla">
          <button type="button" data-filter-key="talla" data-filter-value="S">S</button>
          <button type="button" data-filter-key="talla" data-filter-value="M">M</button>
          <button type="button" data-filter-key="talla" data-filter-value="L">L</button>
          <button type="button" data-filter-key="talla" data-filter-value="XL">XL</button>
        </div>
      </div>
      <div class="filter-chip-wrap">
        <button type="button" class="chip" data-filter-toggle="precio">{{ 'catalog.filter_price' | t }}</button>
        <div class="filter-dropdown" data-filter-panel="precio">
          <button type="button" data-filter-key="precio" data-filter-value="menos-50">{{ 'catalog.filter_price_under_50' | t }}</button>
          <button type="button" data-filter-key="precio" data-filter-value="50-100">{{ 'catalog.filter_price_50_100' | t }}</button>
        </div>
      </div>
      <div class="filter-chip-wrap">
        <button type="button" class="chip" data-filter-toggle="zona">{{ 'catalog.filter_zone' | t }}</button>
        <div class="filter-dropdown" data-filter-panel="zona">
          <button type="button" data-filter-key="zona" data-filter-value="abdomen">{{ 'catalog.filter_zone_abdomen' | t }}</button>
          <button type="button" data-filter-key="zona" data-filter-value="piernas">{{ 'catalog.filter_zone_legs' | t }}</button>
          <button type="button" data-filter-key="zona" data-filter-value="torso">{{ 'catalog.filter_zone_torso_soon' | t }}</button>
          <button type="button" data-filter-key="zona" data-filter-value="cuerpo">{{ 'catalog.filter_zone_full_body' | t }}</button>
          <button type="button" data-filter-key="zona" data-filter-value="espalda">{{ 'catalog.filter_zone_back' | t }}</button>
        </div>
      </div>
      <div class="filter-chip-wrap">
        <button type="button" class="chip" data-filter-toggle="compresion">{{ 'catalog.filter_compression' | t }}</button>
        <div class="filter-dropdown" data-filter-panel="compresion">
          <button type="button" data-filter-key="compresion" data-filter-value="media">{{ 'catalog.filter_compression_medium' | t }}</button>
          <button type="button" data-filter-key="compresion" data-filter-value="alta">{{ 'catalog.filter_compression_high_soon' | t }}</button>
        </div>
      </div>
      <button type="button" class="chip" id="filters-clear" style="display:none; border-style:dashed;">{{ 'catalog.filter_clear' | t }} ✕</button>
    </div>
    <div class="filter-chip-wrap">
      <button type="button" class="chip" data-filter-toggle="sort">{{ 'catalog.sort_by' | t }}</button>
      <div class="filter-dropdown" data-filter-panel="sort">
        <button type="button" class="active" data-sort="relevancia">{{ 'catalog.sort_relevance' | t }}</button>
        <button type="button" data-sort="precio-asc">{{ 'catalog.sort_price_asc' | t }}</button>
        <button type="button" data-sort="precio-desc">{{ 'catalog.sort_price_desc' | t }}</button>
        <button type="button" data-sort="nuevo">{{ 'catalog.sort_newest' | t }}</button>
        <button type="button" data-sort="az">{{ 'catalog.sort_az' | t }}</button>
      </div>
    </div>
  </div>

  <p id="filters-empty" style="display:none; color:var(--text-mute); padding:40px 0; text-align:center;">{{ 'catalog.no_results' | t }}</p>

  {%- comment -%}
    El catálogo se divide en subsecciones por categoría, en vez de una sola
    rejilla — más fácil de recorrer con 26+ productos. Un producto puede
    aparecer en varias subsecciones a la vez (ej. una faja postparto sin
    costuras sale en Cintura alta, Posparto y Sin costuras). Los 4 "buque
    insignia" tienen su ficha ya escrita a mano (snippets/tile-*.liquid); el
    resto sale de tile-generico.liquid, que decide solo en qué subsección(es)
    entra según palabras clave de su título — nada de esto requiere etiquetar
    productos a mano en Shopify.

    Los filtros (Talla, Precio, Zona, Compresión) y el orden siguen
    funcionando dentro de cada subsección; si una subsección se queda sin
    productos visibles tras filtrar, se oculta ella sola (ver cart.js).
  {%- endcomment -%}
  {%- assign fichas_a_mano = "faja-moldeadora-invisible-nuvel,retro-shapewear-top-with-zipper,womens-shapewear-dress-jumpsuit,seamless-shapewear-panties" | split: "," -%}

  <section class="cat-section" data-cat-section="cintura-alta">
    <h2 class="cat-section-title">{{ 'catalog.category_high_waist' | t }}</h2>
    <div class="product-grid" data-cat-grid="cintura-alta">
      {%- render 'tile-faja' -%}
      {%- render 'tile-corse' -%}
      {%- for product in collections.all.products -%}
        {%- unless fichas_a_mano contains product.handle -%}
          {%- render 'tile-generico', product: product, categoria: 'cintura-alta' -%}
        {%- endunless -%}
      {%- endfor -%}
    </div>
  </section>

  <section class="cat-section" data-cat-section="posparto">
    <h2 class="cat-section-title">{{ 'catalog.category_postpartum' | t }}</h2>
    <div class="product-grid" data-cat-grid="posparto">
      {%- render 'tile-faja' -%}
      {%- for product in collections.all.products -%}
        {%- unless fichas_a_mano contains product.handle -%}
          {%- render 'tile-generico', product: product, categoria: 'posparto' -%}
        {%- endunless -%}
      {%- endfor -%}
    </div>
  </section>

  <section class="cat-section" data-cat-section="sin-costuras">
    <h2 class="cat-section-title">{{ 'catalog.category_seamless' | t }}</h2>
    <div class="product-grid" data-cat-grid="sin-costuras">
      {%- render 'tile-faja' -%}
      {%- render 'tile-short' -%}
      {%- render 'tile-vestido' -%}
      {%- for product in collections.all.products -%}
        {%- unless fichas_a_mano contains product.handle -%}
          {%- render 'tile-generico', product: product, categoria: 'sin-costuras' -%}
        {%- endunless -%}
      {%- endfor -%}
    </div>
  </section>

  <section class="cat-section" data-cat-section="sets">
    <h2 class="cat-section-title">{{ 'catalog.category_full_body' | t }}</h2>
    <div class="product-grid" data-cat-grid="sets">
      {%- render 'tile-vestido' -%}
      {%- for product in collections.all.products -%}
        {%- unless fichas_a_mano contains product.handle -%}
          {%- render 'tile-generico', product: product, categoria: 'sets' -%}
        {%- endunless -%}
      {%- endfor -%}
    </div>
  </section>

  <section class="cat-section" data-cat-section="postura">
    <h2 class="cat-section-title">{{ 'catalog.category_posture' | t }}</h2>
    <div class="product-grid" data-cat-grid="postura">
      {%- for product in collections.all.products -%}
        {%- unless fichas_a_mano contains product.handle -%}
          {%- render 'tile-generico', product: product, categoria: 'postura' -%}
        {%- endunless -%}
      {%- endfor -%}
    </div>
  </section>

  <section class="cat-section" data-cat-section="otros">
    <h2 class="cat-section-title">{{ 'catalog.category_other' | t }}</h2>
    <div class="product-grid" data-cat-grid="otros">
      {%- for product in collections.all.products -%}
        {%- unless fichas_a_mano contains product.handle -%}
          {%- render 'tile-generico', product: product, categoria: '' -%}
        {%- endunless -%}
      {%- endfor -%}
    </div>
  </section>
</main>
