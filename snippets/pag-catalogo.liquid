
<main class="wrap">
  <div class="breadcrumb">{{ 'nav.home' | t }} / <span class="current">{{ 'catalog.crumb_current' | t }}</span></div>
  <h1 style="font-size:38px; margin-top:14px;">{{ 'catalog.title' | t }}</h1>
  <p style="max-width:640px; color:var(--text-soft); font-size:15px; line-height:1.7; margin-top:12px;">{{ 'catalog.intro' | t }}</p>

  <div class="cat-categories">
    <button type="button" class="cat-circle" data-cat="cintura-alta"><div class="circle"></div><span>{{ 'catalog.category_high_waist' | t }}</span></button>
    <button type="button" class="cat-circle" data-cat="posparto"><div class="circle" style="background:linear-gradient(135deg,#D9BEA6,#C9A87C);"></div><span>{{ 'catalog.category_postpartum' | t }}</span></button>
    <button type="button" class="cat-circle" data-cat="sin-costuras"><div class="circle"></div><span>{{ 'catalog.category_seamless' | t }}</span></button>
    <button type="button" class="cat-circle" data-cat="sets"><div class="circle" style="background:linear-gradient(135deg,#D9BEA6,#C9A87C);"></div><span>{{ 'catalog.category_full_body' | t }}</span></button>
  </div>

  <div class="filter-row">
    <div style="display:flex; gap:12px; flex-wrap:wrap; position:relative;">
      <div class="filter-chip-wrap">
        <button type="button" class="chip" data-filter-toggle="talla">{{ 'catalog.filter_size' | t }}</button>
        <div class="filter-dropdown" data-filter-panel="talla">
          <button type="button" data-filter-key="talla" data-filter-value="S">S</button>
          <button type="button" data-filter-key="talla" data-filter-value="M">M</button>
          <button type="button" data-filter-key="talla" data-filter-value="L">L</button>
          <button type="button" data-filter-key="talla" data-filter-value="XL">XL</button>
        </div>
      </div>
      <div class="filter-chip-wrap">
        <button type="button" class="chip" data-filter-toggle="precio">{{ 'catalog.filter_price' | t }}</button>
        <div class="filter-dropdown" data-filter-panel="precio">
          <button type="button" data-filter-key="precio" data-filter-value="menos-50">{{ 'catalog.filter_price_under_50' | t }}</button>
          <button type="button" data-filter-key="precio" data-filter-value="50-100">{{ 'catalog.filter_price_50_100' | t }}</button>
        </div>
      </div>
      <div class="filter-chip-wrap">
        <button type="button" class="chip" data-filter-toggle="zona">{{ 'catalog.filter_zone' | t }}</button>
        <div class="filter-dropdown" data-filter-panel="zona">
          <button type="button" data-filter-key="zona" data-filter-value="abdomen">{{ 'catalog.filter_zone_abdomen' | t }}</button>
          <button type="button" data-filter-key="zona" data-filter-value="piernas">{{ 'catalog.filter_zone_legs' | t }}</button>
          <button type="button" data-filter-key="zona" data-filter-value="torso" disabled>{{ 'catalog.filter_zone_torso_soon' | t }}</button>
        </div>
      </div>
      <div class="filter-chip-wrap">
        <button type="button" class="chip" data-filter-toggle="compresion">{{ 'catalog.filter_compression' | t }}</button>
        <div class="filter-dropdown" data-filter-panel="compresion">
          <button type="button" data-filter-key="compresion" data-filter-value="media">{{ 'catalog.filter_compression_medium' | t }}</button>
          <button type="button" data-filter-key="compresion" data-filter-value="alta" disabled>{{ 'catalog.filter_compression_high_soon' | t }}</button>
        </div>
      </div>
      <button type="button" class="chip" id="filters-clear" style="display:none; border-style:dashed;">{{ 'catalog.filter_clear' | t }} ✕</button>
    </div>
    <div class="filter-chip-wrap">
      <button type="button" class="chip" data-filter-toggle="sort">{{ 'catalog.sort_by' | t }}</button>
      <div class="filter-dropdown" data-filter-panel="sort">
        <button type="button" data-sort="relevancia">{{ 'catalog.sort_relevance' | t }}</button>
        <button type="button" data-sort="precio-asc">{{ 'catalog.sort_price_asc' | t }}</button>
        <button type="button" data-sort="precio-desc">{{ 'catalog.sort_price_desc' | t }}</button>
      </div>
    </div>
  </div>

  <p id="filters-empty" style="display:none; color:var(--text-mute); padding:40px 0; text-align:center;">{{ 'catalog.no_results' | t }}</p>

  <div class="product-grid" id="product-grid">
    <a href="/pages/producto" class="product-tile" data-price="39.90" data-cats="cintura-alta posparto sin-costuras" data-talla="S M L XL" data-color="negro" data-zona="abdomen" data-compresion="media">
      <div class="shot">
        <img src="{{ 'med-producto-frente.jpg' | asset_url }}" srcset="{{ 'mini-producto-frente.jpg' | asset_url }} 400w, {{ 'med-producto-frente.jpg' | asset_url }} 800w, {{ 'lg-producto-frente.jpg' | asset_url }} 1100w" sizes="(max-width: 600px) 46vw, (max-width: 900px) 30vw, 22vw" alt="{{ 'tile.faja.image_alt' | t }}" loading="lazy">
        <img class="shot-hover" src="{{ 'med-faja-modelo-blanco.jpg' | asset_url }}" srcset="{{ 'mini-faja-modelo-blanco.jpg' | asset_url }} 400w, {{ 'med-faja-modelo-blanco.jpg' | asset_url }} 800w" sizes="(max-width: 600px) 46vw, (max-width: 900px) 30vw, 22vw" alt="{{ 'tile.faja.worn_image_alt' | t }}" loading="lazy" aria-hidden="true">
        <span class="badge">{{ 'general.badge_bestseller' | t }}</span>
      </div>
      <div class="info">
        <h4>{{ 'tile.faja.title' | t }}</h4>
        <p class="tile-why">{{ 'tile.faja.why' | t }}</p>
        <div class="rating-row rating-row--tile"><div class="stars-wrap" style="width:72px;"><div class="stars-bg" style="gap:3px;"><svg width="12" height="12" viewBox="0 0 24 24" fill="#E4DACB"><path d="M12 2l3 7h7l-5.5 4.2L18.5 21 12 16.8 5.5 21l2-7.8L2 9h7z"/></svg><svg width="12" height="12" viewBox="0 0 24 24" fill="#E4DACB"><path d="M12 2l3 7h7l-5.5 4.2L18.5 21 12 16.8 5.5 21l2-7.8L2 9h7z"/></svg><svg width="12" height="12" viewBox="0 0 24 24" fill="#E4DACB"><path d="M12 2l3 7h7l-5.5 4.2L18.5 21 12 16.8 5.5 21l2-7.8L2 9h7z"/></svg><svg width="12" height="12" viewBox="0 0 24 24" fill="#E4DACB"><path d="M12 2l3 7h7l-5.5 4.2L18.5 21 12 16.8 5.5 21l2-7.8L2 9h7z"/></svg><svg width="12" height="12" viewBox="0 0 24 24" fill="#E4DACB"><path d="M12 2l3 7h7l-5.5 4.2L18.5 21 12 16.8 5.5 21l2-7.8L2 9h7z"/></svg></div><div class="stars-fg" style="width:69.1px; gap:3px;"><svg width="12" height="12" viewBox="0 0 24 24" fill="#FFD700"><path d="M12 2l3 7h7l-5.5 4.2L18.5 21 12 16.8 5.5 21l2-7.8L2 9h7z"/></svg><svg width="12" height="12" viewBox="0 0 24 24" fill="#FFD700"><path d="M12 2l3 7h7l-5.5 4.2L18.5 21 12 16.8 5.5 21l2-7.8L2 9h7z"/></svg><svg width="12" height="12" viewBox="0 0 24 24" fill="#FFD700"><path d="M12 2l3 7h7l-5.5 4.2L18.5 21 12 16.8 5.5 21l2-7.8L2 9h7z"/></svg><svg width="12" height="12" viewBox="0 0 24 24" fill="#FFD700"><path d="M12 2l3 7h7l-5.5 4.2L18.5 21 12 16.8 5.5 21l2-7.8L2 9h7z"/></svg><svg width="12" height="12" viewBox="0 0 24 24" fill="#FFD700"><path d="M12 2l3 7h7l-5.5 4.2L18.5 21 12 16.8 5.5 21l2-7.8L2 9h7z"/></svg></div></div><span class="rating-value">4.8</span></div>
        <div class="price-row" style="margin-top:6px;">
          <span style="font-weight:600;">39,90&nbsp;€</span>
          <span style="text-decoration:line-through; color:var(--text-mute); font-size:13px;">54,90&nbsp;€</span>
        </div>
      </div>
    </a>
    <a class="product-tile" href="/pages/short" data-price="24.90" data-cats="sin-costuras" data-talla="S M L XL 2XL" data-color="negro beige" data-zona="piernas" data-compresion="media">
