{%- assign p = all_products['faja-moldeadora-invisible-nuvel'] -%}
{%- assign socio = all_products['seamless-shapewear-panties'] -%}{%- capture socio_map -%}{%- for v in socio.variants -%}{%- if v.available -%}"{{ v.option2 }}":{{ v.id }},{%- endif -%}{%- endfor -%}{%- endcapture -%}

<main class="wrap">
  <nav class="breadcrumb">
    <a href="/">{{ 'nav.home' | t }}</a> / <a href="/pages/catalogo">{{ 'catalog.title' | t }}</a> / <span class="current">{{ 'tile.faja.title' | t }}</span>
  </nav>

  <div class="pdp-row">
    <div class="gallery">
      <div class="thumbs">
        <div class="thumb active" data-thumb data-full="{{ 'lg-avatar-vestida.jpg' | asset_url }}"><img src="{{ 'mini-avatar-vestida.jpg' | asset_url }}" alt="{{ 'product_faja.thumb_alt_1' | t }}" width="400" height="536" loading="lazy"></div>
        <div class="thumb" data-thumb data-full="{{ 'lg-detalle-tela.jpg' | asset_url }}"><img src="{{ 'mini-detalle-tela.jpg' | asset_url }}" alt="{{ 'product_faja.thumb_alt_2' | t }}" width="400" height="536" loading="lazy"></div>
        <div class="thumb" data-thumb data-full="{{ 'lg-producto-frente.jpg' | asset_url }}"><img src="{{ 'mini-producto-frente.jpg' | asset_url }}" alt="{{ 'product_faja.thumb_alt_3' | t }}" width="400" height="536" loading="lazy"></div>
        <div class="thumb" data-thumb data-full="{{ 'lg-producto-espalda.jpg' | asset_url }}"><img src="{{ 'mini-producto-espalda.jpg' | asset_url }}" alt="{{ 'product_faja.thumb_alt_4' | t }}" width="400" height="536" loading="lazy"></div>
        <div class="thumb" data-thumb data-full="{{ 'lg-producto-detalle.jpg' | asset_url }}"><img src="{{ 'mini-producto-detalle.jpg' | asset_url }}" alt="{{ 'product_faja.thumb_alt_5' | t }}" width="400" height="536" loading="lazy"></div>
        <div class="thumb" data-thumb data-full="{{ 'lg-avatar-athleisure.jpg' | asset_url }}"><img src="{{ 'mini-avatar-athleisure.jpg' | asset_url }}" alt="{{ 'product_faja.thumb_alt_6' | t }}" width="400" height="536" loading="lazy"></div>
      </div>
      <div class="main-shot"><img id="main-shot-img" src="{{ 'avatar-vestida.jpg' | asset_url }}" srcset="{{ 'med-avatar-vestida.jpg' | asset_url }} 800w, {{ 'lg-avatar-vestida.jpg' | asset_url }} 1100w" sizes="(max-width: 600px) 92vw, (max-width: 900px) 90vw, 640px" alt="{{ 'product_faja.main_image_alt' | t }}" fetchpriority="high"><button type="button" class="gallery-arrow gallery-arrow-left" id="gallery-prev" aria-label="{{ 'gallery.prev' | t }}">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 6l-6 6 6 6"/></svg>
  </button>
  <button type="button" class="gallery-arrow gallery-arrow-right" id="gallery-next" aria-label="{{ 'gallery.next' | t }}">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg>
  </button>
  <button type="button" class="gallery-zoom-btn" id="gallery-zoom" aria-label="{{ 'gallery.zoom' | t }}">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M10.5 8v5M8 10.5h5"/><path d="M20 20l-4.8-4.8"/></svg>
  </button></div>
    </div>

    <div class="pdp-info">
      <h1>{{ 'tile.faja.title' | t }} · Nuvel</h1>
      <div class="rating-row"><div class="stars-wrap" style="width:82px;"><div class="stars-bg" style="gap:3px;"><svg width="14" height="14" viewBox="0 0 24 24" fill="#E4DACB"><path d="M12 2l3 7h7l-5.5 4.2L18.5 21 12 16.8 5.5 21l2-7.8L2 9h7z"/></svg><svg width="14" height="14" viewBox="0 0 24 24" fill="#E4DACB"><path d="M12 2l3 7h7l-5.5 4.2L18.5 21 12 16.8 5.5 21l2-7.8L2 9h7z"/></svg><svg width="14" height="14" viewBox="0 0 24 24" fill="#E4DACB"><path d="M12 2l3 7h7l-5.5 4.2L18.5 21 12 16.8 5.5 21l2-7.8L2 9h7z"/></svg><svg width="14" height="14" viewBox="0 0 24 24" fill="#E4DACB"><path d="M12 2l3 7h7l-5.5 4.2L18.5 21 12 16.8 5.5 21l2-7.8L2 9h7z"/></svg><svg width="14" height="14" viewBox="0 0 24 24" fill="#E4DACB"><path d="M12 2l3 7h7l-5.5 4.2L18.5 21 12 16.8 5.5 21l2-7.8L2 9h7z"/></svg></div><div class="stars-fg" style="width:78.7px; gap:3px;"><svg width="14" height="14" viewBox="0 0 24 24" fill="#FFD700"><path d="M12 2l3 7h7l-5.5 4.2L18.5 21 12 16.8 5.5 21l2-7.8L2 9h7z"/></svg><svg width="14" height="14" viewBox="0 0 24 24" fill="#FFD700"><path d="M12 2l3 7h7l-5.5 4.2L18.5 21 12 16.8 5.5 21l2-7.8L2 9h7z"/></svg><svg width="14" height="14" viewBox="0 0 24 24" fill="#FFD700"><path d="M12 2l3 7h7l-5.5 4.2L18.5 21 12 16.8 5.5 21l2-7.8L2 9h7z"/></svg><svg width="14" height="14" viewBox="0 0 24 24" fill="#FFD700"><path d="M12 2l3 7h7l-5.5 4.2L18.5 21 12 16.8 5.5 21l2-7.8L2 9h7z"/></svg><svg width="14" height="14" viewBox="0 0 24 24" fill="#FFD700"><path d="M12 2l3 7h7l-5.5 4.2L18.5 21 12 16.8 5.5 21l2-7.8L2 9h7z"/></svg></div></div><span class="rating-value">4.8</span><span>123 {{ 'general.reviews' | t }}</span></div>
      <div class="price-row">
        <span class="price-now">{{ p.price | money }}</span>
        <span class="price-was">54,90&nbsp;€</span>
      </div>

      <div class="opt-group">
        <div class="opt-head"><label>{{ 'general.size_label' | t }}</label><a href="#" data-ver-tallas>{{ 'general.size_guide' | t }}</a></div>
        <div class="opt-choices">
          {%- assign orden_tallas = "XS,S,M,L,XL,2XL,3XL,4XL" | split: "," -%}
          {%- for t in orden_tallas -%}
            {%- assign ya = false -%}
            {%- for variant in p.variants -%}
              {%- assign vt = variant.title | split: " / " | last -%}
              {%- if vt == t and ya == false -%}
          <button type="button" class="opt-btn{% if t == 'M' %} selected{% endif %}" data-size="{{ t }}" data-variant-id="{{ variant.id }}">{{ t }}</button>
                {%- assign ya = true -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endfor -%}
        </div>
      </div>

      <div class="guia-tallas">
        <div class="guia-tallas__head"><span class="guia-tallas__title">{{ 'general.size_table_title' | t }}</span></div>
        <table class="guia-tallas__tabla">
          <thead><tr><th>{{ 'general.size_table_col_size' | t }}</th><th>{{ 'general.size_table_col_waist' | t }}</th><th>{{ 'general.size_table_col_hip' | t }}</th></tr></thead>
          <tbody>
            <tr><td>S</td><td>66&ndash;70</td><td>92&ndash;97</td></tr>
            <tr><td>M</td><td>70&ndash;76</td><td>97&ndash;104</td></tr>
            <tr><td>L</td><td>76&ndash;84</td><td>104&ndash;112</td></tr>
            <tr><td>XL</td><td>84&ndash;92</td><td>112&ndash;120</td></tr>
          </tbody>
        </table>
        <p class="guia-tallas__tip">{{ 'general.size_tip' | t }}</p>
      </div>

      <div class="qty-offer">
        <button class="qty-opt selected" data-qty-offer="1"><div class="qty-label">{{ 'qty.one_unit' | t }}</div><div class="qty-price">{{ p.price | money }}</div></button>
        <button class="qty-opt" data-qty-offer="2"><span class="qty-save">{{ 'qty.save_rotate' | t }}</span><div class="qty-label">{{ 'qty.two_units' | t }}</div><div class="qty-price">{{ p.price | times: 1.85 | round | money }}</div></button>
        <button class="qty-opt qty-opt--pack" data-pack-offer data-pack-name="Short Moldeador Sin Costuras" data-pack-partner="seamless-shapewear-panties" data-pack-partner-variants='{ {{ socio_map }} "_":0 }'><span class="qty-save">{{ 'qty.save_most_requested' | t }}</span><div class="qty-label">{{ 'product_faja.pack_label' | t }}</div><div class="qty-price">64,80&nbsp;€</div></button>
      </div>

      {%- render 'payment-icons' -%}

      <button class="btn btn-dark btn-block" id="add-to-cart-btn">{{ 'general.buy_now' | t }}</button>

      <div class="trust-strip">
        <div class="trust-compact">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="1" y="7" width="14" height="10" rx="1"/><path d="M15 10h4l3 3v4h-7z"/></svg>
          <span>{{ 'trust.compact.shipping' | t }}</span>
        </div>
        <div class="trust-compact">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 12a9 9 0 109-9"/><path d="M3 4v6h6"/></svg>
          <span>{{ 'trust.compact.trial' | t }}</span>
        </div>
        <div class="trust-compact">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6z"/></svg>
          <span>{{ 'trust.compact.secure_payment' | t }}</span>
        </div>
      </div>

      <p class="pdp-desc">{{ 'product_faja.description' | t }}</p>
      <ul class="bullets">
        <li><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>{{ 'product_faja.bullet_1' | t }}</li>
        <li><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>{{ 'product_faja.bullet_2' | t }}</li>
        <li><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>{{ 'product_faja.bullet_3' | t }}</li>
      </ul>
    </div>
  </div>

  <section style="padding-bottom:64px;">
    <h2 style="font-size:24px; margin-bottom:20px;">{{ 'general.product_details_title' | t }}</h2>
    <div class="product-details-copy">
      <p class="pd-headline">{{ 'product_faja.headline' | t }}</p>
      <p>{{ 'product_faja.details_text' | t }}</p>
    </div>
  </section>

  <section class="pad" style="padding-left:0; padding-right:0;">
    <h3 style="font-size:26px; margin-bottom:24px;">{{ 'general.video_soon_title' | t }}</h3>
    <div class="video-box">
      <img src="{{ 'hero-principal.jpg' | asset_url }}" srcset="{{ 'med-hero-principal.jpg' | asset_url }} 800w, {{ 'lg-hero-principal.jpg' | asset_url }} 1100w, {{ 'hero-principal.jpg' | asset_url }} 1600w" sizes="(max-width: 900px) 92vw, 1152px" alt="{{ 'product_faja.video_image_alt' | t }}" loading="lazy" decoding="async">
      <div class="video-overlay">
        <div class="play-btn"><svg width="24" height="24" viewBox="0 0 24 24" fill="#1A1A1A"><path d="M8 5v14l11-7z"/></svg></div>
        <p style="font-size:14px; font-weight:500;">{{ 'general.video_placeholder_text' | t }}</p>
      </div>
    </div>
  </section>

  <section class="pad bg-alt">
    <h2 style="font-size:26px; margin-bottom:32px;">{{ 'product_faja.fears_title' | t }}</h2>
    <div class="grid-3">
      <div class="card">
        <h4>{{ 'product_faja.fear_1_title' | t }}</h4>
        <p>{{ 'product_faja.fear_1_text' | t }}</p>
      </div>
      <div class="card">
        <h4>{{ 'product_faja.fear_2_title' | t }}</h4>
        <p>{{ 'product_faja.fear_2_text' | t }}</p>
      </div>
      <div class="card">
        <h4>{{ 'product_faja.fear_3_title' | t }}</h4>
        <p>{{ 'product_faja.fear_3_text' | t }}</p>
      </div>
    </div>
  </section>

  <section style="padding-bottom:64px;">
    <h2 style="font-size:26px; margin-bottom:6px;">{{ 'product_faja.testimonials_title' | t }}</h2>
    <p style="font-size:14px; color:var(--text-soft); margin-bottom:28px;"><span style="display:inline-flex; gap:3px; vertical-align:middle; margin-right:5px;"><svg width="12" height="12" viewBox="0 0 24 24" fill="#FFD700"><path d="M12 2l3 7h7l-5.5 4.2L18.5 21 12 16.8 5.5 21l2-7.8L2 9h7z"/></svg><svg width="12" height="12" viewBox="0 0 24 24" fill="#FFD700"><path d="M12 2l3 7h7l-5.5 4.2L18.5 21 12 16.8 5.5 21l2-7.8L2 9h7z"/></svg><svg width="12" height="12" viewBox="0 0 24 24" fill="#FFD700"><path d="M12 2l3 7h7l-5.5 4.2L18.5 21 12 16.8 5.5 21l2-7.8L2 9h7z"/></svg><svg width="12" height="12" viewBox="0 0 24 24" fill="#FFD700"><path d="M12 2l3 7h7l-5.5 4.2L18.5 21 12 16.8 5.5 21l2-7.8L2 9h7z"/></svg><svg width="12" height="12" viewBox="0 0 24 24" fill="#FFD700" clip-path="inset(0 20% 0 0)"><path d="M12 2l3 7h7l-5.5 4.2L18.5 21 12 16.8 5.5 21l2-7.8L2 9h7z"/></svg></span>{{ 'product_faja.testimonials_text' | t }}</p>
  </section>

  <section style="padding-bottom:96px;">
    <h2 style="font-size:26px; margin-bottom:32px;">{{ 'product_faja.faq_title' | t }}</h2>
    <div class="faq-list">
      <div class="accordion-item" id="faja-se-nota">
        <button type="button" aria-expanded="false" aria-controls="faja-se-nota-a">
          <span class="q">{{ 'product_faja.faq_1_q' | t }}</span>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
        </button>
        <div class="a" id="faja-se-nota-a">{{ 'product_faja.faq_1_a' | t }}</div>
      </div>
      <div class="accordion-item" id="faja-enrolla">
        <button type="button" aria-expanded="false" aria-controls="faja-enrolla-a">
          <span class="q">{{ 'product_faja.faq_2_q' | t }}</span>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
        </button>
        <div class="a" id="faja-enrolla-a">{{ 'product_faja.faq_2_a' | t }}</div>
      </div>
      <div class="accordion-item" id="faja-gorditos">
        <button type="button" aria-expanded="false" aria-controls="faja-gorditos-a">
          <span class="q">{{ 'product_faja.faq_3_q' | t }}</span>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
        </button>
        <div class="a" id="faja-gorditos-a">{{ 'product_faja.faq_3_a' | t }}</div>
      </div>
      <div class="accordion-item" id="faja-talla">
        <button type="button" aria-expanded="false" aria-controls="faja-talla-a">
          <span class="q">{{ 'product_faja.faq_4_q' | t }}</span>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
        </button>
        <div class="a" id="faja-talla-a">{{ 'product_faja.faq_4_a' | t }}</div>
      </div>
      <div class="accordion-item" id="faja-bano">
        <button type="button" aria-expanded="false" aria-controls="faja-bano-a">
          <span class="q">{{ 'product_faja.faq_5_q' | t }}</span>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
        </button>
        <div class="a" id="faja-bano-a">{{ 'product_faja.faq_5_a' | t }}</div>
      </div>
      <div class="accordion-item" id="faja-comer">
        <button type="button" aria-expanded="false" aria-controls="faja-comer-a">
          <span class="q">{{ 'product_faja.faq_6_q' | t }}</span>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
        </button>
        <div class="a" id="faja-comer-a">{{ 'product_faja.faq_6_a' | t }}</div>
      </div>
      <div class="accordion-item" id="faja-calor">
        <button type="button" aria-expanded="false" aria-controls="faja-calor-a">
          <span class="q">{{ 'product_faja.faq_7_q' | t }}</span>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
        </button>
        <div class="a" id="faja-calor-a">{{ 'product_faja.faq_7_a' | t }}</div>
      </div>
      <div class="accordion-item" id="faja-envio">
        <button type="button" aria-expanded="false" aria-controls="faja-envio-a">
          <span class="q">{{ 'product_faja.faq_8_q' | t }}</span>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
        </button>
        <div class="a" id="faja-envio-a">{{ 'product_faja.faq_8_a' | t }}</div>
      </div>
    </div>
  </section>

  <section style="padding-bottom:96px;">
    <h2 style="font-size:26px; margin-bottom:6px;">{{ 'general.suggestions_title' | t }}</h2>
    <p style="font-size:14px; color:var(--text-mute); margin-bottom:0;">{{ 'general.suggestions_subtitle' | t }}</p>
    <div class="suggestions-grid"><a href="/pages/short" class="product-tile">
      <div class="shot">
        <img src="{{ 'med-short-negro-frente.jpg' | asset_url }}" srcset="{{ 'mini-short-negro-frente.jpg' | asset_url }} 400w, {{ 'med-short-negro-frente.jpg' | asset_url }} 800w, {{ 'lg-short-negro-frente.jpg' | asset_url }} 1100w" sizes="(max-width: 600px) 46vw, (max-width: 900px) 30vw, 22vw" alt="{{ 'tile.short.image_alt' | t }}" loading="lazy">
        <img class="shot-hover" src="{{ 'med-short-modelo-blanco.jpg' | asset_url }}" srcset="{{ 'mini-short-modelo-blanco.jpg' | asset_url }} 400w, {{ 'med-short-modelo-blanco.jpg' | asset_url }} 800w" sizes="(max-width: 600px) 46vw, (max-width: 900px) 30vw, 22vw" alt="{{ 'tile.short.worn_image_alt' | t }}" loading="lazy" aria-hidden="true">
        <span class="badge">{{ 'general.badge_new' | t }}</span>
      </div>
      <div class="info">
        <h4>{{ 'tile.short.title' | t }}</h4>
        <p class="tile-why">{{ 'tile.short.why' | t }}</p>
        <div class="rating-row rating-row--tile"><div class="stars-wrap" style="width:72px;"><div class="stars-bg" style="gap:3px;"><svg width="12" height="12" viewBox="0 0 24 24" fill="#E4DACB"><path d="M12 2l3 7h7l-5.5 4.2L18.5 21 12 16.8 5.5 21l2-7.8L2 9h7z"/></svg><svg width="12" height="12" viewBox="0 0 24 24" fill="#E4DACB"><path d="M12 2l3 7h7l-5.5 4.2L18.5 21 12 16.8 5.5 21l2-7.8L2 9h7z"/></svg><svg width="12" height="12" viewBox="0 0 24 24" fill="#E4DACB"><path d="M12 2l3 7h7l-5.5 4.2L18.5 21 12 16.8 5.5 21l2-7.8L2 9h7z"/></svg><svg width="12" height="12" viewBox="0 0 24 24" fill="#E4DACB"><path d="M12 2l3 7h7l-5.5 4.2L18.5 21 12 16.8 5.5 21l2-7.8L2 9h7z"/></svg><svg width="12" height="12" viewBox="0 0 24 24" fill="#E4DACB"><path d="M12 2l3 7h7l-5.5 4.2L18.5 21 12 16.8 5.5 21l2-7.8L2 9h7z"/></svg></div><div class="stars-fg" style="width:69.1px; gap:3px;"><svg width="12" height="12" viewBox="0 0 24 24" fill="#FFD700"><path d="M12 2l3 7h7l-5.5 4.2L18.5 21 12 16.8 5.5 21l2-7.8L2 9h7z"/></svg><svg width="12" height="12" viewBox="0 0 24 24" fill="#FFD700"><path d="M12 2l3 7h7l-5.5 4.2L18.5 21 12 16.8 5.5 21l2-7.8L2 9h7z"/></svg><svg width="12" height="12" viewBox="0 0 24 24" fill="#FFD700"><path d="M12 2l3 7h7l-5.5 4.2L18.5 21 12 16.8 5.5 21l2-7.8L2 9h7z"/></svg><svg width="12" height="12" viewBox="0 0 24 24" fill="#FFD700"><path d="M12 2l3 7h7l-5.5 4.2L18.5 21 12 16.8 5.5 21l2-7.8L2 9h7z"/></svg><svg width="12" height="12" viewBox="0 0 24 24" fill="#FFD700"><path d="M12 2l3 7h7l-5.5 4.2L18.5 21 12 16.8 5.5 21l2-7.8L2 9h7z"/></svg></div></div><span class="rating-value">4.6</span></div>
        <div class="price-row" style="margin-top:6px;">
          <span style="font-weight:600;">24,90&nbsp;€</span>
          <span style="text-decoration:line-through; color:var(--text-mute); font-size:13px;">34,90&nbsp;€</span>
        </div>
      </div>
    </a><a href="/pages/corse" class="product-tile">
