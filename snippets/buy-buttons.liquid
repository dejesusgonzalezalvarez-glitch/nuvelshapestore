{%- comment -%}
  Fallback for native Rise 'buy_buttons' block snippet
{%- endcomment -%}
{%- form 'product', product, id: 'product-form-{{ block.id }}', class: 'product-form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
  <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
  <div class="product-form__buttons">
    {%- if block.settings.show_dynamic_checkout -%}
      {{ form | payment_button }}
    {%- endif -%}
    <button type="submit" name="add" class="button button--primary button--full-width">
      {{ 'products.product.add_to_cart' | t }}
    </button>
  </div>
{%- endform -%}